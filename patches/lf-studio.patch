+    def query_rows(attention):
+        original = type(attention).forward
+
+        def forward(q, k, v, original_seq_len=None, **kwargs):
+            return original(attention, q, k, v, q.shape[1], **kwargs)
+        return forward
+
+    blocks = list(model.transformer_blocks)
+    for block in blocks:
+        _check_signature(type(block).forward, BODY_REGION_ARGS, f"{type(block).__name__}.forward")
