+def ltx_core_importable():
+    """The pinned LTX-2's ltx_core (torch only, no media libraries): installed (the Stage2 env), or from
+    SOL_H3_SPARK_LTX_ROOT, else from LTX-2 next to SOL_H3_SPARK_COMFY_ROOT (the install's sources folder)."""
+    root = os.environ.get("SOL_H3_SPARK_LTX_ROOT")
+    if not root and os.environ.get("SOL_H3_SPARK_COMFY_ROOT"):
+        root = str(Path(os.environ["SOL_H3_SPARK_COMFY_ROOT"]).expanduser().parent / "LTX-2")
+    source = Path(root or "/nonexistent").expanduser() / "packages" / "ltx-core" / "src"
+    if source.is_dir() and str(source) not in sys.path:
+        sys.path.append(str(source))
+    try:
+        import torch  # noqa: F401
+        from ltx_core.conditioning import VideoConditionByLatentIndex  # noqa: F401
+        from ltx_core.types import LatentState
+    except ImportError:
+        return False
+    return "frozen" in {field.name for field in fields(LatentState)}
+
+
+@unittest.skipUnless(ltx_core_importable(), "needs torch and the pinned LTX-2's ltx_core (SOL_H3_SPARK_LTX_ROOT)")
+class KeyframePinLtxTests(unittest.TestCase):
+    """The pin with LTX-2's own conditioning, latent tools, noiser and Euler step on the CPU, at the studio's Stage-2
+    shapes, through the refiner's prepare_multimodal_states. The stand-in parent makes its states as the GB200
+    parent does (official_compat_h3_refiner_diagnostic.prepare_multimodal_states): one generator seeded per request,
+    the video state with the conditionings, then the audio state, each by LTX-2's create_noised_state."""
+
+    SIGMAS = (0.909375, 0.725, 0.421875, 0.0)
+
+    def setUp(self):
+        import torch
+        from ltx_core.components.patchifiers import AudioPatchifier, VideoLatentPatchifier
+        from ltx_core.tools import AudioLatentTools, VideoLatentTools
+        from ltx_core.types import AudioLatentShape, VideoLatentShape, VideoPixelShape, VIDEO_SCALE_FACTORS
+        self.torch = torch
+
+        def tools(frames, height, width):
+            pixel = VideoPixelShape(batch=1, frames=frames, height=height, width=width, fps=24)
+            video = VideoLatentTools(VideoLatentPatchifier(patch_size=1),
+                                     VideoLatentShape.from_pixel_shape(pixel, scale_factors=VIDEO_SCALE_FACTORS), 24.0,
+                                     scale_factors=VIDEO_SCALE_FACTORS)
+            audio = AudioLatentTools(AudioPatchifier(patch_size=1), AudioLatentShape.from_video_pixel_shape(pixel))
+            return video, audio
+        self.tools = tools
+
+    @staticmethod
+    def create_noised_state(tools, conditionings, noiser, dtype, device, noise_scale, initial_latent):
+        try:                                                    # LTX-2's own where ltx_pipelines imports
+            from ltx_pipelines.utils.helpers import create_noised_state
+        except ImportError:                                     # its three steps (helpers.create_noised_state)
+            def create_noised_state(tools, conditionings, noiser, dtype, device, noise_scale, initial_latent):
+                state = tools.create_initial_state(device, dtype, initial_latent)
+                for conditioning in conditionings:
+                    state = conditioning.apply_to(latent_state=state, latent_tools=tools)
+                return noiser(state, noise_scale)
+        return create_noised_state(tools=tools, conditionings=conditionings, noiser=noiser, dtype=dtype,
+                                   device=device, noise_scale=noise_scale, initial_latent=initial_latent)
+
+    def refiner(self, mode, video_tools, audio_tools):
+        torch, test = self.torch, self
+        from ltx_core.components.noisers import GaussianNoiser
+
+        class Upstream:
+            def prepare_multimodal_states(self, video_latent, audio_latent, conditionings, seed):
+                generator = torch.Generator(device="cpu").manual_seed(seed)
+                noiser = GaussianNoiser(generator=generator)
+                video = test.create_noised_state(video_tools, conditionings, noiser, torch.bfloat16, "cpu",
+                                                 test.SIGMAS[0], video_latent)
+                audio = test.create_noised_state(audio_tools, [], noiser, torch.bfloat16, "cpu",
+                                                 test.SIGMAS[0], audio_latent)
+                return video, audio, generator
+        session = SimpleNamespace(torch=torch, stage2_audio="frozen",
+                                  keyframe_request=None if mode == "off" else {"mode": mode})
+        cls = stage2._refiner_class(SimpleNamespace(), SimpleNamespace(OfficialCompatRefiner=Upstream), session)
+        return object.__new__(cls)
+
+    def states(self, frames=121, height=768, width=1344, seed=42):
+        from ltx_core.conditioning import VideoConditionByLatentIndex
+        torch = self.torch
+        video_tools, audio_tools = self.tools(frames, height, width)
+        shape = video_tools.target_shape.to_torch_shape()
+        generator = torch.Generator().manual_seed(5)
+        video_latent = torch.randn(*shape, generator=generator).to(torch.bfloat16)
+        audio_latent = torch.randn(*audio_tools.target_shape.to_torch_shape(), generator=generator).to(torch.bfloat16)
+        image = torch.randn(1, shape[1], 1, shape[3], shape[4], generator=generator).to(torch.bfloat16)
+        pin = [VideoConditionByLatentIndex(latent=image, strength=1.0, latent_idx=0)]   # the parent's encode gives this
+        result = {}
+        for mode, conditionings in (("off", []), ("pin", pin), ("draft", [])):
+            result[mode] = self.refiner(mode, video_tools, audio_tools).prepare_multimodal_states(
+                video_latent, audio_latent, conditionings, seed)
+        return result, video_tools, video_latent, image
+
+    def test_frame_0_is_the_image_and_every_other_token_is_unchanged(self):
+        result, tools, video_latent, image = self.states()
+        torch, per_frame = self.torch, tools.patchifier.get_token_count(tools.target_shape._replace(frames=1))
+        self.assertEqual((per_frame, result["off"][0].latent.shape[1]), (1008, 16128))
+        off, pin, draft = (result[mode][0] for mode in ("off", "pin", "draft"))
+        for state in (pin, draft):
+            self.assertEqual(state.latent.shape, off.latent.shape)          # no token added: the same shapes
+            self.assertEqual(state.denoise_mask.shape, off.denoise_mask.shape)
+            self.assertEqual(state.positions.shape, off.positions.shape)
+            self.assertTrue(torch.equal(state.latent[:, per_frame:], off.latent[:, per_frame:]))   # same noise draws
+            self.assertTrue(torch.equal(state.denoise_mask[:, per_frame:], off.denoise_mask[:, per_frame:]))
+            self.assertTrue(torch.equal(state.positions, off.positions))
+            self.assertEqual(state.denoise_mask[:, :per_frame].unique().tolist(), [0.0])   # never noised
+            self.assertIsNone(state.attention_mask)
+        self.assertEqual(off.denoise_mask.unique().tolist(), [1.0])
+        self.assertTrue(torch.equal(pin.latent[:, :per_frame], tools.patchifier.patchify(image)))
+        self.assertTrue(torch.equal(draft.latent[:, :per_frame],
+                                    tools.patchifier.patchify(video_latent)[:, :per_frame]))
+        for mode in ("pin", "draft"):                       # the audio is the same in every mode (frozen here)
+            self.assertTrue(torch.equal(result[mode][1].latent, result["off"][1].latent))
+            self.assertTrue(result[mode][1].frozen)
+
+    def test_frame_0_stays_clean_through_the_three_updates_and_reaches_the_decoder(self):
+        from ltx_core.components.diffusion_steps import EulerDiffusionStep
+        from dataclasses import replace
+        torch = self.torch
+        result, tools, _, image = self.states(frames=17, height=128, width=192)
+        state = result["pin"][0]
+        sigmas, step = torch.tensor(self.SIGMAS), EulerDiffusionStep()
+        generator = torch.Generator().manual_seed(9)
+        for index in range(3):
+            denoised = torch.randn(state.latent.shape, generator=generator).to(state.latent.dtype)   # any prediction
+            # LTX-2's post_process_latent (helpers.py): the transformer's x0 where the mask is 1, the clean latent
+            # where it is 0
+            denoised = (denoised * state.denoise_mask + state.clean_latent.float() * (1 - state.denoise_mask)
+                        ).to(denoised.dtype)
+            state = replace(state, latent=step.step(state.latent, denoised, sigmas, index))
+        latent = tools.unpatchify(tools.clear_conditioning(state)).latent
+        self.assertEqual(tuple(latent.shape), tuple(tools.target_shape.to_torch_shape()))
+        self.assertTrue(torch.equal(latent[:, :, :1], image))
+
+    def test_the_studios_shapes_keep_their_token_counts(self):
+        from runtime import geometry
+        from runtime.config import load_recipe
+        with mock.patch.dict(os.environ):
+            for name in ("SOL_H3_ORIENTATION", "SOL_H3_SECONDS", "SOL_H3_PROMPT_TOKENS"):
+                os.environ.pop(name, None)
+            for orientation in ("landscape", "portrait"):
+                for seconds in (5, 6, 7, 8, 10, 12, 15):
+                    shape = geometry.from_recipe(load_recipe("fl2va", orientation=orientation, seconds=seconds))
+                    tools, _ = self.tools(shape["output_frames"], shape["output_height"], shape["output_width"])
+                    with self.subTest(orientation=orientation, seconds=seconds):
+                        self.assertEqual(tuple(tools.target_shape.to_torch_shape()), tuple(shape["refiner_input"]))
+                        self.assertEqual(tools.patchifier.get_token_count(tools.target_shape._replace(frames=1)), 1008)
+
+
 if __name__ == "__main__":
     unittest.main()
