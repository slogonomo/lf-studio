+def _install_autotune_debug(th):
+    """lf-studio (SPARK_DEBUG_AUTOTUNE=1): also print every kernel tuned at run time and every tuning result stored.
+    A reduction kernel tuned by timing can pick another block config in another process, which shifts its numerics;
+    one whose result is stored and read back does not. These lines tell the two apart in worker.log."""
+    from torch._inductor.runtime.autotune_cache import AutotuneCache
+
+    def name(self_):
