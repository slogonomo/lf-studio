+class StaticCompileTests(unittest.TestCase):
+    """What the static choice relies on in this torch: with automatic dynamic shapes off (torch.compile(dynamic=False)
+    or the Stage1 worker's Dynamo setting) a second shape compiles a second static graph, the one a fresh process
+    compiles first; with upstream's default a shape change compiles a graph with dynamic sizes instead."""
+
+    def graphs(self, dynamic, automatic=True, mark=False):
+        import torch
+        import torch._dynamo
+        seen = []
+
+        def backend(graph, inputs):
+            seen.append(any(isinstance(dim, torch.SymInt) for value in inputs if isinstance(value, torch.Tensor)
+                            for dim in value.shape) or any(isinstance(value, torch.SymInt) for value in inputs))
+            return graph.forward
+        torch._dynamo.reset()
+        with torch._dynamo.config.patch(automatic_dynamic_shapes=automatic):
+            compiled = torch.compile(lambda x: (x * 2).sum(-1), backend=backend, dynamic=dynamic, fullgraph=True)
+            for length in (8, 16, 8, 24):
+                value = torch.ones(2, length)
+                if mark:                     # as SOL_H3_DYNAMIC_TEXT_LENGTH=1 marks the prompt-length dimensions
+                    torch._dynamo.maybe_mark_dynamic(value, 1)
+                compiled(value)
+        torch._dynamo.reset()
+        return seen
+
+    def test_second_shape_is_static(self):
+        self.assertEqual(self.graphs(False), [False, False, False])              # 8, 16, 24: one static graph each
+        self.assertEqual(self.graphs(None, automatic=False), [False, False, False])
+        self.assertEqual(self.graphs(None), [False, True])                      # upstream default: 16 goes dynamic
+
+    def test_a_marked_dimension_stays_dynamic(self):
+        """SOL_H3_DYNAMIC_TEXT_LENGTH=1 with the Stage1 worker's static setting: a dimension marked dynamic stays
+        dynamic without automatic dynamic shapes, one graph for every length (stage1_ops/regional.py)."""
+        self.assertEqual(self.graphs(None, automatic=False, mark=True), [True])
+        self.assertEqual(self.graphs(None, mark=True), [True])
+
+
+if __name__ == "__main__":
+    unittest.main()
