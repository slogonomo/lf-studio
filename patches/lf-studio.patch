+def mark_length_dynamic(torch, model, forward_context=None, *, tiles=True, tile_dtype=None):
+    """Wrap the 50 compiled body regions so that they compile once for any prompt length.
+
+    Call after _compile_model_regions. Before each call the wrapper marks the packed-row dimension of the block inputs
+    (hidden states, AdaLN rows, RoPE cos/sin) dynamic and, with tiles=True (VSA), runs prepare_tiles() and marks the
+    tile metadata the graph reads (untile index, tile sizes, tile buffer) too; tile_dtype is the dtype of the
+    attention's q/k/v/gate (default: the hidden states'). The block's original_seq_len int reaches only its attention,
+    whose forward gets the row count of its own query instead (the same value on one GPU), so Dynamo never sees that
+    int. The text-refiner regions are not wrapped. The AdaLN table (temb) is not marked: its row count changes from the
+    first denoise step to the others (1 then 2 in t2va), so each session compiles 2 body graphs, none per new length.
+    """
+    mark = torch._dynamo.maybe_mark_dynamic
+    if tiles and forward_context is None:
+        from fastvideo.forward_context import get_forward_context as forward_context
+
+    def body_region(compiled, heads, head_dim):
+        def forward(hidden_states, temb, adaln_indices, rotary_emb, original_seq_len):
+            dims = [(hidden_states, 1), (adaln_indices, 0), (rotary_emb[0], 0), (rotary_emb[1], 0)]
+            if tiles:
+                metadata = forward_context().attn_metadata
+                buffer = prepare_tiles(torch, metadata, hidden_states, heads, head_dim,
+                                       tile_dtype or hidden_states.dtype)
+                dims += [(metadata.untile_combined_index, 0), (metadata.variable_block_sizes, 0), (buffer, 1)]
+            for tensor, dim in dims:
+                mark(tensor, dim)
+            return compiled(hidden_states, temb, adaln_indices, rotary_emb, original_seq_len)
+        return forward
