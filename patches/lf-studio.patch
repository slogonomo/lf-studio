+def keyframe_image(path, size, mode="RGB", exif_orientation=None, icc=False):
+    """A test image with distinct pixels (a gradient and a few blocks), saved as PNG or JPEG by its suffix."""
+    from PIL import Image, ImageCms, ImageDraw
+    image = Image.new("RGB", size)
+    image.putdata([((x * 255) // size[0], (y * 255) // size[1], (x * y) % 256) for y in range(size[1])
+                   for x in range(size[0])])
+    draw = ImageDraw.Draw(image)
+    draw.rectangle((size[0] // 8, size[1] // 8, size[0] // 3, size[1] // 4), fill=(250, 20, 30))
+    draw.ellipse((size[0] // 2, size[1] // 2, size[0] - 4, size[1] - 4), fill=(10, 200, 90))
+    if mode == "RGBA":
+        image = image.convert("RGBA")
+        image.putalpha(128)
+    options = {}
+    if icc:
+        options["icc_profile"] = ImageCms.ImageCmsProfile(ImageCms.createProfile("LAB")).tobytes()
+    if exif_orientation is not None:
+        exif = Image.Exif()
+        exif[0x0112] = exif_orientation
+        options["exif"] = exif.tobytes()
+    image.save(path, **options)
+    return path
+
+
+def h3_stretch(path, width, height):
+    """What H3's input preparation does to the first existing keyframe, written out with PIL alone: EXIF
+    orientation applied, RGB, LANCZOS stretch to the canvas (FastVideo minimax_h3_input_preparation)."""
+    from PIL import Image, ImageOps
+    with Image.open(path) as image:
+        image = ImageOps.exif_transpose(image).convert("RGB")
+    return image if image.size == (width, height) else image.resize((width, height), Image.Resampling.LANCZOS)
+
