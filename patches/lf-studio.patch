+    def capture(self, name, task="fl2va", first=None, last=None, sha256=None):
+        directory = self.temp / name
+        directory.mkdir()
+        payload = directory / "stage1_direct_tensors.pt"
+        payload.write_bytes(b"stand-in tensors")
+        row = {"status": "PASS", "same_request": True, "external_anchor_used": False, "task": task,
+               "latent_only_transfer": True, "h3_decoder_calls": 0, "case_id": name, "request_id": name,
+               "prompt": "a prompt", "seed": 7, "source_index": 0, "payload_sha256": transfer.sha256(payload),
+               "input_spec": {"task": task, "first_frame": first and str(first), "last_frame": last and str(last),
+                              "references": []}}
+        if sha256 is not None:
+            row["input_sha256"] = sha256
+        transfer.write_new(directory / "capture.json", row)
+        return directory
+
+    def run_request(self, session, capture):
+        root = self.temp / f"out-{capture.name}"
+        session.prepare(capture.name, root)
+        with mock.patch.object(stage2, "load_payload", lambda row, **kwargs: {"payload": True}):
+            receipt = session.run(capture, root, capture.name)
+        self.assertEqual(json.loads((root / "stage2_result.json").read_text())["status"], "PASS")
+        self.assertIsNone(session.keyframe_request)                 # one request's state only
+        return receipt, root
