+class SessionTests(unittest.TestCase):
+    """runtime/qwen.py: the Qwen worker's Session applies the recipe's mode to the CLIP's tokenizer when it starts.
+    ComfyUI, torch, CUDA and the checkpoint are stand-ins, so this runs without a GPU or weights."""
+
+    def start(self, directory, recipe, hf):
+        from runtime import qwen
+        directory = Path(directory)
+        checkpoint = directory / "qwen.safetensors"
+        checkpoint.write_bytes(b"")
+        (directory / "comfy").mkdir(exist_ok=True)
+        built = []
+        model = mock.Mock()
+        model.eval.return_value = model
+        clip = SimpleNamespace(tokenizer=SimpleNamespace(qwen3vl_32b=sd_tokenizer(hf)), cond_stage_model=model,
+                               patcher=SimpleNamespace(is_dynamic=lambda: False))
+        utils = SimpleNamespace(load_torch_file=None)
+        memory = SimpleNamespace(read_tensor_file_slice_into=None)
+        management = SimpleNamespace(current_loaded_models=[], load_models_gpu=lambda models, **kwargs: None)
+
+        class Conditioner:                                       # stands in for MiniMaxNVFP4Conditioner
+            def __init__(self, path, root):
+                built.append(path)
+                utils.load_torch_file(str(path))                 # the Session's one-time checkpoint reader
+                self.clip, self.device_contract, self.loader_identity = clip, {}, {}
+
+            def residency_summary(self):
+                return {}
+
+        cuda = SimpleNamespace(device_count=lambda: 1, get_device_capability=lambda: (12, 1),
+                               synchronize=lambda: None, empty_cache=lambda: None)
+        conditioner = SimpleNamespace(MiniMaxNVFP4Conditioner=Conditioner, _import_comfy_sd=lambda root: None,
+                                      normalize_and_validate_conditioning=None)
+        modules = {"torch": SimpleNamespace(cuda=cuda), "runtime.qwen_ops.conditioner": conditioner,
+                   "comfy": SimpleNamespace(utils=utils, memory_management=memory, model_management=management),
+                   "comfy.utils": utils, "comfy.memory_management": memory, "comfy.model_management": management}
+        log = io.StringIO()
+        with mock.patch.dict(sys.modules, modules), contextlib.redirect_stdout(log), \
+                mock.patch.object(qwen, "resource_snapshot", return_value={}), \
+                mock.patch.object(qwen, "load_resident_checkpoint", return_value=({}, {}, {})), \
+                mock.patch.object(qwen, "weight_snapshot", return_value=({}, {})):
+            try:
+                session = qwen.Session({"qwen_checkpoint": str(checkpoint), "comfy_root": str(directory / "comfy")},
+                                       str(directory / "work"), recipe)
+            except ValueError:
+                self.assertEqual(built, [])                      # failed before the model was built
+                raise
+            session.close()
+        self.assertEqual(len(built), 1)
+        return session, log.getvalue()
+
+    def test_the_session_applies_the_recipe_mode(self):
+        with tempfile.TemporaryDirectory() as directory:
+            hf = FakeQwen()
+            session, log = self.start(directory, load_recipe(prompt_tokens="minimax"), hf)
+            self.assertEqual(hf.special, MINIMAX_EXTRA_TOKENS)
+            self.assertEqual(session.prompt_tokens_mode, "minimax")
+            self.assertEqual(session.session_receipt["prompt_tokens"]["added"], 7)
+            self.assertIn("[lf-studio] prompt tokens: {'mode': 'minimax', 'added': 7", log)
+            hf = FakeQwen()
+            session, log = self.start(directory, load_recipe(prompt_tokens="plain"), hf)
+            self.assertEqual(hf.special, {})
+            self.assertEqual(session.session_receipt["prompt_tokens"], {"mode": "plain", "added": 0,
+                                                                        "vocab_size": 151669})
