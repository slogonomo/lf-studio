+                session.image_encoder_wanted = stage2.Session.image_encoder_wanted.__get__(session)
+                seen = {}
+                cls = stage2._refiner_class("base", SimpleNamespace(OfficialCompatRefiner=object), session)
+                with mock.patch.object(stage2, "construct", lambda models_, paths, **kwargs: seen.update(kwargs)):
+                    cls()
+                self.assertIs(seen["image_encoder"], wanted)
+                value = object.__new__(stage2.Session)
+                value.stage2_keyframe, value.task, value.session_receipt = mode, task, {"latent_only_transfer": True}
+                value.models = SimpleNamespace(image_encoder="encoder" if wanted else None,
+                                               image_conditioning_crf=18 if wanted else None)
+                value._keyframe_receipt()
+                self.assertEqual(value.session_receipt, {
+                    "latent_only_transfer": not wanted,       # a pin reads the RGB first frame, too
+                    "stage2_keyframe": {"mode": mode, "task": task, "applies_to": "fl2va requests with a first frame",
+                                        "image_encoder": wanted, "image_conditioning_crf": 18 if wanted else None}})
+        # a session made without the encoder builds it when its mode becomes pin (the replay bench's arms)
+        base, compat = self.stand_in_modules(built)
+        value = object.__new__(stage2.Session)
+        value.stage2_keyframe, value.task, value.session_receipt = "pin", "fl2va", {}
+        value.paths, value.base, value.compat, value.torch = {"output_video_vae": "/vae"}, base, compat, RUN_TORCH
+        value.models = SimpleNamespace(image_encoder=None, image_conditioning_crf=None, dtype="bf16", device="cuda:0",
+                                       residency={})
+        with contextlib.redirect_stdout(io.StringIO()):
+            encoder = value.ensure_image_encoder()
+            self.assertIs(value.ensure_image_encoder(), encoder)
+        self.assertEqual([item[0] for item in built if isinstance(item, tuple)].count("conditioner"), 1)
+        self.assertTrue(value.session_receipt["stage2_keyframe"]["image_encoder"])
+        self.assertIn("image_encoder", value.models.residency)
