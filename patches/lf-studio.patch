+def prepare_tiles(torch, metadata, hidden_states, heads, head_dim, dtype):
+    """FastVideo's tile() bookkeeping (video_sparse_attn_h3.py), done before a body region instead of in its graph.
+
+    The same rules: the packed length must match the metadata; the builder-owned buffer (q, k, v and gate stacked, in
+    the attention's dtype) is allocated with zeros when missing or of another shape, dtype or device, and cleared once
+    when it is reused for another tile geometry. All 50 blocks of a denoise step share it. SM100a partner tiles do not
+    apply on SM121. A dtype other than the attention's makes the scatter in the graph fail, not convert.
+    """
+    rows = hidden_states.shape[1]
+    if metadata.total_seq_length != rows:
+        raise ValueError(f"VSA-H3 metadata was built for sequence length {metadata.total_seq_length}, got {rows}")
+    holder = metadata.tile_buf_holder
+    if holder is None:
+        raise RuntimeError("VSA-H3 metadata has no builder-owned tile buffer holder")
+    shape = (4 * hidden_states.shape[0], metadata.variable_block_sizes.numel() * metadata.tile_elems, heads, head_dim)
+    buffer = holder.buffer
+    if buffer is None or tuple(buffer.shape) != shape or buffer.dtype != dtype or buffer.device != hidden_states.device:
+        holder.buffer = torch.zeros(shape, device=hidden_states.device, dtype=dtype)
+    elif holder.untile_geometry is not metadata.untile_combined_index:
+        buffer.zero_()
+    holder.untile_geometry = metadata.untile_combined_index
+    return holder.buffer
+
