+class Stage2WaitsForQwen(FakeWorker):
+    """The resident Qwen's start shows in the events in the order the pipeline asked for it, whatever the timing of
+    its loading thread: before its first refine, Stage2's cache release takes 0.1 s (a Qwen spawned before the
+    release starts within that time), and its run waits (at most 5 s) for a Qwen worker started after Stage2."""
+
+    def call(self, op="run", **kwargs):
+        if self.name == "stage2" and ("call", "stage2", "run") not in self.events:
+            if op == "release_idle_cache":
+                time.sleep(0.1)
+            elif op == "run":
+                deadline = time.monotonic() + 5
+                while (("start", "qwen") not in self.events[self.events.index(("start", "stage2")):]
+                       and time.monotonic() < deadline):
+                    time.sleep(0.01)
+        return super().call(op, **kwargs)
+
+
+def residency_settings(early=None, mem_gib=64.0, min_gib=None):
+    """lf-studio: the resident-Qwen settings at their defaults (a user's own values would change the order the
+    tests expect), SOL_H3_RESIDENT_QWEN_EARLY and _EARLY_MIN_GIB as given, and MemAvailable after Stage2's release
+    as given."""
+    stack = contextlib.ExitStack()
+    stack.enter_context(mock.patch.dict(os.environ))
+    for name in ("SOL_H3_RESIDENT_QWEN_EARLY", "SOL_H3_RESIDENT_QWEN_EARLY_MIN_GIB", "SOL_H3_RESIDENT_QWEN_MAX_FRAMES"):
+        os.environ.pop(name, None)
+    if early is not None:
+        os.environ["SOL_H3_RESIDENT_QWEN_EARLY"] = early
+    if min_gib is not None:
+        os.environ["SOL_H3_RESIDENT_QWEN_EARLY_MIN_GIB"] = min_gib
+    stack.enter_context(mock.patch("runtime.pipeline.mem_available_gib", return_value=mem_gib))
+    stack.enter_context(mock.patch("runtime.pipeline.MEM_SETTLE_S", 0.05))
+    stack.enter_context(contextlib.redirect_stdout(io.StringIO()))      # its note when Qwen loads after the clip
+    return stack
