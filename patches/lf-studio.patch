+    Returns (receipt, log line or None) for that route, from environ (default os.environ). The receipt says the
+    setting is ignored whenever it is on, the default included; the Stage1 log says so only when it was set to 1, so
+    that the default does not print it on every Sol-route load. A bad value raises, as runtime/config.py's check.
+    """
+    environ = os.environ if environ is None else environ
+    if not dynamic_text_length(environ):
+        return "per_length", None
+    explicit = environ.get(DYNAMIC_TEXT_LENGTH, "").strip() == "1"
+    return "per_length (setting ignored)", SOL_ROUTE_IGNORES_TEXT_LENGTH if explicit else None
+
