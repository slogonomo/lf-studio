+# Runs in a subprocess (python -c): build 50 + 2 of FastVideo's own tiny H3 blocks, run regional.install() (VSA) and
+# install_dense() (Ref2VA) as the Stage-1 worker does, and print what got wrapped as JSON. Compiling is lazy; no
+# forward runs (the opaque ops are CUDA-only).
+WIRING = textwrap.dedent("""
+    import importlib.machinery, importlib.util, json, os, sys, types
+    if importlib.util.find_spec("fastvideo") is None:
+        print(json.dumps({"skip": "FastVideo is not importable"}))
+        sys.exit(0)
+
+    class _Stub(types.ModuleType):          # fastvideo_kernel needs a GPU driver to import
+        def __getattr__(self, name):
+            if name.startswith("__"):
+                raise AttributeError(name)
+            return lambda *args, **kwargs: None
+
+    class _Finder:
+        def find_spec(self, name, path=None, target=None):
+            if name == "fastvideo_kernel" or name.startswith("fastvideo_kernel."):
+                return importlib.machinery.ModuleSpec(name, self, is_package=True)
+        def create_module(self, spec):
+            module = _Stub(spec.name)
+            module.__path__ = []
+            return module
+        def exec_module(self, module):
+            pass
+
+    sys.meta_path.insert(0, _Finder())
+    from unittest.mock import patch
+    import torch
+    import fastvideo.attention.layer as layer
+    import fastvideo.models.dits.minimax_h3 as h3
+    from fastvideo.attention.backends import video_sparse_attn_h3 as vsa_h3
+    from fastvideo.attention.backends.abstract import AttentionBackend, AttentionImpl
+    from fastvideo.configs.models.dits.minimax_h3 import _is_minimax_h3_block
+    from fastvideo.platforms import AttentionBackendEnum as E
+    from runtime.stage1_ops import regional, vsa
+
+    class TextImpl(AttentionImpl):
+        def __init__(self, *args, **kwargs):
+            pass
+        def forward(self, q, k, v, attn_metadata):
+            return q
+
+    class TextBackend(AttentionBackend):
+        get_name = staticmethod(lambda: "FLASH_ATTN")
+        get_impl_cls = staticmethod(lambda: TextImpl)
+
+    def backend(head_size, dtype, supported_attention_backends=None, **kwargs):
+        sparse = E.VIDEO_SPARSE_ATTN_H3 in (supported_attention_backends or ())
+        return vsa_h3.MiniMaxH3VSABackend if sparse else TextBackend
+    h3.get_attn_backend = layer.get_attn_backend = backend
+
+    class Model(torch.nn.Module):          # the attributes regional.py and FastVideo's helpers use
+        _compile_conditions = [_is_minimax_h3_block]
+        enabled_fusions = frozenset()
+        prepare_for_compile = h3.MiniMaxH3Transformer3DModel.prepare_for_compile
+        _compile_setup_device = h3.MiniMaxH3Transformer3DModel.__dict__["_compile_setup_device"]
+
+        def __init__(self, sparse):
+            super().__init__()
+            body = (E.VIDEO_SPARSE_ATTN_H3,) if sparse else (E.FLASH_ATTN,)
+            self.transformer_blocks = torch.nn.ModuleList(h3.MiniMaxH3TransformerBlock(
+                128, 2, 64, 256, 32, 1e-6, 1e-6, body, None, prefix=f"transformer_blocks.{i}") for i in range(50))
+            self.token_refiner = torch.nn.Module()
+            self.token_refiner.refiner_blocks = torch.nn.ModuleList(h3.MiniMaxH3TokenRefinerBlock(
+                128, 2, 64, 256, 1e-6, 1e-6, (E.FLASH_ATTN,), None, prefix=f"token_refiner.refiner_blocks.{i}")
+                for i in range(2))
+            with torch.no_grad():
+                for parameter in self.parameters():
+                    parameter.normal_()
+            for block in self.transformer_blocks:
+                block.attn._resolve_gate_compress_for_compile()    # vsa.install_model does this in the worker
+
+    def compiled(fn):
+        return hasattr(fn, "_torchdynamo_orig_callable")
+
+    def wiring(model):
+        blocks, refiners = list(model.transformer_blocks), list(model.token_refiner.refiner_blocks)
+        cells = lambda fn: [c.cell_contents for c in (getattr(fn, "__closure__", None) or ())]
+        impl = lambda block: block.attn.distributed_attention.attn_impl
+        return {
+            "body_wrapped_after_compile": sum("body_region" in b.forward.__qualname__
+                                              and any(compiled(c) for c in cells(b.forward)) for b in blocks),
+            "body_compiled_unwrapped": sum(compiled(b.forward) for b in blocks),
+            "body_attention_rows": sum("query_rows" in getattr(vars(b.attn.distributed_attention).get("forward"),
+                                                               "__qualname__", "") for b in blocks),
+            "body_preprocess": sum("length_free_body" in getattr(vars(impl(b)).get("preprocess_qkv"),
+                                                                 "__qualname__", "") for b in blocks),
+            "body_forward": sorted({getattr(vars(impl(b)).get("forward"), "__qualname__", "-") for b in blocks}),
+            "text_compiled_unwrapped": sum(compiled(b.forward) for b in refiners),
+            "text_attention_untouched": sum("forward" not in vars(b.attn.distributed_attention) for b in refiners),
+            "text_no_preprocess": sum("preprocess_qkv" not in vars(impl(b)) for b in refiners),
+            "text_forward": sorted({getattr(vars(impl(b)).get("forward"), "__qualname__", "-") for b in refiners}),
+        }
+
+    state = {"official_vsa": {"fastvideo_commit": vsa.FASTVIDEO_COMMIT, "vsa_source_sha256": vsa.VSA_SOURCE_SHA,
+                              "selected_attention_backend": "cudnn_bsa", "active_compression_gates": 50,
+                              "vsa_forward_calls": 0}}
+    out = {}
+    with patch.object(torch.cuda, "get_device_capability", return_value=(12, 1)):
+        model = Model(sparse=True)
+        receipt = regional.install(model, state)
+        out["vsa"] = {**wiring(model), "text_length": receipt["text_length"],
+                      "regions_wrapped": receipt["regions_wrapped"],
+                      "length_regions": receipt.get("length_regions", {}).get("body_regions"),
+                      "any_length_op": hasattr(torch.ops.sol_h3_spark_vsa, "body_any_length")}
+    dense, dense_state = Model(sparse=False), {}
+    regional.install_dense(dense, dense_state)
+    out["dense"] = {**wiring(dense), "text_length": dense_state["dense_regional_compile"]["text_length"]}
+    print(json.dumps(out))
+""")
+
+
+def run_wiring(setting):
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES="", SOL_H3_DYNAMIC_TEXT_LENGTH=setting)
+    package = Path(__file__).resolve().parents[1]
+    result = subprocess.run([sys.executable, "-B", "-c", WIRING], cwd=package, env=env, capture_output=True,
+                            text=True, timeout=600)
+    if result.returncode != 0:
+        raise AssertionError(f"wiring subprocess failed:\n{result.stderr[-3000:]}")
+    return json.loads(result.stdout.strip().splitlines()[-1])
+
