+        first = self.request(record, before=None)      # the first request: lazy load, then the check
+        self.assertEqual(first["request_counts"]["warmup_reference_calls"], vsa.WARMUP_REFERENCE_CALLS)
+        self.assertEqual(self.request(record)["request_counts"]["warmup_reference_calls"], 0)
+        self.assertEqual(vsa.rearm_reference_check(record, self.B)["status"], "armed for the next request")
+        checked = self.request(record)
+        self.assertEqual(checked["request_counts"]["warmup_reference_calls"], vsa.WARMUP_REFERENCE_CALLS)
+        self.assertEqual(checked["warmup_selected_validation"]["shape"], self.B)
+        self.assertEqual(record["bsa_checked_shapes"], [self.A, self.B])
+        self.assertEqual(vsa.rearm_reference_check(record, self.A)["status"], "already checked at this shape")
+        self.assertEqual(self.request(record)["request_counts"]["warmup_reference_calls"], 0)
+        self.assertEqual(record["warmup_reference_calls"], 2 * vsa.WARMUP_REFERENCE_CALLS)
