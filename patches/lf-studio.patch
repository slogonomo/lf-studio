+        vsa.rearm_reference_check(record, self.B)
+        before = copy.deepcopy(record)
+        skipped = copy.deepcopy(record)
+        skipped["warmup_reference_from"] = None         # a request at the new shape without its check
+        run_request(skipped)
+        with self.assertRaises(RuntimeError):
+            vsa.validate_request(before, skipped)
+        vsa.rearm_reference_check(record, self.A)       # back before any request at B: nothing to check
+        self.assertEqual(record["warmup_selected_validation"]["status"], "PASS")
+        self.assertEqual(self.request(record)["request_counts"]["warmup_reference_calls"], 0)
