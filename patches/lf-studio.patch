+class GeometryWorker:
+    """A stand-in worker that knows only its own recipe, as a real one does: the recipe it was started with, then the
+    one each reshape command brings. Qwen writes the keyframe canvas it used, Stage1 checks it (as
+    validate_prepared_media does) and writes its draft shape, Stage2 checks that capture against its own shape."""
+    events = []
+
+    def __init__(self, name, root, paths, config):
+        self.name, self.root, self.config = name, Path(root), config
+        self.root.mkdir()
+        self.pending = None
+        self.events.append(("start", name, self.root.name, shape_of(config)))
+
+    def submit(self, op="run", **kwargs):
+        if op not in OPERATIONS:
+            raise ValueError("Unsupported session operation")
+        if self.pending is not None:
+            raise RuntimeError("one command at a time")
+        self.pending = (op, kwargs)
+        return "pending"
+
+    def wait(self, _response):
+        op, kwargs = self.pending
+        self.pending = None
+        return self.call(op, **kwargs)
+
+    def call(self, op="run", **kwargs):
+        self.events.append(("call", self.name, op, shape_of(self.config)))
+        if op == "reshape":
+            if task_of(kwargs["config"]) != task_of(self.config):
+                raise AssertionError("a reshape never changes the task")
+            self.config = kwargs["config"]
+            return {"status": "PASS", "shape": list(shape_of(self.config))}
+        if op in ("release_idle_cache",):
+            return {}
+        if op == "prepare":
+            Path(kwargs["output_root"]).mkdir()
+            return {}
+        if self.name == "qwen":
+            root = Path(kwargs["output_root"])
+            root.mkdir(parents=True)
+            path = root / "conditioning.json"
+            path.write_text(json.dumps({"canvas": list(shape_of(self.config)[2:])}))
+            return {"conditioning_path": str(path), "request_wall_s": 0.01}
+        if self.name == "stage1":
+            canvas = json.loads(Path(kwargs["conditioning_path"]).read_text())["canvas"]
+            if canvas != list(shape_of(self.config)[2:]):
+                raise RuntimeError(f"Qwen/native media preprocessing differs: {canvas} vs {shape_of(self.config)}")
+            out = Path(kwargs["outputdir"])
+            out.mkdir()
+            (out / "capture.json").write_text(json.dumps({"shape": shape_of(self.config),
+                                                          "request_id": kwargs["case"].get("request_id",
+                                                                                           kwargs["case"]["case_id"])}))
+            return {"capture_dir": str(out), "request_wall_s": 0.02}
+        captured = json.loads((Path(kwargs["capture_dir"]) / "capture.json").read_text())
+        if tuple(captured["shape"]) != shape_of(self.config):
+            raise RuntimeError(f"H3 bridge shape/dtype/layout contract failed: {captured['shape']}")
+        orientation, frames, height, width = shape_of(self.config)
+        output = Path(kwargs["output_root"]) / f"refined_{2 * width}x{2 * height}_{frames}f.mp4"
+        output.write_bytes(b"test output, not a real MP4")
+        import time
+        return {"output": str(output), "final_mp4_complete_monotonic_ns": time.monotonic_ns(),
+                "stage2_request_s": 0.03, "result": {"phases_s": {}}}
+
+    def close(self):
+        self.events.append(("close", self.name, self.root.name))
+
+
+def task_of(config):
+    return config["stage1"].get("task", "t2va")
