+"""MiniMax's prompt tokens for the pinned ComfyUI Qwen tokenizer (SOL_H3_PROMPT_TOKENS). Imports no GPU framework.
+
+Part of lf-studio (Apache-2.0); not part of the upstream Sol-H3-Spark package.
+
+H3 was trained with the tokenizer files of the MiniMaxAI/MiniMax-H3 repository. Their tokenizer_config.json adds 7
+special tokens after Qwen2.5's vocabulary; transformers gives them ids 151669-151675. ComfyUI v0.30.0, which
+Sol-H3-Spark pins, tokenizes MiniMax prompts with Qwen2.5's tokenizer files only, so a dialogue tag such as <d> is
+split into ordinary text tokens ("Ġ<", "d", ">[") that H3 never saw. ComfyUI added the tokens in 924743af
+("Minimax-H3: Add missing special tokens", first released in v0.34.0) with the call used here.
+
+Modes (runtime/config.py prompt_tokens_mode, passed to the Qwen worker as recipe["stage1"]["prompt_tokens"]):
+  minimax  (default) the 7 tokens added, so prompts tokenize as with MiniMax's own tokenizer
+  plain    the pinned tokenizer as it is (the behaviour up to lf-studio 0.3; a dialogue clip made then
+           reproduces from its seed only in this mode)
+A prompt without any of the 7 tokens gets the same ids in both modes.
+"""
+from __future__ import annotations
+
+# Same table as ComfyUI 924743af (MINIMAX_EXTRA_TOKENS) and MiniMax's tokenizer_config.json, in id order.
+MINIMAX_EXTRA_TOKENS = {"<d>": 151669, "</d>": 151670, "<|cutoff|>": 151671,
+                        "<|lyrics_start|>": 151672, "<|lyrics_end|>": 151673,
+                        "<|caption_start|>": 151674, "<|caption_end|>": 151675}
+MINIMAX_EXTRA_IDS = frozenset(MINIMAX_EXTRA_TOKENS.values())
+
+
+def recipe_mode(config):
+    """The mode the host put in the recipe. A bad value raises ValueError. The host always puts one there; a recipe
+    without one was recorded before the setting existed (0.3 or older), when every prompt was encoded "plain"."""
+    from ..config import prompt_tokens_mode
+    stage1 = config.get("stage1", config) if isinstance(config, dict) else {}
+    return prompt_tokens_mode(stage1.get("prompt_tokens") or "plain")
+
+
+def _present(hf_tokenizer):
+    vocab = hf_tokenizer.get_vocab()
+    return {token: vocab[token] for token in MINIMAX_EXTRA_TOKENS if token in vocab}
+
+
+def _check_single_tokens(hf_tokenizer):
+    """Each of the 7 tokens must come out as one id, also next to other text, as with MiniMax's tokenizer."""
+    text = "x".join(MINIMAX_EXTRA_TOKENS)
+    ids = hf_tokenizer(text, add_special_tokens=False)["input_ids"]
+    expected = []
+    for token, token_id in MINIMAX_EXTRA_TOKENS.items():
+        expected += [token_id, hf_tokenizer.convert_tokens_to_ids("x")]
+    if ids != expected[:-1]:
+        raise RuntimeError(f"MiniMax's prompt tokens do not tokenize as single tokens: {text!r} -> {ids}")
+
+
+def apply_prompt_tokens(sd_tokenizer, mode):
+    """Set up ComfyUI's Qwen tokenizer for `mode` and return what was done (for the receipt and the log).
+
+    sd_tokenizer is ComfyUI's SDTokenizer for the MiniMax text encoder (clip.tokenizer.qwen3vl_32b): .tokenizer is the
+    transformers Qwen2Tokenizer that MiniMaxH3Tokenizer._text_ids calls, .inv_vocab its id -> token map, which
+    924743af rebuilds after adding the tokens.
+    - minimax: add the 7 tokens unless the tokenizer already has all of them; fail unless they have ids
+      151669-151675 and each tokenizes as one id.
+    - plain: fail if the tokenizer already has any of them (a newer ComfyUI), since it could not give the plain ids.
+    """
+    hf = sd_tokenizer.tokenizer
+    present = _present(hf)
+    if mode == "plain":
+        if present:
+            raise RuntimeError(
+                "SOL_H3_PROMPT_TOKENS=plain needs the pinned ComfyUI tokenizer without MiniMax's tokens, but this "
+                f"ComfyUI already has {sorted(present)}; set SOL_H3_PROMPT_TOKENS=minimax (the default)")
+        return {"mode": "plain", "added": 0, "vocab_size": len(hf)}
+    if mode != "minimax":
+        raise ValueError(f"unknown prompt-token mode {mode!r}")
+    if present == MINIMAX_EXTRA_TOKENS:
+        _check_single_tokens(hf)
+        return {"mode": "minimax", "added": 0, "already_present": True, "vocab_size": len(hf)}
+    if present:
+        raise RuntimeError(f"the ComfyUI tokenizer has only some of MiniMax's prompt tokens, or other ids: {present}")
+    hf.add_special_tokens({"additional_special_tokens": list(MINIMAX_EXTRA_TOKENS)})
+    got = _present(hf)
+    if got != MINIMAX_EXTRA_TOKENS:
+        raise RuntimeError(f"MiniMax's prompt tokens got ids {got}, expected {MINIMAX_EXTRA_TOKENS}")
+    _check_single_tokens(hf)
+    if hasattr(sd_tokenizer, "inv_vocab"):
+        sd_tokenizer.inv_vocab = {v: k for k, v in hf.get_vocab().items()}
+    return {"mode": "minimax", "added": len(MINIMAX_EXTRA_TOKENS), "already_present": False, "vocab_size": len(hf)}
+
+
+def request_counts(tokens, token_tags):
+    """Counts for the request receipt: text positions H3 sees (token tag 1) and MiniMax tokens among the ids.
+
+    tokens: CLIP.tokenize() output, {"qwen3vl_32b": [[(id or vision entry, weight), ...]]}.
+    token_tags: the normalized minimax_token_tags, 1 per text position and 0 per vision position.
+    """
+    entries = [entry for batch in tokens.values() for row in batch for entry in row]
+    ids = [entry[0] for entry in entries if isinstance(entry[0], int)]
+    return {"text_tokens": int(token_tags.sum()), "minimax_tokens": sum(1 for i in ids if i in MINIMAX_EXTRA_IDS)}
