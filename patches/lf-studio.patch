+"""CPU checks for SOL_H3_DYNAMIC_TEXT_LENGTH: Stage-1 body regions compiled per session, not per prompt length.
+
+Part of lf-studio. The model here is a small stand-in with the shape of FastVideo's H3 regions: a block forward
+with FastVideo's signature whose attention follows DistributedAttention_VSA at one GPU (stack q/k/v/gate, trim,
+preprocess_qkv, chunk, attention forward, postprocess_output, pad) and reads FastVideo-style VSA metadata from a
+global forward context, and a text-refiner forward. The AdaLN table has 1 row in the first denoise step and 2 in the
+others, as Stage 1's exact t2va lookup. The opaque attention is a CPU custom op. torch.compile runs with a counting
+eager backend, so these tests check Dynamo's graphs and guards, not Inductor kernels. InstallWiringTests run
+regional.install() and install_dense() on FastVideo's own H3 blocks in a subprocess, with fastvideo_kernel stubbed
+(it needs a GPU driver to import), and skip when FastVideo is not importable.
+"""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import textwrap
+from types import MethodType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import torch
+import torch._dynamo
+
+from runtime import config
+from runtime.stage1_ops import regional
+
+HEADS, HEAD_DIM, AUDIO, VIDEO = 2, 8, 20, 192
+ADALN_ROWS = (1, 2, 2, 2)      # rows of the AdaLN table per denoise step (Stage 1's exact t2va lookup)
+HIDDEN = HEADS * HEAD_DIM
+CONTEXT = SimpleNamespace(attn_metadata=None)    # stands in for FastVideo's global forward context
+
+
+def forward_context():
+    return CONTEXT
+
+
+class Holder:
+    """FastVideo's builder-owned tile buffer holder (one per request)."""
+
+    def __init__(self):
+        self.buffer = None
+        self.untile_geometry = None
+
+
+def request_geometry(text):
+    """Tile sizes and untile index like FastVideo's VSA-H3 builder: 64-row prefix tiles per segment, then video."""
+    sizes = []
+    for segment in (text, AUDIO):
+        sizes += [64] * (segment // 64) + ([segment % 64] if segment % 64 else [])
+    prefix = len(sizes)
+    sizes += [64] * (VIDEO // 64)
+    untile = torch.cat([torch.arange(size) + 64 * index for index, size in enumerate(sizes)])
+    return torch.tensor(sizes), untile, prefix
+
+
+def metadata(text, step, geometry, holder):
+    sizes, untile, prefix = geometry
+    return SimpleNamespace(total_seq_length=text + AUDIO + VIDEO, num_prefix_tiles=prefix,
+                           num_video_tiles=VIDEO // 64, variable_block_sizes=sizes, untile_combined_index=untile,
+                           tile_elems=64, VSA_sparsity=0.9, exempt=True, dense_layers=(), current_timestep=step,
+                           tile_buf_holder=holder)
+
+
+def sparse_attention(calls):
+    """The 'original' VSA forward the opaque op calls: position-mixing, and it uses every metadata int it gets."""
+    def forward(q, k, v, gate, md):
+        calls.append((md.current_timestep, md.num_prefix_tiles, md.num_video_tiles, int(md.variable_block_sizes.sum())))
+        return (q * 0.5 + k * torch.roll(v, 1, dims=1) + gate * 0.25
+                + md.current_timestep * 0.01 + md.num_prefix_tiles * 0.001 + md.num_video_tiles * 0.0001)
+    return forward
+
+
+class TileImpl:
+    """FastVideo's MiniMaxH3VSAImpl surface: tile() with its length check and holder bookkeeping, and the untile."""
+
+    def __init__(self, layer):
+        self._sol_h3_cpu_layer = torch.tensor(layer)
+
+    def preprocess_qkv(self, x, md):
+        if x.shape[1] != md.total_seq_length:
+            raise ValueError("length")
+        holder = md.tile_buf_holder
+        target = (x.shape[0], md.variable_block_sizes.numel() * md.tile_elems, x.shape[2], x.shape[3])
+        matches = holder.buffer is not None and holder.buffer.shape == target and holder.buffer.dtype == x.dtype
+        if matches and holder.untile_geometry is not md.untile_combined_index:
+            holder.buffer.zero_()
+        if not matches:
+            holder.buffer = torch.zeros(target, dtype=x.dtype)
+        holder.buffer[:, md.untile_combined_index] = x
+        holder.untile_geometry = md.untile_combined_index
+        return holder.buffer
+
+    def postprocess_output(self, output, md):
+        return output[:, md.untile_combined_index]
+
+
+class Attention(torch.nn.Module):
+    """DistributedAttention_VSA.forward at sequence-parallel size 1."""
+
+    def __init__(self, impl):
+        super().__init__()
+        self.impl = impl
+        self.dtype = torch.float32
+
+    def forward(self, q, k, v, original_seq_len, gate_compress):
+        md = forward_context().attn_metadata
+        qkvg = torch.cat([q, k, v, gate_compress], dim=0)
+        pad = qkvg.shape[1] - original_seq_len
+        qkvg = self.impl.preprocess_qkv(qkvg[:, :original_seq_len], md)
+        q, k, v, gate = qkvg.chunk(4, dim=0)
+        output = self.impl.postprocess_output(self.impl.forward(q, k, v, gate, md), md)
+        return torch.nn.functional.pad(output, (0, 0, 0, 0, 0, pad))
+
+
+class DenseAttention(torch.nn.Module):
+    """DistributedAttention.forward (Ref2VA's dense FA4 route) at sequence-parallel size 1, without metadata."""
+
+    def forward(self, q, k, v, original_seq_len=None, gate_compress=None):
+        qkv = torch.cat([q, k, v], dim=0)
+        original_seq_len = original_seq_len or qkv.shape[1]
+        pad = qkv.shape[1] - original_seq_len
+        q, k, v = qkv[:, :original_seq_len].chunk(3, dim=0)
+        output = torch.softmax(torch.einsum("bshd,bthd->bhst", q, k), dim=-1)
+        output = torch.einsum("bhst,bthd->bshd", output, v)
+        return torch.nn.functional.pad(output, (0, 0, 0, 0, 0, pad))
+
+
+class AttentionModule(torch.nn.Module):
+    def __init__(self, impl, dense=False):
+        super().__init__()
+        self.num_attention_heads, self.attention_head_dim = HEADS, HEAD_DIM
+        self.distributed_attention = DenseAttention() if dense else Attention(impl)
+        self.to_qkvg = torch.nn.Linear(HIDDEN, 4 * HIDDEN, bias=False)
+
+
+class Block(torch.nn.Module):
+    """FastVideo's MiniMaxH3TransformerBlock.forward signature, with modulation, RoPE-like scaling and a residual."""
+
+    def __init__(self, layer, dense=False):
+        super().__init__()
+        self.attn = AttentionModule(TileImpl(layer), dense)
+        self.norm = torch.nn.RMSNorm(HIDDEN)
+        self.out = torch.nn.Linear(HIDDEN, HIDDEN)
+
+    def forward(self, hidden_states, temb, adaln_indices, rotary_emb, original_seq_len):
+        x = self.norm(hidden_states) * (1 + temb.index_select(0, adaln_indices))
+        q, k, v, gate = self.attn.to_qkvg(x).unflatten(-1, (4 * HEADS, HEAD_DIM)).chunk(4, dim=2)
+        q = q * rotary_emb[0][None, :, None, :] + q * rotary_emb[1][None, :, None, :]
+        output = self.attn.distributed_attention(q, k, v, original_seq_len, gate_compress=gate)
+        return hidden_states + self.out(output.flatten(2))
+
+
+class Refiner(torch.nn.Module):
+    """FastVideo's MiniMaxH3TokenRefinerBlock.forward signature; its attention trims by original_seq_len."""
+
+    def __init__(self):
+        super().__init__()
+        self.norm = torch.nn.RMSNorm(HIDDEN)
+        self.proj = torch.nn.Linear(HIDDEN, HIDDEN)
+
+    def forward(self, hidden_states, original_seq_len):
+        x = self.proj(self.norm(hidden_states))[:, :original_seq_len]
+        return hidden_states + torch.softmax(x @ x.transpose(1, 2), dim=-1) @ x
+
+
+class Model(torch.nn.Module):
+    def __init__(self, blocks=2, dense=False):
+        super().__init__()
+        torch.manual_seed(0)
+        self.transformer_blocks = torch.nn.ModuleList(Block(layer, dense) for layer in range(blocks))
+        self.token_refiner = torch.nn.Module()
+        self.token_refiner.refiner_blocks = torch.nn.ModuleList(Refiner() for _ in range(2))
+
+
+def run_request(model, text, seed=0, steps=4):
+    """One request as FastVideo runs it: a new metadata builder (tile-buffer holder) per request, the refiner once
+    (its output is cached), then every block once per denoise step."""
+    generator = torch.Generator().manual_seed(seed + text)
+    rows = text + AUDIO + VIDEO
+    geometry, holder = request_geometry(text), Holder()
+    tokens = torch.randn(1, text, HIDDEN, generator=generator)
+    hidden = torch.randn(1, rows, HIDDEN, generator=generator)
+    rotary = (torch.randn(rows, HEAD_DIM, generator=generator), torch.randn(rows, HEAD_DIM, generator=generator))
+    outputs = []
+    for refiner in model.token_refiner.refiner_blocks:
+        tokens = refiner(tokens, text)
+    outputs.append(tokens)
+    for step in range(steps):
+        CONTEXT.attn_metadata = metadata(text, step, geometry, holder)
+        temb = torch.randn(ADALN_ROWS[step], HIDDEN, generator=generator)
+        adaln = torch.randint(0, ADALN_ROWS[step], (rows,), generator=generator)
+        state = hidden
+        for block in model.transformer_blocks:
+            state = block(state, temb, adaln, rotary, rows)
+        outputs.append(state)
+        hidden = hidden + 0.01 * state
+    CONTEXT.attn_metadata = None
+    return outputs
+
+
+class GraphCounter:
+    def __init__(self):
+        self.graphs = 0
+
+    def __call__(self, graph_module, example_inputs):
+        self.graphs += 1
+        return graph_module.forward
+
+
+def compile_regions(model, blocks, refiners):
+    # FastVideo's _compile_model_regions: replace each region's forward with a fullgraph torch.compile of it.
+    for block in model.transformer_blocks:
+        block.forward = torch.compile(block.forward, fullgraph=True, backend=blocks)
+    for block in model.token_refiner.refiner_blocks:
+        block.forward = torch.compile(block.forward, fullgraph=True, backend=refiners)
+
+
+class RegionalLengthTests(unittest.TestCase):
+    def setUp(self):
+        torch._dynamo.reset()
+        self.addCleanup(torch._dynamo.reset)
+
+    def test_setting_values(self):
+        """On by default since 0.4 (unset or empty); 0 is the opt-out. regional reads runtime/config.py's check, the
+        one the studio runs at start, so both refuse the same values with the same message."""
+        self.assertIs(regional.dynamic_text_length, config.dynamic_text_length)
+        self.assertTrue(regional.dynamic_text_length({}))
+        self.assertTrue(regional.dynamic_text_length({regional.DYNAMIC_TEXT_LENGTH: " "}))
+        self.assertTrue(regional.dynamic_text_length({regional.DYNAMIC_TEXT_LENGTH: "1"}))
+        self.assertFalse(regional.dynamic_text_length({regional.DYNAMIC_TEXT_LENGTH: " 0 "}))
+        for bad in ("true", "2", "on", "off"):
+            with self.assertRaisesRegex(ValueError, f"^SOL_H3_DYNAMIC_TEXT_LENGTH must be 0 or 1, not {bad!r}$"):
+                regional.dynamic_text_length({regional.DYNAMIC_TEXT_LENGTH: bad})
+        with patch.dict(os.environ):                        # without an argument: the process environment
+            os.environ.pop(regional.DYNAMIC_TEXT_LENGTH, None)
+            self.assertTrue(config.dynamic_text_length())
+            os.environ[regional.DYNAMIC_TEXT_LENGTH] = "0"
+            self.assertFalse(config.dynamic_text_length())
+            os.environ[regional.DYNAMIC_TEXT_LENGTH] = "on"
+            with self.assertRaisesRegex(ValueError, "SOL_H3_DYNAMIC_TEXT_LENGTH must be 0 or 1, not 'on'"):
+                config.dynamic_text_length()
+
+    def test_ref2va_sol_route_receipt_and_log_line(self):
+        """The Ref2VA Sol route ignores the setting (stage1.py): its receipt says so whenever the setting is on, the
+        default included; the Stage1 log line only when it was set to 1, not on every Sol-route load by default."""
+        from runtime import stage1
+        name, ignored = regional.DYNAMIC_TEXT_LENGTH, "per_length (setting ignored)"
+        line = "[lf-studio] SOL_H3_DYNAMIC_TEXT_LENGTH=1 is ignored on the Ref2VA Sol route"
+        for environ, expected in (({}, (ignored, None)), ({name: ""}, (ignored, None)),
+                                  ({name: "0"}, ("per_length", None)), ({name: " 0 "}, ("per_length", None)),
+                                  ({name: "1"}, (ignored, line)), ({name: " 1 "}, (ignored, line))):
+            self.assertEqual(stage1.sol_route_text_length(environ), expected, environ)
+        with self.assertRaisesRegex(ValueError, "^SOL_H3_DYNAMIC_TEXT_LENGTH must be 0 or 1, not 'on'$"):
+            stage1.sol_route_text_length({name: "on"})
+        with patch.dict(os.environ):                        # without an argument: the process environment
+            os.environ.pop(name, None)
+            self.assertEqual(stage1.sol_route_text_length(), (ignored, None))
+            os.environ[name] = "1"
+            self.assertEqual(stage1.sol_route_text_length(), (ignored, line))
+
+    def test_prepare_tiles_follows_fastvideo_tile_bookkeeping(self):
+        holder = Holder()
+        first, second = request_geometry(100), request_geometry(110)       # same tile count, other geometry
+        hidden = torch.zeros(1, 100 + AUDIO + VIDEO, HIDDEN)
+        def prepare(md, hidden, dtype=torch.float32):
+            return regional.prepare_tiles(torch, md, hidden, HEADS, HEAD_DIM, dtype)
+        buffer = prepare(metadata(100, 0, first, holder), hidden)
+        self.assertEqual(tuple(buffer.shape), (4, first[0].numel() * 64, HEADS, HEAD_DIM))
+        self.assertTrue(bool((buffer == 0).all()))
+        self.assertIs(holder.untile_geometry, first[1])
+        buffer.fill_(1)
+        self.assertIs(prepare(metadata(100, 1, first, holder), hidden), buffer)
+        self.assertTrue(bool((buffer == 1).all()))                          # same geometry: reused as it is
+        hidden = torch.zeros(1, 110 + AUDIO + VIDEO, HIDDEN)
+        self.assertIs(prepare(metadata(110, 0, second, holder), hidden), buffer)
+        self.assertTrue(bool((buffer == 0).all()))                          # other geometry: cleared once
+        third = request_geometry(200)                                       # more tiles: a new zero buffer
+        hidden = torch.zeros(1, 200 + AUDIO + VIDEO, HIDDEN)
+        bigger = prepare(metadata(200, 0, third, holder), hidden)
+        self.assertIsNot(bigger, buffer)
+        self.assertEqual(bigger.shape[1], third[0].numel() * 64)
+        self.assertIsNot(prepare(metadata(200, 1, third, holder), hidden, torch.bfloat16), bigger)   # attention dtype
+        self.assertEqual(holder.buffer.dtype, torch.bfloat16)
+        with self.assertRaisesRegex(ValueError, "built for sequence length"):
+            prepare(metadata(201, 0, third, holder), hidden)
+
+    def install_per_length(self, model, namespace, calls):
+        """The body attention as regional.install() wires it with the setting off (ints passed to the op)."""
+        original = sparse_attention(calls)
+
+        @torch.library.custom_op(f"{namespace}::body", mutates_args=(), device_types="cpu")
+        def body_op(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, gate: torch.Tensor,
+                    variable_sizes: torch.Tensor, layer: torch.Tensor,
+                    prefix_tiles: int, video_tiles: int, step: int) -> torch.Tensor:
+            md = SimpleNamespace(variable_block_sizes=variable_sizes, num_prefix_tiles=prefix_tiles,
+                                 num_video_tiles=video_tiles, current_timestep=step)
+            return original(q, k, v, gate, md).contiguous()
+
+        @body_op.register_fake
+        def body_fake(q, k, v, gate, variable_sizes, layer, prefix_tiles, video_tiles, step):
+            return torch.empty_like(q)
+
+        def body_forward(self, query, key, value, gate, md):
+            return body_op(query, key, value, gate, md.variable_block_sizes, self._sol_h3_cpu_layer,
+                           md.num_prefix_tiles, md.num_video_tiles, md.current_timestep)
+
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = MethodType(body_forward, impl)
+
+    def install_any_length(self, model, namespace, calls):
+        receipt = {"body_runtime_calls": 0}
+        originals = [sparse_attention(calls)] * len(model.transformer_blocks)
+        preprocess, forward = regional.length_free_body(torch, originals, receipt, forward_context,
+                                                        namespace=namespace, device_types="cpu")
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = MethodType(forward, impl)
+            impl.preprocess_qkv = MethodType(preprocess, impl)
+        return receipt
+
+    def reference(self, lengths):
+        """Eager, uncompiled: FastVideo's tile() inside the attention and the original forward called directly."""
+        model, calls = Model(), []
+        original = sparse_attention(calls)
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = lambda q, k, v, gate, md: original(q, k, v, gate, md)
+        with torch.no_grad():
+            return [run_request(model, text) for text in lengths], calls
