+"""lf-studio: CPU tests of MiniMax's prompt tokens, SOL_H3_PROMPT_TOKENS (not part of upstream Sol-H3-Spark).
+
+The tokenizer tests read the pinned ComfyUI's Qwen2.5 tokenizer files ($SOL_H3_SPARK_COMFY_ROOT/comfy/text_encoders/
+qwen25_tokenizer) with transformers' Qwen2Tokenizer, as ComfyUI's Qwen3VLSDTokenizer does, and are skipped without
+them. The last test runs ComfyUI's own MiniMaxH3Tokenizer in a subprocess; it is skipped where ComfyUI cannot be
+imported (the Stage1 environment), and runs in the Qwen image.
+"""
+import contextlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+from runtime.config import load_recipe, prompt_tokens_mode
+from runtime.qwen_ops.prompt_tokens import (MINIMAX_EXTRA_TOKENS, apply_prompt_tokens, recipe_mode,
+                                            request_counts)
+
+PACKAGE = Path(__file__).resolve().parents[1]
+COMFY_ROOT = os.environ.get("SOL_H3_SPARK_COMFY_ROOT", "")
+TOKENIZER_DIR = Path(COMFY_ROOT, "comfy", "text_encoders", "qwen25_tokenizer") if COMFY_ROOT else None
+
+# The example in lf-studio issue #38: ids from MiniMax's released tokenizer (MiniMaxAI/MiniMax-H3 tokenizer/,
+# transformers 4.57.1 and 5.17.0) and from the pinned ComfyUI v0.30.0 tokenizer as the studio used it up to 0.3.
+EXAMPLE = "The woman (S1) says: <d>[English] Welcome to the garden.</d>"
+EXAMPLE_MINIMAX = [785, 5220, 320, 50, 16, 8, 2727, 25, 220, 151669, 58, 22574, 60, 20166, 311, 279, 13551, 13,
+                   151670]
+EXAMPLE_PLAIN = [785, 5220, 320, 50, 16, 8, 2727, 25, 366, 67, 30768, 22574, 60, 20166, 311, 279, 13551, 3918, 67,
+                 29]
+MIXED = "a man (S2) says: <d>[中文] 你好，欢迎。</d> Then <|cutoff|> [Shot 2] <cutoff> <scenetrans>"
+MIXED_MINIMAX = [64, 883, 320, 50, 17, 8, 2727, 25, 220, 151669, 58, 104811, 60, 220, 108386, 3837, 100437, 1773,
+                 151670, 5005, 220, 151671, 508, 36402, 220, 17, 60, 366, 66, 27440, 29, 366, 2388, 268, 17366, 596,
+                 29]
+# None of the 7 tokens: the same ids in both modes. <cutoff> and <scenetrans> (MiniMax's guides) are not tokens in
+# either tokenizer; <|im_start|> is one of Qwen's own special tokens and must stay one.
+NO_TAGS = ["A bird glides over a mountain lake at dawn.",
+           "Shot 1 <cutoff> Shot 2 <scenetrans> a quiet street, (S1) whispers while his lips remain completely closed.",
+           "<Audio 1>: a man speaks; <Picture 1>: the same man. d> </ <|im_start|> <D> < d>"]
+
+
+class FakeQwen:
+    """The parts of transformers' Qwen2Tokenizer that apply_prompt_tokens uses: Qwen2.5's 151,669 ids, "x" = 87.
+    split=False: added tokens get ids but are not split out of the text (each character is one id instead)."""
+
+    def __init__(self, size=151669, special=None, split=True):
+        self.size, self.vocab, self.special, self.split = size, {"x": 87}, dict(special or {}), split
+
+    def __len__(self):
+        return self.size + sum(1 for i in self.special.values() if i >= self.size)
+
+    def get_vocab(self):
+        return {**self.vocab, **self.special}
+
+    def convert_tokens_to_ids(self, token):
+        return self.get_vocab()[token]
+
+    def add_special_tokens(self, mapping):
+        for token in mapping["additional_special_tokens"]:
+            self.special.setdefault(token, len(self))
+
+    def __call__(self, text, add_special_tokens=False):
+        parts = (re.split("(" + "|".join(map(re.escape, self.special)) + ")", text) if self.special and self.split
+                 else [text])
+        ids = []
+        for part in parts:
+            ids += [self.special[part]] if part in self.special else [self.vocab.get(c, 0) for c in part]
+        return {"input_ids": ids}
+
+
+def sd_tokenizer(hf):
+    """Stand-in for ComfyUI's SDTokenizer: .tokenizer and .inv_vocab, as 924743af uses them."""
+    return SimpleNamespace(tokenizer=hf, inv_vocab={v: k for k, v in hf.get_vocab().items()})
+
+
+class SettingTests(unittest.TestCase):
+    def test_default_values_and_bad_value(self):
+        with mock.patch.dict(os.environ):
+            os.environ.pop("SOL_H3_PROMPT_TOKENS", None)
+            self.assertEqual(prompt_tokens_mode(), "minimax")
+            for value, mode in (("", "minimax"), (" plain ", "plain"), ("MiniMax", "minimax"), ("PLAIN", "plain")):
+                os.environ["SOL_H3_PROMPT_TOKENS"] = value
+                self.assertEqual(prompt_tokens_mode(), mode)
+            os.environ["SOL_H3_PROMPT_TOKENS"] = "special"
+            with self.assertRaisesRegex(ValueError, "SOL_H3_PROMPT_TOKENS.*'special'"):
+                prompt_tokens_mode()
+            with self.assertRaisesRegex(ValueError, "SOL_H3_PROMPT_TOKENS"):
+                load_recipe()
+
+    def test_recipe_carries_the_mode_to_the_qwen_worker(self):
+        with mock.patch.dict(os.environ):
+            os.environ.pop("SOL_H3_PROMPT_TOKENS", None)
+            self.assertEqual(load_recipe()["stage1"]["prompt_tokens"], "minimax")      # the default
+            os.environ["SOL_H3_PROMPT_TOKENS"] = "plain"
+            for task in ("t2va", "fl2va", "ref2va"):
+                recipe = load_recipe(task, orientation="portrait", seconds=10)
+                self.assertEqual(recipe["stage1"]["prompt_tokens"], "plain")
+                self.assertEqual(recipe_mode(recipe), "plain")
+            self.assertEqual(load_recipe(prompt_tokens="minimax")["stage1"]["prompt_tokens"], "minimax")
+        self.assertEqual(recipe_mode({"stage1": {}}), "plain")          # a recipe from before the setting
+        with self.assertRaisesRegex(ValueError, "SOL_H3_PROMPT_TOKENS"):
+            recipe_mode({"stage1": {"prompt_tokens": "both"}})
+
