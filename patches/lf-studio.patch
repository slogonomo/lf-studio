+def length_free_body(torch, body_originals, receipt, forward_context=None, *, namespace="sol_h3_spark_vsa",
+                     device_types="cuda"):
+    """Body attention for regions compiled once for any length. Returns (preprocess_qkv, forward) for a VSA impl.
+
+    The opaque op reads the tile counts and the denoise step from FastVideo's forward context when it runs (as
+    sol.py's op reads its step), instead of taking them as Python ints that Dynamo would specialize. preprocess_qkv
+    keeps only the scatter of FastVideo's tile() (scatter_into_tile_buf) in the graph; prepare_tiles() does tile()'s
+    length check and buffer bookkeeping before each region call.
+    """
+    if forward_context is None:
+        from fastvideo.forward_context import get_forward_context as forward_context
+
+    @torch.library.custom_op(f"{namespace}::body_any_length", mutates_args=(), device_types=device_types)
+    def body_op(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, gate: torch.Tensor,
+                variable_sizes: torch.Tensor, layer: torch.Tensor) -> torch.Tensor:
+        current = forward_context().attn_metadata
+        metadata = SimpleNamespace(variable_block_sizes=variable_sizes,
+            num_prefix_tiles=current.num_prefix_tiles, num_video_tiles=current.num_video_tiles,
+            VSA_sparsity=0.9, tile_elems=64, exempt=True, dense_layers=(), current_timestep=current.current_timestep)
+        result = body_originals[_layer_number(layer, len(body_originals))](q, k, v, gate, metadata)
