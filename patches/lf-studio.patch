+    def stand_in_modules(self, built):
+        class Encoder:
+            def eval(self):
+                built.append("eval")
+                return self
+            def requires_grad_(self, flag):
+                built.append(("requires_grad", flag))
+                return self
+
+        class ImageConditioner:
+            default_image_crf = 18
+            def __init__(self, checkpoint, dtype, device, registry, alloc_trim_strategy):
+                built.append(("conditioner", checkpoint, dtype, device, registry, alloc_trim_strategy))
+                self._encoder_builder = SimpleNamespace(
+                    build=lambda device, dtype: built.append(("build", device, dtype)) or Encoder())
+        base = SimpleNamespace(ModelRegistry=lambda: "registry", AllocatorTrimStrategy=SimpleNamespace(DEFER="defer"),
+                               _module_residency=lambda name, module: {"name": name, "type": type(module).__name__})
+        return base, SimpleNamespace(ImageConditioner=ImageConditioner)
