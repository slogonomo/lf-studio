+    # ---- the refiner's methods, with a stand-in parent -------------------------------------------------------
+    def refiner(self, session, calls):
+        class Upstream:                           # official_compat_h3_refiner_diagnostic.OfficialCompatRefiner
+            def encode_highres_first_frame(self, image_path):
+                calls.append(("encode", image_path, (base.WIDTH, base.HEIGHT)))
+                shape = session.geometry["refiner_input"]
+                return [VideoConditionByLatentIndex(Latent((1, shape[1], 1, shape[3], shape[4]), "image"), 1.0, 0)]
+
+            def prepare_multimodal_states(self, video_latent, audio_latent, conditionings, seed):
+                calls.append(("states", video_latent, audio_latent, conditionings, seed))
+                return "video_state", AudioState(Named("noised"), Named("ones"), Named("clean")), "generator"
+
+            def run_diagnostic(self, record, output_path):  # the parent's order, its calls only
+                calls.append(("record", dict(record)))
+                first_frame = self.first_frame_path(record)
+                video_latent = self.video_encode(None)
+                conditionings = self.encode_highres_first_frame(first_frame)
+                self.prepare_multimodal_states(video_latent, "audio", conditionings, int(record["seed"]))
+                session.prompt_cache.context_calls += 1
+                session.writer_chunk_receipt = {"complete": True}
+                Path(output_path).write_bytes(b"not a real MP4")
+                self.final_mp4_complete_monotonic_ns = time.monotonic_ns()
+                return {"phases_s": {"gemma_multimodal_embedding_s": 0.01, "official_input_video_vae_encode_s": 0.02,
+                                     "highres_first_frame_condition_s": 0.03},
+                        "highres_first_frame": str(first_frame)}
+
+        base = session.base
+        cls = stage2._refiner_class(base, SimpleNamespace(OfficialCompatRefiner=Upstream), session)
+        model = object.__new__(cls)
+        model.image_encoder, model.image_conditioning_crf, model.image_encode_calls = "encoder", 18, 0
+        model.h3_upscaler_calls = model.adapter_convert_calls = 0
+        model.h3_spatial_route, model._h3_upscale_s, model._h3_adapter_s = {"route": "h3"}, 0.1, 0.2
+
+        def video_encode(normalized):
+            model.h3_upscaler_calls += 1
+            model.adapter_convert_calls += 1
+            return Latent(session.geometry["refiner_input"], "adapter")
+        model.video_encode = video_encode
+        model.prepare_steady_state = lambda: None
+        return model
+
+    def session(self, mode, task="fl2va", orientation="landscape", calls=None):
+        from runtime import geometry
+        from runtime.config import load_recipe
+        from runtime.stage2_ops.models import bind_geometry
+        value = object.__new__(stage2.Session)
+        value.closed = value.failed = False
+        value.prepared = value.current_capture = value.payload = value.keyframe_request = None
+        value.completed_requests, value.shapes_run, value.steady_state_pending, value.timings = 1, set(), False, {}
+        value.geometry = geometry.from_recipe(load_recipe(task, orientation=orientation))
+        value.stage2_audio, value.stage2_keyframe, value.task = "frozen", mode, task
+        value.fixed_prompt, value.torch = stage2.FIXED_PROMPT, RUN_TORCH
+        value.prompt_cache = SimpleNamespace(context_calls=0, receipt=lambda: {"prompt": "fixed"})
+        value.conv_layout_receipt = {"calls": 0}
+        value.base = SimpleNamespace()
+        bind_geometry(value.base, value.geometry)
+        value.calls = [] if calls is None else calls
+        value.models = self.refiner(value, value.calls)
+        return value
