+    def test_an_interrupted_wait_leaves_the_loading_encoder_to_close(self):
+        """infer.py's SIGINT handler raises KeyboardInterrupt. If it comes while a clip waits for the resident Qwen,
+        which is still loading, the encoder stays registered: close() waits for it and closes it."""
+        import concurrent.futures
+        import threading
+        loaded = threading.Event()
+
+        class SlowQwen(GeometryWorker):
+            def __init__(self, name, root, paths, config):
+                super().__init__(name, root, paths, config)
+                if Path(root).name == "qwen-worker":
+                    loaded.wait(10)                           # loading in the background during the first refine
+        pipeline = Pipeline({}, Path(self.directory.name) / "interrupt", worker_factory=SlowQwen)
+        self.addCleanup(pipeline.close)
+        self.addCleanup(loaded.set)
+        case = {"case_id": "c0", "prompt": "A fox.", "seed": 1}
+        pipeline.start(case, deliver=True)
+        loading = pipeline._qwen_future
+        self.assertFalse(loading.done())
+        wait = loading.result
+
+        def interrupted_wait(timeout=None):                  # Ctrl-C 0.1 s into the wait
+            try:
+                return wait(0.1)
+            except concurrent.futures.TimeoutError:
+                raise KeyboardInterrupt("Interrupted; closing only this pipeline's workers") from None
+        with mock.patch.object(loading, "result", interrupted_wait), self.assertRaises(KeyboardInterrupt):
+            pipeline.generate(dict(case, case_id="c1"))
+        self.assertFalse(loading.done())
+        self.assertIs(pipeline._qwen_future, loading)        # still registered
+        threading.Timer(0.2, loaded.set).start()
+        pipeline.close()                                     # waits for it to load, then closes it
+        self.assertIn("qwen-worker", self.qwen_roots("close"))
+        self.assertEqual(sorted(self.qwen_roots("start")), sorted(self.qwen_roots("close")))
+
+    def test_close_waits_for_an_encoder_that_a_reshape_is_closing(self):
+        """A reshape to 15 s closes the resident Qwen, which takes a while (up to 40 s for a real worker). Unload's
+        close() on another thread meanwhile finds no encoder of its own to close, and returns only once that one has
+        shut down."""
+        import threading
+        closing_qwen, closed = threading.Event(), threading.Event()
+
+        class SlowClose(GeometryWorker):
+            def close(self):
+                if self.name == "qwen" and self.root.name == "qwen-worker":
+                    closing_qwen.set()
+                    closed.wait(10)
+                super().close()
+        pipeline = Pipeline({}, Path(self.directory.name) / "slow-close", worker_factory=SlowClose)
+        self.addCleanup(pipeline.close)
+        self.addCleanup(closed.set)
+        pipeline.start({"case_id": "c0", "prompt": "A fox.", "seed": 1}, deliver=True)
