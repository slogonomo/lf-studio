+def _install_autotune_cache_fix(debug=False):
+    """lf-studio: honour Inductor's saved coordinate-descent results for kernels loaded from the FX graph cache.
+
+    A statically launchable CachingAutotuner is pickled into the FX cache; for some kernels its compile_results
+    were already pruned to one config, and CachingAutotuner.recheck_autotune_cache (torch 2.13) re-hashes *that*
+    list, which never equals the configs_hash the result was saved under (the original candidate list). Every new
+    process therefore re-ran coordinate-descent tuning for the same 11 Stage2 kernels (~3-4 s) and re-saved the
+    same .best_config. After an upstream miss, read the entry with the kernel's own AutotuneCache (same key =
+    kernel source hash + torch version, same configs_hash that save() used), then do what upstream does on a hit.
+
+    That includes the cache info (issue #51): torch skips its run-time R0_BLOCK halving (_dynamic_scale_rblock) only
+    when autotune_cache_state is exactly "hit". With another label, a reduction read through the fallback got
+    halved-R0_BLOCK candidates, was benchmarked by timing again, and the winner overwrote the stored result, so the
+    next process could pick another block size and round differently. The info is now the dict check_autotune_cache
+    builds on a hit, plus spark_fallback=True, which keeps the fallback visible in the SPARK_DEBUG_AUTOTUNE lines
+    without changing what torch reads.
+    """
+    from torch._inductor.runtime import triton_heuristics as th
+    original = th.CachingAutotuner.recheck_autotune_cache
+    if getattr(original, "_spark_fix", False):
