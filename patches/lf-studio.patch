+class ApplyTests(unittest.TestCase):
+    """The checks around the ComfyUI call, with a stand-in tokenizer (always run)."""
+
+    def test_minimax_adds_the_tokens_once(self):
+        tokenizer = sd_tokenizer(FakeQwen())
+        info = apply_prompt_tokens(tokenizer, "minimax")
+        self.assertEqual((info["added"], info["vocab_size"]), (7, 151676))
+        self.assertEqual({t: tokenizer.tokenizer.convert_tokens_to_ids(t) for t in MINIMAX_EXTRA_TOKENS},
+                         MINIMAX_EXTRA_TOKENS)
+        self.assertEqual(tokenizer.inv_vocab[151669], "<d>")                 # refreshed, as in 924743af
+        again = apply_prompt_tokens(tokenizer, "minimax")                     # a ComfyUI that already has them
+        self.assertEqual((again["added"], again["already_present"]), (0, True))
+
+    def test_wrong_or_partial_ids_fail(self):
+        with self.assertRaisesRegex(RuntimeError, "got ids"):
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(size=151670)), "minimax")
+        with self.assertRaisesRegex(RuntimeError, "only some"):
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(special={"<d>": 151669})), "minimax")
+        with self.assertRaisesRegex(RuntimeError, "only some"):
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(special=dict(MINIMAX_EXTRA_TOKENS, **{"<d>": 151700}))),
+                                "minimax")
+        with self.assertRaisesRegex(RuntimeError, "do not tokenize as single tokens"):     # right ids, not split out
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(split=False)), "minimax")
+        with self.assertRaisesRegex(RuntimeError, "do not tokenize as single tokens"):     # already there, ditto
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(special=MINIMAX_EXTRA_TOKENS, split=False)), "minimax")
+
+    def test_plain_leaves_the_tokenizer_alone_and_refuses_one_that_has_the_tokens(self):
+        hf = FakeQwen()
+        self.assertEqual(apply_prompt_tokens(sd_tokenizer(hf), "plain"), {"mode": "plain", "added": 0,
+                                                                          "vocab_size": 151669})
+        self.assertEqual(hf.special, {})
+        with self.assertRaisesRegex(RuntimeError, "SOL_H3_PROMPT_TOKENS=minimax"):
+            apply_prompt_tokens(sd_tokenizer(FakeQwen(special=MINIMAX_EXTRA_TOKENS)), "plain")
+
+    def test_request_counts(self):
+        class Tags(list):
+            def sum(self):
+                return sum(self)
+        vision = {"type": "image", "data": None}
+        tokens = {"qwen3vl_32b": [[(27, 1.0), (151652, 1.0), (vision, 1.0), (151653, 1.0), (151669, 1.0),
+                                   (87, 1.0), (151670, 1.0)]]}
+        self.assertEqual(request_counts(tokens, Tags([1, 0, 0, 0, 0, 0, 1, 1, 1])),
+                         {"text_tokens": 4, "minimax_tokens": 2})
