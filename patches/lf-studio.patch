+# lf-studio: the Inductor autotune-cache fallback (docs/PATCH.md item 8, issue #51)
+class AutotuneCacheFallbackTests(unittest.TestCase):
+    """A Stage-2 reduction loaded from the FX graph cache with its compile results pruned to one config (R0_BLOCK
+    1024): torch's recheck hashes that one config and misses, and the fallback reads the stored result through the
+    kernel's own cache. The stand-in CachingAutotuner keeps what torch 2.13 does next (StaticAutotunerFuture.result:
+    recheck, precompile, then run): _dynamic_scale_rblock adds a halved-R0_BLOCK candidate unless autotune_cache_state
+    is exactly "hit" (here always, as for the three 15 s kernels of #51), more than one launcher is benchmarked by
+    timing and the winner saved, and a launcher not marked found_by_coordesc is tuned by coordinate descent, which
+    saves its result too. A halved candidate is a copy, and Triton's Config drops found_by_coordesc when copied, so a
+    halved winner goes on to coordinate descent. The recheck, check_autotune_cache, the configs, their copies and
+    hashes are torch's and Triton's own."""
+
+    FILENAME = "/cache/cj/cjviewxyz8rms.py"
+
+    def setUp(self):
+        import triton
+        from torch._inductor.runtime import triton_heuristics
+        self.th, self.events = triton_heuristics, []
+        self.candidates = [triton.Config({"XBLOCK": 1, "R0_BLOCK": block}, num_warps=8, num_stages=1)
+                           for block in (1024, 2048)]
+        self.configs_hash = triton_heuristics.hash_configs(self.candidates)    # what the compile-time save used
+        # the .best_config a previous process wrote: coordinate descent's result, under that configs hash
+        self.disk = {self.configs_hash: (copy.deepcopy(self.candidates[0]), True)}
+        self.meta = {"kernel_name": "triton_red_fused_rms_norm_view_8", "coordinate_descent_tuning": True}
+
+    def stored_block(self):
+        return self.disk[self.configs_hash][0].kwargs["R0_BLOCK"]
+
+    def stand_ins(self):
+        events, disk, th, filename = self.events, self.disk, self.th, self.FILENAME
+
+        class Cache:
+            local_cache = (None, "cj/view8.best_config")
+
+            def __init__(self, configs_hash):
+                self.configs_hash = configs_hash
+
+            @staticmethod
+            def create(inductor_meta, filename, configs_hash):
+                return Cache(configs_hash)
+
+            def read_best(self, inductor_meta, configs):     # as torch's _load_cached_autotuning, for these entries
+                if self.configs_hash not in disk:
+                    return None
+                stored, found_by_coordesc = disk[self.configs_hash]
+                config = copy.deepcopy(stored)
+                if found_by_coordesc and inductor_meta.get("coordinate_descent_tuning"):
+                    config.found_by_coordesc = True
+                return config
+
+            def save(self, config, time_taken_ns, found_by_coordesc=False, triton_cache_hash=None):
+                events.append(("stored", config.kwargs["R0_BLOCK"]))
+                disk[self.configs_hash] = (copy.deepcopy(config), found_by_coordesc)
+
+        class Autotuner:
+            recheck_autotune_cache = th.CachingAutotuner.recheck_autotune_cache     # torch's own (this torch)
+
+            def __init__(self, config, cache, meta):
+                self.filename, self.inductor_meta, self.save_cache_hook = filename, meta, cache.save
+                self.compile_results, self.launchers = [SimpleNamespace(config=config)], []
+                self.autotune_cache_info, self.fn = None, SimpleNamespace(fn=object())
+
+            def is_statically_launchable(self):
+                return True
+
+            def _precompile_config(self, config):
+                events.append(("compiled", config.kwargs["R0_BLOCK"]))
+                return SimpleNamespace(config=config)
+
+            def _make_launchers(self):
+                if len(self.launchers) != len(self.compile_results):
+                    self.launchers = [SimpleNamespace(config=result.config) for result in self.compile_results]
+
+            def precompile(self):
+                self._make_launchers()
+                self._dynamic_scale_rblock()
+
+            def _dynamic_scale_rblock(self):            # torch 2.13's gate, then one halving per config
+                if (
+                    self.autotune_cache_info
+                    and self.autotune_cache_info.get("autotune_cache_state") == "hit"
+                ):
+                    return
+                for result in list(self.compile_results):
+                    halved = copy.deepcopy(result.config)
+                    halved.kwargs["R0_BLOCK"] //= 2
+                    self.compile_results.append(self._precompile_config(halved))
+                self._make_launchers()
+
+            def autotune_to_one_config(self, *args):
+                events.append(("benchmarked", [launcher.config.kwargs["R0_BLOCK"] for launcher in self.launchers]))
+                best = self.launchers[-1]                # timing picks the halved block (view_8: 1024 -> 512)
+                self.launchers = [best]
+                self.compile_results = [result for result in self.compile_results if result.config is best.config]
+                self.save_cache_hook(best.config, 1,
+                                     found_by_coordesc=self.inductor_meta.get("coordinate_descent_tuning", False))
+
+            def coordinate_descent_tuning(self, launcher, *args):
+                return self._coordinate_descent_tuning(launcher, *args)
+
+            def _coordinate_descent_tuning(self, launcher, *args):
+                events.append(("coordinate descent", launcher.config.kwargs["R0_BLOCK"]))
+                best = copy.deepcopy(launcher.config)
+                best.found_by_coordesc = True
+                self.save_cache_hook(best, 1, found_by_coordesc=True)
+                return SimpleNamespace(config=best)
+
+            def run(self, *args):
+                if len(self.launchers) != 1:
+                    if len(self.launchers) == 0:
+                        self.precompile()
+                    if len(self.launchers) > 1:
+                        self.autotune_to_one_config(*args)
+                if not getattr(self.launchers[0].config, "found_by_coordesc", False) and self.inductor_meta.get(
+                        "coordinate_descent_tuning", False):
+                    self.launchers = [self.coordinate_descent_tuning(self.launchers[0], *args)]
+                events.append(("ran", self.launchers[0].config.kwargs["R0_BLOCK"]))
+        return Cache, Autotuner
+
+    def load(self, fix, debug=False, label=None):
+        """Load the kernel as a new Stage-2 process does and run two requests. Returns the cache info after the
+        recheck, torch's own cache info for a hit on the stored result, and what was printed."""
+        import contextlib
+        import io
+        import types
+        import torch._inductor.runtime as runtime
+        Cache, Autotuner = self.stand_ins()
+        heuristics = types.ModuleType("torch._inductor.runtime.triton_heuristics")
+        heuristics.CachingAutotuner, heuristics.triton_config_to_hashable = Autotuner, self.th.triton_config_to_hashable
+        caches = types.ModuleType("torch._inductor.runtime.autotune_cache")
+        caches.AutotuneCache = Cache
+        with patch.object(self.th, "AutotuneCache", Cache), \
+             patch.object(runtime, "triton_heuristics", heuristics), \
+             patch.dict(sys.modules, {"torch._inductor.runtime.triton_heuristics": heuristics,
+                                      "torch._inductor.runtime.autotune_cache": caches}), \
+             contextlib.redirect_stdout(io.StringIO()) as out:
+            # torch's check on the original candidate list (the compile-time lookup): a real hit
+            upstream_hit = self.th.check_autotune_cache(copy.deepcopy(self.candidates), self.FILENAME,
+                                                        dict(self.meta))[2]
+            if fix:
+                stage2._install_autotune_cache_fix(debug=debug)
+            tuner = Autotuner(copy.deepcopy(self.candidates[0]), Cache(self.configs_hash), dict(self.meta))
+            tuner.recheck_autotune_cache(lambda: self.fail("the stored config is the compiled one: no reload"))
+            info = dict(tuner.autotune_cache_info)
+            if label is not None:
+                tuner.autotune_cache_info["autotune_cache_state"] = label
+            tuner.precompile()
+            tuner.run()
+            tuner.run()                                  # the next request
+        return info, upstream_hit, out.getvalue().splitlines()
+
+    RETUNED = [("compiled", 512), ("benchmarked", [1024, 512]), ("stored", 512), ("coordinate descent", 512),
+               ("stored", 512), ("ran", 512), ("ran", 512)]
+
+    def test_a_fallback_hit_is_torchs_hit_and_nothing_is_tuned_again(self):
+        stored = self.th.triton_config_to_hashable(self.disk[self.configs_hash][0])
+        info, upstream_hit, lines = self.load(fix=True, debug=True)
+        self.assertEqual(upstream_hit, {"best_config": stored, "autotune_cache_state": "hit"})
+        self.assertEqual(info, dict(upstream_hit, spark_fallback=True))
+        self.assertEqual(self.events, [("ran", 1024), ("ran", 1024)])   # no halving, timing, descent or store
+        self.assertEqual(lines, [f"[lf-studio] fallback hit cjviewxyz8rms. -> {stored}"])
+        self.assertEqual(self.stored_block(), 1024)
+
+    def test_the_label_before_51_was_tuned_again(self):
+        # "hit (spark fallback)": the stored config was read, then halved, benchmarked and replaced (the 15 s re-tuning)
+        info, _, _ = self.load(fix=True, label="hit (spark fallback)")
+        self.assertTrue(info["spark_fallback"])
+        self.assertEqual(self.events, self.RETUNED)
+        self.assertEqual(self.stored_block(), 512)
+
+    def test_without_the_fix_torch_misses_and_tunes_again(self):
+        # SPARK_AUTOTUNE_CACHE_FIX=0: torch misses, halves, benchmarks and runs coordinate descent (item 8)
+        info, _, _ = self.load(fix=False)
+        self.assertEqual(info["autotune_cache_state"], "miss")
+        self.assertEqual(self.events, self.RETUNED)
+        self.assertEqual(self.stored_block(), 512)
