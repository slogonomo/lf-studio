+    def test_mismatch_is_found_before_reading_and_retired(self):
+        self.save()
+
+        class Changed(self.model_cls):
+            def __init__(self, *args, **kwargs):
+                super().__init__(*args, **kwargs)
+                self.register_buffer("extra", torch.zeros(3))
+        for attribute in ("__name__", "__qualname__", "__module__"):     # the same module tree, one more buffer
+            setattr(Changed, attribute, getattr(self.model_cls, attribute))
+        kwargs = dict(self.kwargs, model_cls=Changed)
+        # same identity (a model change the identity does not see), other tensors
+        with patch.object(snapshot, "worker_identity", return_value=json.loads(
+                (self.snapshot_dir / snapshot.INDEX_FILE).read_text())["identity"]):
+            for round_number in (1, 2):
+                state = {}
+                controller = self.controller(state)
+                with patch.object(snapshot, "host_buffer", side_effect=AssertionError("read before validating")):
+                    self.assertIsNone(controller.restore(self.loader, (), dict(kwargs)))
+                record = state["stage1_snapshot"]
+                self.assertEqual((record["status"], record["rejected"], record["rejections"]),
+                                 ("RESTORE_FAILED", True, round_number))
+                self.assertFalse(controller.save_allowed)       # this session writes nothing
+                self.assertIn("extra", record["error"])
+                self.assertEqual(sorted(p.name for p in self.snapshot_dir.iterdir()), [snapshot.REJECTED_FILE])
+                # the next session builds and saves again, carrying the count
+                state = {}
+                rebuild = self.controller(state)
+                self.assertIsNone(rebuild.restore(self.loader, (), dict(kwargs)))
+                if round_number == 1:
+                    self.assertEqual(state["stage1_snapshot"]["status"], "BUILD_AND_SAVE")
+                    self.assertEqual(rebuild.rejections, 1)
+                    model, build_state, _, pinned = normal_build(self.model_cls, init=self.init)
+                    build_state["stage1_snapshot"] = state["stage1_snapshot"]
+                    rebuild.state = build_state
+                    rebuild.record = build_state["stage1_snapshot"]
+                    rebuild.save(model, type("M", (), {"states": [type("S", (), {"pinned": p})() for p in pinned]})())
+                    self.assertEqual(build_state["stage1_snapshot"]["status"], "SAVED")
+                    index = json.loads((self.snapshot_dir / snapshot.INDEX_FILE).read_text())
+                    self.assertEqual(index["rejections"], 1)
+                else:
+                    # rejected MAX_REJECTIONS times: built without saving from now on
+                    self.assertEqual(state["stage1_snapshot"]["status"], "BUILD_NO_SAVE")
+                    self.assertFalse(rebuild.save_allowed)
+        # the marker survives pruning; only snapshots with data are pruned
+        self.assertEqual(snapshot.prune(self.root, "t2va", keep=0), [])
