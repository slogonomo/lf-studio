+def old_pin_offsets(tensors):
+    """pin_idle_blocks' layout before the snapshot shared it (offload.py at d338ccd)."""
+    spans, total = [], 0
+    for t in tensors:
+        span = (1 + sum((s - 1) * st for s, st in zip(t.shape, t.stride()))) if t.numel() else 0
+        total = -(-total // 64) * 64
+        spans.append((total, span))
+        total += span * t.element_size()
+    return spans, total
+
+
+class FakeBlock(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.weight = torch.nn.Parameter(torch.randn(5, 3).to(torch.bfloat16).t(), requires_grad=False)  # strided
+        self.bias = torch.nn.Parameter(torch.randn(3), requires_grad=False)
+        self.register_buffer("_fp8_weight", torch.randn(4, 4).to(torch.float8_e4m3fn), persistent=False)
+        self.register_buffer("empty", torch.empty(0))
+        self.register_buffer("scale", torch.tensor(0.5))
+        self.register_buffer("unset", None)
+
+
+class FakeModel(torch.nn.Module):
+    def __init__(self, blocks=3):
+        super().__init__()
+        self.embed = torch.nn.Parameter(torch.randn(6, 2), requires_grad=False)
+        self.transformer_blocks = torch.nn.ModuleList([FakeBlock() for _ in range(blocks)])
+        with torch.inference_mode():
+            table = torch.randn(3, 2).to(torch.bfloat16)
+        self.register_buffer("table", table)        # an inference tensor, as the norm_out lookup table
+
+
+def pin_model(model):
+    with torch.no_grad():
+        return [snapshot.pin_block(torch, block, None) for block in model.transformer_blocks]
+
+
+def meta_twin(model_cls, *args):
+    with torch.device("meta"):
+        return model_cls(*args)
+
