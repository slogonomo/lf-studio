+        restoring.install_lora_bypass(pipe2)
+        restored = restoring.restore(self.loader, (), dict(self.kwargs))
+        self.assertIsNotNone(restored, fresh["stage1_snapshot"])
+        restored.eval()                                  # TransformerLoader after the load
+        pipe2._convert_one_transformer("transformer", restored)
+        pipe2._apply_constructor_adapter(mapping_transformer=restored)
+        construction = restoring.adopt(restored)
+        self.assertEqual(fresh["stage1_snapshot"]["status"], "RESTORED")
+        self.assertEqual(construction["merged_lora_layers"], 7)
+        self.assertEqual(construction["fp8_linear_names"], state["fp8_linear_names"])
+        self.assertEqual(restoring.lookup_record, state["fixed_lookup"])
