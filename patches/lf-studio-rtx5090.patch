+        for block, record in zip(self.pinned, index["blocks"]):
+            self.assertEqual(record["sha256"], hashlib.sha256(bytes(block.buffer[:block.nbytes].numpy())).hexdigest())
+            self.assertEqual(record["offset"] % snapshot.ALIGN, 0)
+        twin, pinned, stats = self.restore()
