+def run_wiring(setting):
+    env = dict(os.environ, CUDA_VISIBLE_DEVICES="", SOL_H3_DYNAMIC_TEXT_LENGTH=setting)
+    package = Path(__file__).resolve().parents[1]
+    result = subprocess.run([sys.executable, "-B", "-c", WIRING], cwd=package, env=env, capture_output=True,
+                            text=True, timeout=600)
+    if result.returncode != 0:
+        raise AssertionError(f"wiring subprocess failed:\n{result.stderr[-3000:]}")
+    return json.loads(result.stdout.strip().splitlines()[-1])
