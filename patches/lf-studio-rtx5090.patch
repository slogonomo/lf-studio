+    def test_unload_while_a_reshape_waits_for_a_loading_encoder(self):
+        """A 15 s session went back to 10 s, and its resident Qwen (r1) is still loading. Another reshape (5 s) waits
+        for it; meanwhile Unload closes the pipeline on another thread. r1 is closed once it has loaded, the reshape
+        fails instead of reporting a change on a closed pipeline, and close() returns only after r1 is closed."""
+        import threading
+        loaded = threading.Event()
+        submitted = threading.Event()
+
+        class SlowQwen(GeometryWorker):
+            def __init__(self, name, root, paths, config):
+                super().__init__(name, root, paths, config)
+                if Path(root).name == "qwen-worker-r1":
+                    loaded.wait(10)                           # loading in the background (20-60 s on the GPU)
+
+            def submit(self, op="run", **kwargs):
+                response = super().submit(op, **kwargs)
+                if op == "reshape" and self.name == "stage2" and kwargs["config"] == load_recipe():
+                    submitted.set()
+                return response
+        pipeline = Pipeline({}, Path(self.directory.name) / "unload", offload_mode="none", worker_factory=SlowQwen)
+        self.addCleanup(pipeline.close)
+        self.addCleanup(loaded.set)
+        pipeline.start({"case_id": "c0", "prompt": "A fox.", "seed": 1}, deliver=True)
+        pipeline.reshape(seconds=15)
+        self.assertEqual(pipeline.reshape(seconds=10)["workers"]["qwen"]["spawn"], "after_reshape")
+        outcome = {}
+
+        def run(name, call):
+            try:
+                outcome[name] = call()
+            except BaseException as error:     # noqa: BLE001 - checked below
+                outcome[name] = error
+        reshaping = threading.Thread(target=run, args=("reshape", lambda: pipeline.reshape(seconds=None)))
+        reshaping.start()
+        self.assertTrue(submitted.wait(5))
+        closing = threading.Thread(target=run, args=("close", pipeline.close))
+        closing.start()
+        for _ in range(500):
+            if pipeline.closing:
+                break
+            threading.Event().wait(0.01)
+        self.assertTrue(pipeline.closing)
+        threading.Event().wait(0.1)                   # close() has gone as far as it can while r1 loads
+        self.assertTrue(closing.is_alive())           # and waits for r1
+        loaded.set()
+        for thread in (reshaping, closing):
+            thread.join(10)
+            self.assertFalse(thread.is_alive())
+        self.assertIsInstance(outcome["reshape"], RuntimeError)
+        self.assertIn("closing", str(outcome["reshape"]))
+        self.assertIsNone(outcome["close"])
+        self.assertIn("qwen-worker-r1", self.qwen_roots("close"))
+        self.assertEqual(sorted(self.qwen_roots("start")), sorted(self.qwen_roots("close")))
+        self.assertIsNone(pipeline.qwen)
+        saved = json.loads((pipeline.root / "results.json").read_text())
+        self.assertEqual([r["to"]["output_frames"] for r in saved["reshapes"]], [361, 241])   # not the 5 s one
