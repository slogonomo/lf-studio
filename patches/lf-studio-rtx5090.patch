+    def __init__(self, transformer_loader):
+        from fastvideo.pipelines.lazy_module import LazyModule
+        super().__init__()
+        self.modules.update(transformer=LazyModule("transformer", transformer_loader),
+                            text_encoder=LazyModule("text_encoder", lambda: None),
+                            vae=LazyModule("vae", lambda: None))
+        self.exclude_lora_layers = {}
+        self.post_init_called = False
+        # FastVideo's LoRA transform, registered when the pipeline is made (before install_worker's)
+        self.modules["transformer"].set_materialize_transform(self.lora_after_load)
+
+    def lora_after_load(self, module):
+        self._convert_one_transformer("transformer", module)
+        self._apply_constructor_adapter(mapping_transformer=module)
+        return module
+
+    def _exclude_lora_layers_for(self, name, module):
+        return self.exclude_lora_layers.setdefault(name, [])
+
+    def post_init(self):
+        pass
