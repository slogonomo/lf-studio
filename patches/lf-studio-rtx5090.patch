+"""Run explicitly in the Stage1 environment on one visible RTX 5090 (not part of the CPU suite).
+
+lf-studio: end-to-end check of the Stage-1 snapshot (runtime/stage1_ops/snapshot.py).
+Part of lf-studio (Apache-2.0); not part of the upstream Sol-H3-RTX5090 package.
+
+1. One Qwen worker encodes the prompt once; every phase below uses that same conditioning file.
+2. Phase "build": a fresh Stage1 worker with an empty snapshot folder builds H3 from the checkpoint (LoRA merge,
+   exact lookup, FP8, pinning), saves the snapshot, renders one draft, and dumps a manifest of its resident
+   transformer (snapshot.transformer_manifest: module tree with types, training flags, every other module attribute
+   (plain values by repr, objects by type) and its non-persistent buffer names, FP8 methods, hooks and compiled
+   forwards; every parameter and buffer with dtype, shape, stride, device, pinned-ness (is_pinned() and the CUDA
+   registration of the tensor's own first and last byte), requires_grad, inference flag, offset in its block buffer
+   and the SHA-256 of its bytes; the state_dict keys; the per-block pinned layouts; the pipeline's LoRA bookkeeping
+   including its excluded-layer cache; whether the lookup schedule counts into the worker state's record; the
+   worker state).
+3. Phase "restore": a fresh process restores the snapshot (no checkpoint read), renders the same draft (same
+   conditioning, seed and shape), dumps the same manifest.
+4. Phase "control" (skip with --no-control): another normal build with snapshots off. Two normal builds must match
+   each other too; if their drafts differ, Stage 1 is not run-to-run bit-exact here and the latent comparison says
+   nothing about the snapshot (the manifest comparison still does).
+Then: the manifests must be identical (snapshot.compare_manifests: model tree, every tensor bit for bit, layouts,
+structural state fields), the build must report SAVED and the restore RESTORED, every body-block tensor must be
+page-locked in both (is_pinned() and registered), and the drafts (H3 latents and audio of capture.json) must be
+bit-identical.
+
+    cd models/minimax_h3/Sol-H3-RTX5090
+    <stage1 python> tests/check_stage1_snapshot_gpu.py --paths <paths.json> [--task t2va]
+
+The snapshot of the check (about 31 GB) goes to <out>/snapshots and is removed at the end (--keep-snapshot keeps it).
+Exit status 0 = PASS.
+"""
+import argparse
+import functools
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+PACKAGE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(PACKAGE))
+
+
+def write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=1, default=str) + "\n")
+
+
+# --------------------------------------------------------------------------- one phase (a child process)
+
+def run_phase(options_path):
+    """A fresh Stage1 session: one request, then the manifest of its transformer."""
+    from runtime import stage1
+    from runtime.stage1_ops import snapshot
+    options = json.loads(Path(options_path).read_text())
+    started = time.monotonic()
+    session = stage1.Session(options["paths"], options["work_dir"], options["config"])
+    try:
+        session_s = time.monotonic() - started
+        receipt = session.run(options["case"], options["conditioning_path"], options["outputdir"])
+        manifest_started = time.monotonic()
+        session.rpc(functools.partial(snapshot.transformer_manifest, path=options["manifest"]))
+        result = {"status": "PASS", "session_s": session_s, "request_wall_s": receipt["request_wall_s"],
+                  "manifest_s": time.monotonic() - manifest_started,
+                  "stage1_snapshot": receipt["actual"].get("stage1_snapshot"),
+                  "capture_path": receipt["capture_path"]}
+    finally:
+        session.close()
+    write_json(options["result"], result)
+
+
+# --------------------------------------------------------------------------- the check (parent)
+
+def tensor_bytes(t):
+    import torch
+    t = t.detach().cpu().contiguous()
+    return t.view(torch.uint8).numpy().tobytes() if t.numel() else b""
+
+
+def compare_captures(a_path, b_path):
+    """Bitwise comparison of two capture.json drafts (every tensor of their payload files)."""
+    import torch
+    a, b = json.loads(Path(a_path).read_text()), json.loads(Path(b_path).read_text())
+    report = {"payload_sha256_equal": a["payload_sha256"] == b["payload_sha256"],
+              "native_sha256_equal": a["native_normalized_sha256"] == b["native_normalized_sha256"],
+              "tensors": {}}
+    for key in ("payload_path", "native_normalized_path"):
+        x = torch.load(a[key], map_location="cpu", weights_only=True)
+        y = torch.load(b[key], map_location="cpu", weights_only=True)
+        for name in sorted(set(x) | set(y)):
+            if name not in x or name not in y:
+                report["tensors"][f"{key}:{name}"] = "missing"
+                continue
+            same = (x[name].dtype == y[name].dtype and x[name].shape == y[name].shape
+                    and tensor_bytes(x[name]) == tensor_bytes(y[name]))
+            entry = {"bit_exact": same, "dtype": str(x[name].dtype), "shape": list(x[name].shape)}
+            if not same and x[name].shape == y[name].shape:
+                entry["max_abs"] = float((x[name].float() - y[name].float()).abs().max())
+            report["tensors"][f"{key}:{name}"] = entry
+    report["bit_exact"] = all(isinstance(v, dict) and v["bit_exact"] for v in report["tensors"].values())
+    return report
+
+
+def blocks_page_locked(manifest):
+    """Every body-block tensor (with bytes) is pinned: is_pinned() and, where the driver answered, its own first
+    and last byte registered with CUDA."""
+    for tensor in manifest["tensors"]:
+        if not tensor["name"].startswith("transformer_blocks.") or tensor["registered"] is None:
+            continue
+        if tensor["pinned"] is not True or False in tensor["registered"]:
+            return False
+    return True
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--phase", help=argparse.SUPPRESS)
+    parser.add_argument("--options", help=argparse.SUPPRESS)
+    parser.add_argument("--paths", type=Path, help="runtime path file (prepare.py)")
+    parser.add_argument("--task", default="t2va", choices=("t2va", "fl2va", "ref2va"))
+    parser.add_argument("--case", type=Path, help="JSON case for fl2va/ref2va (first_frame/last_frame/references)")
+    parser.add_argument("--prompt", default="A red kite rises over a windy beach at sunset; waves crash. "
+                                            "Soundscape: wind gusts, surf, a kite string humming.")
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--out", type=Path, help="new folder for the check (default: <data root>/checks/...)")
+    parser.add_argument("--no-control", action="store_true", help="skip the second normal build")
+    parser.add_argument("--keep-snapshot", action="store_true", help="keep <out>/snapshots afterwards")
+    args = parser.parse_args(argv)
+    if args.phase:
+        return run_phase(args.options)
+    if args.paths is None:
+        parser.error("--paths is required")
+
+    from runtime.config import data_root, load_paths, load_recipe, normalize_case
+    from runtime.pipeline import Worker, worker_environment
+    from runtime.stage1_ops import snapshot
+    paths = load_paths(args.paths, task=args.task)
+    config = load_recipe(args.task)
+    config["execution"] = {"offload": "cpu", "gpu_count": 1, "qwen_lifetime": "one_request", "overlap_stages": False}
+    case = json.loads(args.case.read_text()) if args.case else {}
+    case = normalize_case({"case_id": "snapshot-check", "prompt": args.prompt, "seed": args.seed,
+                           "task": args.task, **case}, base_dir=args.case.parent if args.case else None)
+    out = (args.out or data_root() / "checks" / time.strftime("stage1-snapshot-%Y%m%d-%H%M%S")).resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    snapshots = out / "snapshots"
+    print(f"[check] folder {out}", flush=True)
+
+    qwen = Worker("qwen", out / "qwen-worker", paths, config)
+    try:
+        conditioning = qwen.call(case=case, output_root=str(out / "qwen"))
+    finally:
+        qwen.close()
+    print(f"[check] conditioning {conditioning['conditioning_path']}", flush=True)
+
+    phases = [("build", str(snapshots)), ("restore", str(snapshots))]
+    if not args.no_control:
+        phases.append(("control", "0"))
+    results = {}
+    for name, setting in phases:
+        folder = out / name
+        folder.mkdir()
+        options = {"paths": paths, "config": config, "case": case, "work_dir": str(folder / "model"),
+                   "conditioning_path": conditioning["conditioning_path"], "outputdir": str(folder / "stage1"),
+                   "manifest": str(folder / "manifest.json"), "result": str(folder / "result.json")}
+        write_json(folder / "options.json", options)
+        env = worker_environment("stage1", paths)
+        env["SOL_H3_STAGE1_SNAPSHOTS"] = setting
+        env.pop("SOL_H3_STAGE1_SNAPSHOT_VERIFY", None)       # the restore verifies every SHA-256
+        print(f"[check] phase {name} (SOL_H3_STAGE1_SNAPSHOTS={setting}); log {folder / 'worker.log'}", flush=True)
+        started = time.monotonic()
+        with open(folder / "worker.log", "x") as log:
+            code = subprocess.call([paths["stage1_python"], str(Path(__file__).resolve()), "--phase", name,
+                                    "--options", str(folder / "options.json")],
+                                   cwd=PACKAGE, env=env, stdout=log, stderr=subprocess.STDOUT)
+        if code != 0 or not (folder / "result.json").exists():
+            print(f"[check] phase {name} failed (exit {code}); see {folder / 'worker.log'}", flush=True)
+            return 2
+        results[name] = json.loads((folder / "result.json").read_text())
+        results[name]["phase_s"] = time.monotonic() - started
+        print(f"[check] phase {name}: request {results[name]['request_wall_s']:.1f} s, "
+              f"snapshot {results[name]['stage1_snapshot']}", flush=True)
+
+    manifests = {name: json.loads((out / name / "manifest.json").read_text()) for name in results}
+    problems, info = snapshot.compare_manifests(manifests["build"], manifests["restore"])
+    summary = {"folder": str(out), "task": args.task, "seed": args.seed,
+               "tensors": len(manifests["build"]["tensors"]), "modules": len(manifests["build"]["modules"]),
+               "statuses": {name: (result["stage1_snapshot"] or {}).get("status") for name, result in results.items()},
+               "timing_s": {name: {"request_wall": result["request_wall_s"], "phase": result["phase_s"],
+                                   **{k: v for k, v in (result["stage1_snapshot"] or {}).items()
+                                      if k.endswith("_s")}} for name, result in results.items()},
+               "manifest_build_vs_restore": {"problems": problems, "info": info[:50], "info_count": len(info)},
+               "draft_build_vs_restore": compare_captures(results["build"]["capture_path"],
+                                                          results["restore"]["capture_path"])}
+    if "control" in results:
+        control_problems, control_info = snapshot.compare_manifests(manifests["build"], manifests["control"])
+        summary["manifest_build_vs_control"] = {"problems": control_problems, "info_count": len(control_info)}
+        summary["draft_build_vs_control"] = compare_captures(results["build"]["capture_path"],
+                                                             results["control"]["capture_path"])
+    checks = {"build_saved": summary["statuses"]["build"] == "SAVED",
+              "restore_restored": summary["statuses"]["restore"] == "RESTORED",
+              "manifests_identical": not problems,
+              "blocks_page_locked": all(blocks_page_locked(manifests[name]) for name in ("build", "restore")),
+              "draft_bit_exact": summary["draft_build_vs_restore"]["bit_exact"]}
+    if "control" in results:
+        checks["control_off"] = summary["statuses"]["control"] == "OFF"
+        if not summary["draft_build_vs_control"]["bit_exact"]:
+            # two normal builds differ: the draft comparison cannot judge the snapshot
+            checks["draft_bit_exact"] = None
+            summary["note"] = "two normal builds gave different drafts: Stage 1 is not run-to-run bit-exact here"
+    summary["checks"] = checks
+    summary["status"] = "PASS" if all(value is not False for value in checks.values()) else "FAIL"
+    write_json(out / "summary.json", summary)
+    print(json.dumps(summary, indent=1, default=str), flush=True)
+    if not args.keep_snapshot:
+        for folder in list(snapshots.iterdir()) if snapshots.is_dir() else []:
+            snapshot.remove_snapshot_dir(folder)
+        try:
+            snapshots.rmdir()
+        except OSError:
+            pass
+    return 0 if summary["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
