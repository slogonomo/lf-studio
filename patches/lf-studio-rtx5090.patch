+class LayoutTests(unittest.TestCase):
+    def test_plan_layout_keeps_the_pin_rule(self):
+        torch.manual_seed(0)
+        block = FakeBlock()
+        items = snapshot.block_items(block)
+        entries, total = snapshot.plan_layout(items)
+        spans, old_total = old_pin_offsets([t for _, _, t in items])
+        self.assertEqual(total, old_total)
+        self.assertEqual([e["offset"] for e in entries], [offset for offset, _ in spans])
+        self.assertEqual([(e["name"], e["kind"]) for e in entries],
+                         [("weight", "param"), ("bias", "param"), ("_fp8_weight", "buffer"), ("empty", "buffer"),
+                          ("scale", "buffer")])
+        self.assertTrue(all(e["offset"] % 64 == 0 for e in entries))
+
+    def test_pin_block_carves_the_block_into_one_aligned_buffer(self):
+        torch.manual_seed(1)
+        block = FakeBlock()
+        before = {name: t.clone() for name, _, t in snapshot.block_items(block)}
+        weight = block.weight
+        registered = []
+        with torch.no_grad():
+            pinned = snapshot.pin_block(torch, block, registered.append)
+        self.assertEqual(len(registered), 1)
+        buffer = pinned.buffer
+        # the whole allocation is registered: it starts where the tensors' storage starts (is_pinned() asks there)
+        # and covers the aligned buffer
+        raw = registered[0]
+        self.assertEqual(raw.data_ptr(), buffer.untyped_storage().data_ptr())
+        self.assertEqual(raw.data_ptr(), block.weight.untyped_storage().data_ptr())
+        self.assertGreaterEqual(raw.data_ptr() + raw.numel(), buffer.data_ptr() + buffer.numel())
+        self.assertEqual(buffer.data_ptr() % snapshot.ALIGN, 0)
+        self.assertEqual(buffer.numel() % snapshot.ALIGN, 0)
+        self.assertFalse(buffer[pinned.nbytes:].any())
+        self.assertIs(block.weight, weight)              # parameters keep their objects (pin_idle_blocks)
+        self.assertEqual(block.weight.stride(), (1, 3))
+        for name, kind, t in snapshot.block_items(block):
+            self.assertTrue(torch.equal(t.view(torch.uint8) if t.dtype == torch.float8_e4m3fn else t,
+                                        before[name].view(torch.uint8) if t.dtype == torch.float8_e4m3fn
+                                        else before[name]), name)
+        snapshot.check_carved(block, pinned)
+        block.register_buffer("scale", torch.tensor(0.5))
+        with self.assertRaises(snapshot.SnapshotMismatch):
+            snapshot.check_carved(block, pinned)
