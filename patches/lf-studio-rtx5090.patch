+        """A reshape to 15 s closes the resident Qwen, which takes a while (up to 40 s for a real worker). Unload's
+        close() on another thread meanwhile finds no encoder of its own to close, and returns only once that one has
+        shut down."""
+        import threading
+        closing_qwen, closed = threading.Event(), threading.Event()
+
+        class SlowClose(GeometryWorker):
+            def close(self):
