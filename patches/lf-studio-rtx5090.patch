+"""lf-studio: LTX refiner blocks with the distilled LoRA fused once, streamed partly from disk.
+
+Part of lf-studio (Apache-2.0); not part of the upstream Sol-H3-RTX5090 package.
+
+NVIDIA's CPU offload pins all 48 LTX blocks in host RAM (about 40 GB, never swappable) and fuses the LoRA into
+them while building, which needs more RAM than a 64 GB workstation has next to H3. Here the fused blocks are
+written once to a block file (``build``), with the exact calls of LTX's pinned build: the same loader and key
+renaming, ``fuse_lora_weights`` with the same rule on the same GPU, the same 16-byte layout. A session then pins
+only the first ``resident`` blocks and reads the others from the file with large parallel O_DIRECT reads into a
+few pinned slots, ahead of use (``HybridWeightSource``). The bytes that reach the GPU are the same as with
+NVIDIA's pinned blocks; only where they wait in between differs.
+
+File layout: ``<dir>/blocks.bin`` holds each block's buffer image (``carve_buffer`` layout) at a 4096-byte
+aligned offset; ``<dir>/non_block.safetensors`` the fused non-block weights; ``<dir>/index.json`` the layouts,
+offsets, SHA-256 of every block and the identity of the inputs.
+"""
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import json
+import os
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+FORMAT = "sol-h3-studio-ltx-fused-blocks-v1"   # the studio's name up to 0.4, kept: files on disk carry it
+ALIGN = 4096
+CHUNK = 64 << 20            # bytes per preadv call
+READ_THREADS = 8
+
+
+def _ceil(n, a=ALIGN):
+    return -(-n // a) * a
+
+
+def _dtype_name(dtype):
+    return str(dtype).removeprefix("torch.")
+
+
+def _layout_json(layout):
+    return [[name, list(shape), _dtype_name(dtype)] for name, (shape, dtype) in layout.items()]
+
+
+def _layout_from_json(torch, items):
+    return {name: (torch.Size(shape), getattr(torch, dtype)) for name, shape, dtype in items}
+
+
+def _view(buf, nbytes):
+    """A writable memoryview over the first ``nbytes`` of a CPU uint8 tensor."""
+    return memoryview((ctypes.c_char * nbytes).from_address(buf.data_ptr())).cast("B")
+
+
+def _page_aligned_empty(torch, nbytes):
+    """CPU uint8 tensor whose data starts on a page boundary (O_DIRECT needs aligned buffers)."""
+    raw = torch.empty(nbytes + ALIGN, dtype=torch.uint8)
+    shift = (-raw.data_ptr()) % ALIGN
+    return raw[shift:shift + nbytes]
+
+
+class DirectFile:
+    """Parallel O_DIRECT reads of aligned ranges of one file into aligned buffers."""
+
+    def __init__(self, path, threads=READ_THREADS):
+        self.path = str(path)
+        try:
+            self.fd = os.open(self.path, os.O_RDONLY | getattr(os, "O_DIRECT", 0))
+            self.direct = True
+        except OSError:                 # e.g. tmpfs: same reads through the page cache
+            self.fd = os.open(self.path, os.O_RDONLY)
+            self.direct = False
+        self.pool = ThreadPoolExecutor(max_workers=threads, thread_name_prefix="ltx-blocks-read")
+
+    def read_into(self, buf, offset, nbytes):
+        """Fill buf[:nbytes] from the file at ``offset``; offset, nbytes and buf must be 4096-aligned."""
+        view = _view(buf, nbytes)
+
+        def part(start):
+            end = min(start + CHUNK, nbytes)
+            done = start
+            while done < end:
+                n = os.preadv(self.fd, [view[done:end]], offset + done)
+                if n <= 0:
+                    raise OSError(f"short read in {self.path} at {offset + done}")
+                done += n
+
+        return [self.pool.submit(part, start) for start in range(0, nbytes, CHUNK)]
+
+    def read(self, buf, offset, nbytes):
+        for future in self.read_into(buf, offset, nbytes):
+            future.result()
+
+    def close(self):
+        self.pool.shutdown(wait=True)
+        os.close(self.fd)
+
+
+# --------------------------------------------------------------------------- build (once, stage2 env, GPU)
+
+def build(builder, output_dir, *, identity, torch, exist_ok=False):
+    """Write the fused block file for ``builder`` (an LTX ``StreamingModelBuilder`` with its LoRA).
+
+    Mirrors ``StreamingModelBuilder._build_pinned_source`` and ``_load_non_block_weights``, one block at a time
+    so the host needs about one block plus the LoRA in RAM. Returns the index.
+    """
+    from safetensors.torch import save_file
+    from ltx_core.block_streaming import builder as sb
