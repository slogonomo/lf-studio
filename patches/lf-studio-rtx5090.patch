@@ -0,0 +1,1341 @@
+"""lf-studio: Stage-1 snapshot, the finished H3 transformer saved once and restored instead of rebuilt.
+
+Part of lf-studio (Apache-2.0); not part of the upstream Sol-H3-RTX5090 package.
+
+A Stage-1 cold start maps the 66 GB BF16 checkpoint, wraps 363 linears in LoRA layers, merges the FastH3 VSA (Ref2VA:
+Turbo) LoRA, computes the exact AdaLN lookup tables and converts 312 linears to W8A8 FP8, one body block at a time on
+the GPU, then copies each block once into its own page-locked buffer (offload.pin_idle_blocks): about 166 s on the
+RTX 5090 workstation. The result is fixed by its inputs (``worker_identity``: task family, checkpoint and LoRA files,
+torch/FastVideo versions, GPU, recipe and the code that builds it). The first session with a given identity builds
+the model as usual and saves it (``Controller.save``, at the end of stage1.quantize_after_merge); later sessions
+restore it (``Controller.restore``, in place of FastVideo's checkpoint load, through offload.install_stage1_loader).
+
+One snapshot is one folder ``<root>/<task>-<identity hash>`` (root: config.stage1_snapshots_dir()), written as a
+temporary folder and renamed when complete:
+
+  blocks.bin      each body block's page-locked buffer, byte for byte, at a 4096-byte aligned offset
+  non_block.bin   every other tensor (embeddings, the two text blocks with their FP8 buffers, the norm_out lookup
+                  table, the schedule indices, ...), laid out by the same rule
+  index.json      the identity; per block its offset, size, SHA-256 and layout (name, parameter or buffer, dtype,
+                  shape, stride, byte offset, requires_grad, inference tensor, device); the same for the non-block
+                  image; the structure record (module tree, FP8 linears, lookup record, LoRA bookkeeping, loader
+                  mapping) and the construction record (what the build recorded in the worker state)
+
+Restore, without reading the checkpoint or the LoRA: the model class is built on the meta device with FastVideo's
+own loader settings, and its tensors get the dtypes the loader's weight load assigns (apply_loader_dtypes: H3 keeps
+its input, time and output projections in FP32); the final structure is recreated by the functions the normal build
+uses (lookup.rebuild_exact_lookup for the lookup modules, lookup.tag_fp8_linears and FastVideo's convert_model_to_fp8
+for the FP8 linears; the LoRA wrappers are gone after a normal build, so nothing replaces them); the result must have
+exactly the saved module tree and tensors (validate_layout) before anything is read; each block is read with
+O_DIRECT into a cudaHostRegister'd buffer and its tensors are carved with the saved layout (as pin_idle_blocks
+carves them); the other tensors go to their saved devices with their exact bytes. FastVideo's loader then installs
+the offload hooks, and quantize_after_merge runs the same steps after this point as after a normal build.
+
+A snapshot that does not fit (SnapshotMismatch, at the restore or in a check after it) is retired: its data is
+deleted and its index kept as rejected.json with a count; the next worker builds and saves again, and an identity
+rejected MAX_REJECTIONS times is built without saving. A failure that is not the snapshot's (memory, environment
+checks, an interrupt) keeps it (Controller.failed).
+"""
+from __future__ import annotations
+
+from contextlib import nullcontext
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import time
+import traceback
+
+FORMAT = "sol-h3-studio-stage1-snapshot-v1"   # the studio's name up to 0.4, kept: files on disk carry it
+ALIGN = 4096                # file offsets, buffer addresses and lengths (O_DIRECT)
+SPAN_ALIGN = 64             # tensor offsets inside a block buffer (pin_idle_blocks' rule)
+CHUNK = 64 << 20            # bytes per pwritev call
+THREADS = 8
+BLOCKS_FILE, NON_BLOCK_FILE, INDEX_FILE = "blocks.bin", "non_block.bin", "index.json"
+REJECTED_FILE = "rejected.json"     # the index of a snapshot that did not fit, with a count (Controller.reject)
+MAX_REJECTIONS = 2          # an identity rejected this often is built without saving (no 31 GB write per session)
+SNAPSHOT_FILES = (BLOCKS_FILE, NON_BLOCK_FILE, INDEX_FILE, REJECTED_FILE)
+BLOCKS = "transformer_blocks"
+MIN_FREE_BYTES = 2 << 30    # left free on the snapshot disk after a save
+PACKAGE = Path(__file__).resolve().parents[2]
+# Code whose change can change the built model; any change makes a new identity (and a new snapshot).
+CODE_FILES = ("runtime/stage1.py", "runtime/offload.py", "runtime/fastload.py", "runtime/stage1_ops/lookup.py",
+              "runtime/stage1_ops/snapshot.py", "runtime/stage1_ops/tasks.py")
+# FastVideo: every .py file of the installed package (fastvideo_tree_sha256), so any module the build runs is covered
+# (the loader, LoRA and FP8 code, the H3 model, and the time path the lookup evaluates: layers/visual_embedding.py,
+# layers/mlp.py, layers/activation.py); about 1200 files, hashed once per worker in well under a second.
+FASTVIDEO_PACKAGE = "fastvideo"
+IDENTITY_ENV = ("FASTVIDEO_ATTENTION_BACKEND", "FASTVIDEO_MINIMAX_H3_FUSIONS", "FASTVIDEO_MINIMAX_H3_FA4_PACKED_VARLEN",
+                "FASTVIDEO_VSA_SM100A", "FASTVIDEO_VSA_CUTEDSL", "FASTVIDEO_VSA_TRITON", "FASTVIDEO_NVFP4_FA4",
+                "CUBLAS_WORKSPACE_CONFIG", "NVIDIA_TF32_OVERRIDE")
+# State fields of the build that the restored worker reports as its construction record.
+CONSTRUCTION_FIELDS = ("fp8_route", "merged_lora_layers", "fp8_linears", "fp8_linear_names", "fp8_weight_bytes",
+                       "fixed_lookup", "offload")
+
+
+class SnapshotError(RuntimeError):
+    pass
+
+
+class SnapshotCorrupt(SnapshotError):
+    """The files do not match their index (size, SHA-256): the snapshot is rewritten after the next normal build."""
+
+
+class SnapshotMismatch(SnapshotError):
+    """The snapshot does not describe this model (identity, layout or structure)."""
+
+
+class SnapshotSkipped(SnapshotError):
+    """Nothing is saved (not enough disk space, unpinned blocks, tensors the format does not carry)."""
+
+
+def _ceil(n, a=ALIGN):
+    return -(-n // a) * a
+
+
+def dtype_name(dtype):
+    return str(dtype).removeprefix("torch.")
+
+
+def type_name(obj):
+    cls = type(obj)
+    return f"{cls.__module__}.{cls.__qualname__}"
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+# --------------------------------------------------------------------------- layout (shared with pin_idle_blocks)
+
+def span_elements(t):
+    """Elements from a tensor's first to its last addressed element (its strides included)."""
+    return (1 + sum((size - 1) * stride for size, stride in zip(t.shape, t.stride()))) if t.numel() else 0
+
+
+def block_items(module):
+    """A module's tensors in pin order: its parameters, then the buffers that are set."""
+    return ([(name, "param", param) for name, param in module.named_parameters()]
+            + [(name, "buffer", buf) for name, buf in module.named_buffers() if buf is not None])
+
+
+def non_block_items(model):
+    """The model's tensors outside the body blocks, in the same order."""
+    prefix = BLOCKS + "."
+    return [item for item in block_items(model) if not item[0].startswith(prefix)]
+
+
+def plan_layout(items):
+    """Byte layout of ``items`` in one buffer: each span at the next 64-byte boundary (pin_idle_blocks' rule)."""
+    entries, total = [], 0
+    for name, kind, t in items:
+        span = span_elements(t)
+        total = _ceil(total, SPAN_ALIGN)
+        entries.append({"name": name, "kind": kind, "dtype": t.dtype, "shape": tuple(t.shape),
+                        "stride": tuple(t.stride()), "offset": total, "nbytes": span * t.element_size(),
+                        "requires_grad": bool(t.requires_grad) if kind == "param" else None,
+                        "inference": None, "device": str(t.device)})
+        total += span * t.element_size()
+    return entries, total
+
+
+def entries_json(entries):
+    return [{**entry, "dtype": dtype_name(entry["dtype"]), "shape": list(entry["shape"]),
+             "stride": list(entry["stride"])} for entry in entries]
+
+
+def entries_from_json(torch, items):
+    return [{**item, "dtype": getattr(torch, item["dtype"]), "shape": tuple(item["shape"]),
+             "stride": tuple(item["stride"])} for item in items]
+
+
+def host_buffer(torch, nbytes, register=None):
+    """CPU uint8 buffer for ``nbytes``: 4096-aligned, padded to a 4096 multiple (zeroed tail). The same allocation
+    for a pinned and for a restored block. ``register`` (cuda_host_register), when given, gets the WHOLE
+    allocation: the aligned buffer is a slice of it, and Tensor.is_pinned() asks CUDA about the start of a tensor's
+    storage, which is the allocation's start (registering only the slice left every block tensor is_pinned()=False,
+    as before this module the whole allocation was registered)."""
+    padded = _ceil(max(int(nbytes), 1))
+    raw = torch.empty(padded + ALIGN, dtype=torch.uint8)
+    shift = (-raw.data_ptr()) % ALIGN
+    buffer = raw[shift:shift + padded]
+    if padded > nbytes:
+        buffer[nbytes:].zero_()
+    if register is not None:
+        register(raw)
+    return buffer
+
+
+def cuda_host_register(torch):
+    """cudaHostRegister for host_buffer's allocation (as pin_idle_blocks did); unregistered when it is freed."""
+    import weakref
+    cudart = torch.cuda.cudart()
+
+    def register(raw):
+        ptr = raw.data_ptr()
+        if int(cudart.cudaHostRegister(ptr, raw.numel(), 0)) != 0:
+            raise RuntimeError("cudaHostRegister failed for an H3 block")
+        weakref.finalize(raw.untyped_storage(), lambda p=ptr: cudart.cudaHostUnregister(p))
+    return register
+
+
+def host_registered(ptr):
+    """Whether CUDA knows ``ptr`` as page-locked host memory (driver cuPointerGetAttribute, memory type HOST);
+    None when that cannot be asked (no driver, no context). For the GPU check: is_pinned() looks only at a storage's
+    start, this looks at the tensor's own first byte."""
+    import ctypes
+    import torch
+    if not torch.cuda.is_initialized():
+        return None
+    try:
+        cuda = ctypes.CDLL("libcuda.so.1")
+        kind = ctypes.c_uint(0)
+        # CU_POINTER_ATTRIBUTE_MEMORY_TYPE = 2; CU_MEMORYTYPE_HOST = 1; unregistered host memory: an error
+        status = cuda.cuPointerGetAttribute(ctypes.byref(kind), 2, ctypes.c_uint64(ptr))
+    except (OSError, AttributeError):
+        return None
+    return status == 0 and kind.value == 1
+
+
+def carve(torch, buffer, entries):
+    """Tensors over ``buffer`` with each entry's dtype, shape, stride and byte offset. A saved entry's inference
+    flag selects the mode the tensor is made in (None: the current mode)."""
+    storage, base = buffer.untyped_storage(), buffer.storage_offset()
+    out = []
+    for entry in entries:
+        size = entry["dtype"].itemsize
+        start = base + entry["offset"]
+        if start % size or entry["offset"] + entry["nbytes"] > buffer.numel():
+            raise SnapshotMismatch(f"layout entry {entry['name']} does not fit its buffer")
+        mode = entry.get("inference")
+        with torch.inference_mode(mode) if mode is not None else nullcontext():
+            dst = torch.empty(0, dtype=entry["dtype"])
+            dst.set_(storage, start // size, entry["shape"], entry["stride"])
+        out.append(dst)
+    return out
+
+
+def final_entries(entries, tensors):
+    """Entries with the inference flag of the tensors they describe (the record a restore recreates)."""
+    return [{**entry, "inference": bool(t.is_inference())} for entry, t in zip(entries, tensors)]
+
+
+def _owner(root, name):
+    parent, _, leaf = name.rpartition(".")
+    return (root.get_submodule(parent) if parent else root), leaf
+
+
+def assign_pinned(module, entry, tensor):
+    """pin_idle_blocks' assignment: a parameter keeps its object and gets new data; a buffer is replaced."""
+    if entry["kind"] == "param":
+        module.get_parameter(entry["name"]).data = tensor
+    else:
+        owner, leaf = _owner(module, entry["name"])
+        owner._buffers[leaf] = tensor
+
+
+class PinnedBlock:
+    """One body block's page-locked buffer, its layout and the bytes the layout uses."""
+
+    def __init__(self, buffer, entries, nbytes):
+        self.buffer, self.entries, self.nbytes = buffer, entries, int(nbytes)
+
+
+def pin_block(torch, module, register):
+    """Copy a block's tensors into one new buffer (plan_layout, host_buffer, carve) and point the block at them."""
+    items = block_items(module)
+    entries, total = plan_layout(items)
+    buffer = host_buffer(torch, total, register=register)
+    out = carve(torch, buffer, entries)
+    for (_, _, t), dst in zip(items, out):
+        dst.copy_(t)
+    for entry, dst in zip(entries, out):
+        assign_pinned(module, entry, dst)
+    return PinnedBlock(buffer, final_entries(entries, out), total)
+
+
+def _tensor(module, entry):
+    return module.get_parameter(entry["name"]) if entry["kind"] == "param" else module.get_buffer(entry["name"])
+
+
+def check_carved(module, pinned):
+    """The block's tensors are exactly the carved views of its buffer (a restored block before pinning)."""
+    items = block_items(module)
+    if [(name, kind) for name, kind, _ in items] != [(e["name"], e["kind"]) for e in pinned.entries]:
+        raise SnapshotMismatch("block tensors differ from their pinned layout")
+    base = pinned.buffer.data_ptr()
+    for (_, _, t), entry in zip(items, pinned.entries):
+        if (t.device.type != "cpu" or t.dtype != entry["dtype"] or tuple(t.shape) != tuple(entry["shape"])
+                or tuple(t.stride()) != tuple(entry["stride"])
+                or (t.numel() and t.data_ptr() != base + entry["offset"])):
+            raise SnapshotMismatch(f"block tensor {entry['name']} is not in its pinned buffer")
+
+
+# --------------------------------------------------------------------------- files
+
+def _view(buffer, nbytes):
+    import ctypes
+    return memoryview((ctypes.c_char * nbytes).from_address(buffer.data_ptr())).cast("B")
+
+
+def _sha256(buffer, nbytes):
+    return hashlib.sha256(_view(buffer, nbytes)).hexdigest() if nbytes else hashlib.sha256(b"").hexdigest()
+
+
+class DirectWriter:
+    """Parallel O_DIRECT writes of aligned buffers (buffered writes where O_DIRECT is unsupported, e.g. tmpfs)."""
+
+    def __init__(self, path, threads=THREADS):
+        from concurrent.futures import ThreadPoolExecutor
+        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
+        try:
+            self.fd = os.open(path, flags | getattr(os, "O_DIRECT", 0), 0o644)
+        except OSError:
+            self.fd = os.open(path, flags, 0o644)
+        self.path = str(path)
+        self.pool = ThreadPoolExecutor(max_workers=threads, thread_name_prefix="stage1-snapshot-write")
+
+    def write_from(self, buffer, offset, nbytes):
+        """Write buffer[:nbytes] at ``offset`` (all 4096-aligned); returns the futures."""
+        view = _view(buffer, nbytes)
+
+        def part(start):
+            end, done = min(start + CHUNK, nbytes), start
+            while done < end:
+                n = os.pwritev(self.fd, [view[done:end]], offset + done)
+                if n <= 0:
+                    raise OSError(f"short write in {self.path} at {offset + done}")
+                done += n
+        return [self.pool.submit(part, start) for start in range(0, nbytes, CHUNK)]
+
+    def close(self):
+        self.pool.shutdown(wait=True)
+        try:
+            os.fsync(self.fd)
+        finally:
+            os.close(self.fd)
+
+
+FS_IOC_GETFLAGS, FS_IOC_SETFLAGS, FS_NOCOW_FL = 0x80086601, 0x40086602, 0x00800000
+
+
+def set_nocow(path):
+    """chattr +C on a folder (best effort): files created in it afterwards skip btrfs copy-on-write and compression,
+    which O_DIRECT reads need to stay direct (config.data_root). True when the flag is set, False when it could not
+    be set, None when the filesystem has no such flag (tmpfs, ext4, ...)."""
+    import array
+    import errno
+    import fcntl
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    except OSError:
+        return False
+    try:
+        flags = array.array("l", [0])
+        fcntl.ioctl(fd, FS_IOC_GETFLAGS, flags, True)
+        if flags[0] & FS_NOCOW_FL:
+            return True
+        flags[0] |= FS_NOCOW_FL
+        fcntl.ioctl(fd, FS_IOC_SETFLAGS, flags, True)
+        return True
+    except OSError as error:
+        return None if error.errno in (errno.ENOTTY, errno.EOPNOTSUPP, errno.EINVAL, errno.ENOSYS) else False
+    finally:
+        os.close(fd)
+
+
+def _fsync_dir(path):
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def remove_snapshot_dir(path):
+    """Delete a snapshot or temporary folder: only its known files, then the folder (left if anything else is in
+    it). Never follows a symbolic link."""
+    path = Path(path)
+    if path.is_symlink() or not path.is_dir():
+        return False
+    for name in SNAPSHOT_FILES:
+        (path / name).unlink(missing_ok=True)
+    try:
+        path.rmdir()
+    except OSError:
+        return False
+    return True
+
+
+def _pid_alive(pid):
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    return True
+
+
+def prune(root, task, keep, exclude=None):
+    """Remove other snapshots of ``task`` beyond the ``keep`` most recently used (index.json mtime: a restore
+    touches it), and temporary folders of processes that are gone. Returns the removed folder names."""
+    root, removed = Path(root), []
+    if not root.is_dir():
+        return removed
+    snapshots = []
+    for entry in root.iterdir():
+        if entry.is_symlink() or not entry.is_dir() or entry.name == exclude:
+            continue
+        if entry.name.startswith(f".{task}-") and ".tmp-" in entry.name:
+            pid = entry.name.rsplit(".tmp-", 1)[1]
+            if pid.isdigit() and not _pid_alive(int(pid)) and remove_snapshot_dir(entry):
+                removed.append(entry.name)
+        elif entry.name.startswith(f"{task}-"):
+            if (entry / INDEX_FILE).is_file():
+                snapshots.append(((entry / INDEX_FILE).stat().st_mtime, entry))
+            elif (entry / REJECTED_FILE).is_file() and ((entry / BLOCKS_FILE).exists()
+                                                        or (entry / NON_BLOCK_FILE).exists()):
+                snapshots.append((0.0, entry))          # a rejected snapshot that still holds its data
+            # a folder with only rejected.json is the small marker of a rejected identity (Controller.reject): kept
+    snapshots.sort(reverse=True)
+    for _, entry in snapshots[max(keep, 0):]:
+        if remove_snapshot_dir(entry):
+            removed.append(entry.name)
+    return removed
+
+
+def write_snapshot(root, name, *, identity, blocks, non_block, structure, construction, keep=2, threads=THREADS,
+                   rejections=0):
+    """Write one snapshot folder ``root/name`` atomically and return its index.
+
+    blocks: a PinnedBlock per body block (written as they are); non_block: [(name, kind, tensor)], staged through one
+    host buffer. Other snapshots of the task beyond ``keep`` (this one included) are removed first. ``rejections``:
+    how often earlier snapshots of this identity were rejected (Controller.reject counts on from it).
+    """
+    import torch
+    root = Path(root)
+    if not root.is_dir():
+        root.mkdir(parents=True, exist_ok=True)
+        set_nocow(root)                 # later snapshots inherit it
+    task = identity["task"]
+    removed = prune(root, task, keep=keep - 1, exclude=name)
+    entries, total = plan_layout(non_block)
+    staging = host_buffer(torch, total)
+    out = carve(torch, staging, entries)
+    with torch.no_grad():
+        for (_, _, t), dst in zip(non_block, out):
+            dst.copy_(t)
+    entries = final_entries(entries, [t for _, _, t in non_block])
+    block_bytes = sum(block.buffer.numel() for block in blocks)
+    need = block_bytes + staging.numel() + (1 << 20)
+    free = shutil.disk_usage(root).free
+    if free < need + MIN_FREE_BYTES:
+        raise SnapshotSkipped(f"not enough disk space in {root}: {need / 2**30:.1f} GiB needed, "
+                              f"{free / 2**30:.1f} GiB free")
+    tmp = root / f".{name}.tmp-{os.getpid()}"
+    remove_snapshot_dir(tmp)
+    tmp.mkdir()
+    nocow = set_nocow(tmp)              # before any file is created in it (btrfs applies +C to new files only)
+    if nocow is False:
+        print(f"[lf-studio] Stage1 snapshot: could not set no-copy-on-write (chattr +C) on {root}; O_DIRECT "
+              "reads of a compressed or copy-on-write file are not direct (see config.data_root)", flush=True)
+    from concurrent.futures import ThreadPoolExecutor
+    hasher = ThreadPoolExecutor(max_workers=threads, thread_name_prefix="stage1-snapshot-sha")
+    try:
+        writer, futures, records, offset = DirectWriter(tmp / BLOCKS_FILE, threads), [], [], 0
+        try:
+            for block in blocks:
+                file_nbytes = block.buffer.numel()
+                futures += writer.write_from(block.buffer, offset, file_nbytes)
+                records.append({"offset": offset, "nbytes": block.nbytes, "file_nbytes": file_nbytes,
+                                "sha256": hasher.submit(_sha256, block.buffer, block.nbytes),
+                                "layout": entries_json(block.entries)})
+                offset += file_nbytes
+            for future in futures:
+                future.result()
+        finally:
+            writer.close()
+        writer = DirectWriter(tmp / NON_BLOCK_FILE, threads)
+        try:
+            for future in writer.write_from(staging, 0, staging.numel()):
+                future.result()
+        finally:
+            writer.close()
+        for record in records:
+            record["sha256"] = record["sha256"].result()
+        index = {"format": FORMAT, "name": name, "identity": json.loads(canonical(identity)),
+                 "identity_sha256": identity_sha256(identity),
+                 "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "blocks_file": BLOCKS_FILE,
+                 "blocks": records, "blocks_nbytes": offset,
+                 "non_block_file": NON_BLOCK_FILE,
+                 "non_block": {"offset": 0, "nbytes": total, "file_nbytes": staging.numel(),
+                               "sha256": _sha256(staging, total), "layout": entries_json(entries)},
+                 "structure": structure, "construction": construction, "pruned": removed,
+                 "rejections": int(rejections), "nocow": nocow}
+        with open(tmp / INDEX_FILE, "w") as stream:
+            stream.write(json.dumps(index, indent=1, default=str))
+            stream.flush()
+            os.fsync(stream.fileno())
+        _fsync_dir(tmp)
+        final = root / name
+        if final.exists():
+            remove_snapshot_dir(final)
+        os.rename(tmp, final)
+        _fsync_dir(root)
+    except BaseException:
+        remove_snapshot_dir(tmp)
+        raise
+    finally:
+        hasher.shutdown(wait=True)
+    return index
+
+
+def read_index(directory, identity=None):
+    """The snapshot's index; SnapshotMismatch if it was built from other inputs, SnapshotCorrupt if its files do
+    not have the sizes it records."""
+    directory = Path(directory)
+    try:
+        index = json.loads((directory / INDEX_FILE).read_text())
+    except (OSError, ValueError) as error:
+        raise SnapshotCorrupt(f"{directory}: unreadable index ({error})") from error
+    if not isinstance(index, dict) or index.get("format") != FORMAT:
+        raise SnapshotCorrupt(f"{directory}: not a {FORMAT} snapshot")
+    if identity is not None and canonical(index.get("identity")) != canonical(json.loads(canonical(identity))):
+        raise SnapshotMismatch(f"{directory}: built from other inputs")
+    try:
+        sizes = {BLOCKS_FILE: index["blocks_nbytes"], NON_BLOCK_FILE: index["non_block"]["file_nbytes"]}
+        if (sum(block["file_nbytes"] for block in index["blocks"]) != index["blocks_nbytes"]
+                or not {"structure", "construction"} <= set(index)):
+            raise KeyError("blocks")
+    except (KeyError, TypeError) as error:
+        raise SnapshotCorrupt(f"{directory}: incomplete index ({error})") from error
+    for name, expected in sizes.items():
+        path = directory / name
+        if not path.is_file() or path.stat().st_size != expected:
+            raise SnapshotCorrupt(f"{path}: missing or not {expected} bytes")
+    return index
+
+
+def _place(root, entry, tensor):
+    """Put a restored tensor where the rebuilt model holds its placeholder (same name, kind, dtype and shape;
+    meta, or whatever the constructor made, and replaced either way)."""
+    import torch
+    owner, leaf = _owner(root, entry["name"])
+    table = owner._parameters if entry["kind"] == "param" else owner._buffers
+    old = table.get(leaf)
+    if leaf not in table or old is None or old.dtype != entry["dtype"] or tuple(old.shape) != tuple(entry["shape"]):
+        raise SnapshotMismatch(f"{entry['name']}: the rebuilt model has no matching empty {entry['kind']}")
+    if entry["kind"] == "param":
+        tensor = torch.nn.Parameter(tensor, requires_grad=bool(entry["requires_grad"]))
+    table[leaf] = tensor
+
+
+def _to_device(torch, staging, entry):
+    """A tensor with the entry's exact bytes on its saved device, in its own storage, in the saved mode."""
+    nbytes = entry["nbytes"]
+    with torch.inference_mode(bool(entry["inference"])):
+        raw = torch.empty(nbytes, dtype=torch.uint8, device=entry["device"])
+        if nbytes:
+            raw.copy_(staging[entry["offset"]:entry["offset"] + nbytes])
+        out = torch.empty(0, dtype=entry["dtype"], device=entry["device"])
+        out.set_(raw.untyped_storage(), 0, entry["shape"], entry["stride"])
+    return out
+
+
+def model_tensors(model):
+    """{name: (kind, dtype, shape)} of every parameter and set buffer of a (meta) model."""
+    out = {}
+    for kind, getter in (("param", model.named_parameters), ("buffer", model.named_buffers)):
+        for name, t in getter():
+            if t is not None:
+                out[name] = (kind, t.dtype, tuple(t.shape))
+    return out
+
+
+def snapshot_tensors(torch, index):
+    """{name: (kind, dtype, shape)} of every tensor a snapshot holds (block entries under their full names)."""
+    out = {}
+    for number, info in enumerate(index["blocks"]):
+        for item in info["layout"]:
+            out[f"{BLOCKS}.{number}.{item['name']}"] = (item["kind"], getattr(torch, item["dtype"]),
+                                                        tuple(item["shape"]))
+    for item in index["non_block"]["layout"]:
+        out[item["name"]] = (item["kind"], getattr(torch, item["dtype"]), tuple(item["shape"]))
+    return out
+
+
+def validate_layout(model, index):
+    """Before any byte is read: the rebuilt (meta) model must have exactly the snapshot's module tree (names and
+    types) and exactly its tensors (name, parameter or buffer, dtype, shape). SnapshotMismatch otherwise."""
+    import torch
+    saved = index["structure"].get("modules")
+    if saved is not None and ([[name, type_name(module)] for name, module in model.named_modules()]
+                              != [[name, kind] for name, kind, _ in saved]):
+        raise SnapshotMismatch("the rebuilt module tree differs from the build")
+    if len(getattr(model, BLOCKS)) != len(index["blocks"]):
+        raise SnapshotMismatch("block count differs from the snapshot")
+    have, want = model_tensors(model), snapshot_tensors(torch, index)
+    if have != want:
+        only_model = sorted(set(have) - set(want))[:5]
+        only_saved = sorted(set(want) - set(have))[:5]
+        differ = sorted(name for name in set(have) & set(want) if have[name] != want[name])[:5]
+        raise SnapshotMismatch(f"the rebuilt tensors differ from the snapshot: only rebuilt {only_model}, only "
+                               f"saved {only_saved}, other kind/dtype/shape {[(n, have[n], want[n]) for n in differ]}")
+
+
+def restore_tensors(model, directory, index, *, register=None, verify=True, threads=THREADS):
+    """Fill a meta-built model from a snapshot: blocks into page-locked buffers (``register``), the other tensors to
+    their devices. Returns (PinnedBlock per block, statistics). Every tensor of the model must be placed; the
+    layout is checked against the model (validate_layout) before anything is allocated or read."""
+    import torch
+    from concurrent.futures import ThreadPoolExecutor
+    from ..stage2_ops.ltx_blocks import DirectFile
+    directory = Path(directory)
+    blocks = getattr(model, BLOCKS)
+    validate_layout(model, index)
+    started = time.monotonic()
+    pinned, checks, placed = [], [], 0
+    # Both files are opened first: a snapshot pruned by another process meanwhile stays readable (open files).
+    try:
+        reader = DirectFile(directory / BLOCKS_FILE, threads=threads)
+    except FileNotFoundError as error:
+        raise SnapshotCorrupt(f"{directory}: {error}") from error
+    try:
+        other = DirectFile(directory / NON_BLOCK_FILE, threads=threads)
+    except FileNotFoundError as error:
+        reader.close()
+        raise SnapshotCorrupt(f"{directory}: {error}") from error
+    pool = ThreadPoolExecutor(max_workers=threads, thread_name_prefix="stage1-snapshot-sha")
+    try:
+        for number, (block, info) in enumerate(zip(blocks, index["blocks"])):
+            entries = entries_from_json(torch, info["layout"])
+            buffer = host_buffer(torch, info["nbytes"], register=register)
+            if buffer.numel() != info["file_nbytes"]:
+                raise SnapshotCorrupt(f"block {number}: {info['file_nbytes']} file bytes for {info['nbytes']}")
+            reader.read(buffer, info["offset"], info["file_nbytes"])
+            if verify:
+                checks.append((number, info["sha256"], pool.submit(_sha256, buffer, info["nbytes"])))
+            for entry, tensor in zip(entries, carve(torch, buffer, entries)):
+                _place(block, entry, tensor)
+                placed += 1
+            pinned.append(PinnedBlock(buffer, entries, info["nbytes"]))
+        read_s = time.monotonic() - started
+        info = index["non_block"]
+        entries = entries_from_json(torch, info["layout"])
+        staging = host_buffer(torch, info["nbytes"])
+        if staging.numel() != info["file_nbytes"]:
+            raise SnapshotCorrupt("non-block image size differs from its index")
+        other.read(staging, 0, info["file_nbytes"])
+        if verify and _sha256(staging, info["nbytes"]) != info["sha256"]:
+            raise SnapshotCorrupt("non-block tensors do not match their SHA-256")
+        for entry in entries:
+            _place(model, entry, _to_device(torch, staging, entry))
+            placed += 1
+        for number, expected, future in checks:
+            if future.result() != expected:
+                raise SnapshotCorrupt(f"block {number} does not match its SHA-256")
+    finally:
+        reader.close()
+        other.close()
+        pool.shutdown(wait=True)
+    tensors = [t for _, t in model.named_parameters()] + [b for _, b in model.named_buffers() if b is not None]
+    if any(t.is_meta for t in tensors) or len(tensors) != placed:
+        raise SnapshotMismatch("the snapshot does not cover every tensor of the rebuilt model")
+    return pinned, {"read_bytes": index["blocks_nbytes"] + index["non_block"]["file_nbytes"],
+                    "blocks_read_s": round(read_s, 3), "sha256_verified": bool(verify),
+                    "direct_io": bool(reader.direct)}
+
+
+# --------------------------------------------------------------------------- identity
+
+def file_sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(1 << 22), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tree_sha256(directory, pattern="*.py"):
+    """One SHA-256 over every ``pattern`` file under ``directory`` (relative paths and contents, sorted)."""
+    directory, digest = Path(directory), hashlib.sha256()
+    for path in sorted(directory.rglob(pattern)):
+        if "__pycache__" in path.parts or not path.is_file():
+            continue
+        digest.update(str(path.relative_to(directory)).encode() + b"\0")
+        digest.update(bytes.fromhex(file_sha256(path)))
+    return digest.hexdigest()
+
+
+def _git_head(directory):
+    """The git commit of a source checkout (best effort; its .py files are hashed anyway)."""
+    import subprocess
+    try:
+        out = subprocess.run(["git", "-C", str(directory), "rev-parse", "HEAD"], capture_output=True, text=True,
+                             timeout=10)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    return out.stdout.strip() or None if out.returncode == 0 else None
+
+
+def code_hashes(package=PACKAGE, files=CODE_FILES, fastvideo=FASTVIDEO_PACKAGE):
+    import importlib.util
+    hashes = {name: file_sha256(Path(package) / name) for name in files}
+    spec = importlib.util.find_spec(fastvideo)
+    root = Path(spec.origin).parent if spec is not None and spec.origin else None
+    hashes["fastvideo_tree_sha256"] = tree_sha256(root) if root is not None else None
+    hashes["fastvideo_git_head"] = _git_head(root.parent) if root is not None else None
+    return hashes
+
+
+SAMPLE = 1 << 20
+
+
+def weight_file(path):
+    """A checkpoint or LoRA file without reading it whole: where it is (resolved path, inode), its size and mtime,
+    and SHA-256 of its safetensors header (names, dtypes, shapes, offsets, metadata) and of its first and last MiB.
+    A replaced file with the same tensor shapes (a retrained LoRA, a re-released checkpoint) changes mtime, inode
+    or the sampled bytes, so its old snapshot is not restored."""
+    import struct
+    path = Path(path)
+    st = os.stat(path)
+    with open(path, "rb") as stream:
+        head = stream.read(8)
+        header = b""
+        if len(head) == 8:
+            length = struct.unpack("<Q", head)[0]
+            if 0 < length <= min(st.st_size - 8, 100 << 20):
+                header = stream.read(length)
+        stream.seek(0)
+        first = stream.read(SAMPLE)
+        stream.seek(max(st.st_size - SAMPLE, 0))
+        last = stream.read(SAMPLE)
+    return {"file": "/".join(path.parts[-2:]), "path": os.path.realpath(path), "size": st.st_size,
+            "mtime_ns": st.st_mtime_ns, "inode": st.st_ino,
+            "header_sha256": hashlib.sha256(header).hexdigest() if header else None,
+            "sample_sha256": hashlib.sha256(first + last).hexdigest()}
+
+
+def library_versions():
+    """cuDNN and cuBLAS versions (best effort): kernels the build's GPU steps may use."""
+    import importlib.metadata
+    import torch
+    out = {}
+    try:
+        out["cudnn"] = torch.backends.cudnn.version()
+    except Exception:           # noqa: BLE001 - informational
+        out["cudnn"] = None
+    for name in ("nvidia-cublas", "nvidia-cublas-cu13", "nvidia-cublas-cu12"):
+        try:
+            out["cublas"] = f"{name} {importlib.metadata.version(name)}"
+            break
+        except importlib.metadata.PackageNotFoundError:
+            continue
+    return out
+
+
+def build_identity(*, task, model_class, hf_config, checkpoint, lora, dtypes, plans, versions, gpu, numerics, code,
+                   env, recipe_sha256):
+    """Everything the built transformer depends on; equal identities give bit-identical models."""
+    return json.loads(canonical({
+        "format": FORMAT, "task": task, "model_class": model_class,
+        "hf_config": {k: v for k, v in (hf_config or {}).items() if k != "_name_or_path"},
+        "checkpoint": sorted(checkpoint, key=lambda item: item["file"]), "lora": lora, "dtypes": dtypes,
+        "lookup_plans": plans, "versions": versions, "gpu": gpu, "numerics": numerics, "code": code,
+        "env": env, "recipe_sha256": recipe_sha256}))
+
+
+def identity_sha256(identity):
+    return hashlib.sha256(canonical(identity).encode()).hexdigest()
+
+
+def snapshot_name(identity):
+    return f"{identity['task']}-{identity_sha256(identity)[:16]}"
+
+
+def worker_identity(task, kwargs, pipe):
+    """The identity of the transformer FastVideo's loader is about to build (its maybe_load_fsdp_model kwargs)."""
+    import importlib.metadata
+    import torch
+    from ..config import FROZEN_RECIPE_SHA256
+    from .lookup import lookup_plans
+    from .vsa import FASTVIDEO_COMMIT
+    _, plans = lookup_plans(pipe, task)
+    checkpoint = [weight_file(path) for path in kwargs["weight_dir_list"]]
+    lora_path = kwargs.get("lora_path")
+    lora = None if not lora_path else {**weight_file(lora_path), "strength": float(kwargs.get("lora_strength", 1.0))}
+    try:
+        fastvideo_version = importlib.metadata.version("fastvideo")
+    except importlib.metadata.PackageNotFoundError:
+        fastvideo_version = None
+    model_cls = kwargs["model_cls"]
+    return build_identity(
+        task=task, model_class=f"{model_cls.__module__}.{model_cls.__qualname__}",
+        hf_config=dict(kwargs["init_params"].get("hf_config") or {}), checkpoint=checkpoint, lora=lora,
+        dtypes={key: str(kwargs.get(key)) for key in ("default_dtype", "param_dtype", "reduce_dtype", "output_dtype")},
+        plans=plans,
+        versions={"torch": torch.__version__, "cuda": torch.version.cuda, "fastvideo": fastvideo_version,
+                  "fastvideo_pinned_commit": FASTVIDEO_COMMIT, **library_versions()},
+        gpu={"name": torch.cuda.get_device_name(0), "capability": list(torch.cuda.get_device_capability(0))},
+        numerics={"float32_matmul_precision": torch.get_float32_matmul_precision(),
+                  "cuda_matmul_allow_tf32": torch.backends.cuda.matmul.allow_tf32,
+                  "cuda_matmul_allow_bf16_reduced": torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction,
+                  "cudnn_allow_tf32": torch.backends.cudnn.allow_tf32,
+                  "deterministic": torch.are_deterministic_algorithms_enabled()},
+        code=code_hashes(), env={key: os.environ.get(key) for key in IDENTITY_ENV},
+        recipe_sha256=FROZEN_RECIPE_SHA256)
+
+
+# --------------------------------------------------------------------------- structure
+
+def encode_mapping(mapping):
+    """FastVideo's reverse_param_names_mapping ({name: (source, merge_index, count)}) as JSON."""
+    if mapping is None:
+        return None
+    out = {}
+    for key, value in mapping.items():
+        if (not isinstance(key, str) or not isinstance(value, tuple) or len(value) != 3
+                or not isinstance(value[0], str) or any(v is not None and type(v) is not int for v in value[1:])):
+            raise SnapshotSkipped(f"reverse_param_names_mapping entry the format does not carry: {key!r}")
+        out[key] = list(value)
+    return out
+
+
+def decode_mapping(value):
+    return None if value is None else {key: tuple(item) for key, item in value.items()}
+
+
+def check_saveable(model):
+    """What the format carries: unshared parameters and buffers, plain non-inference Parameters with no extra
+    attributes (FastVideo's loader assigns such), one storage per non-block tensor."""
+    import torch
+    for getter in (model.named_parameters, model.named_buffers):
+        if len(list(getter(remove_duplicate=False))) != len(list(getter())):
+            raise SnapshotSkipped("the model shares a tensor between two names")
+    for name, param in model.named_parameters():
+        if type(param) is not torch.nn.Parameter or vars(param) or param.is_inference():
+            raise SnapshotSkipped(f"parameter {name} is not a plain Parameter")
+    storages = [t.untyped_storage().data_ptr() for _, _, t in non_block_items(model) if t.numel()]
+    if len(set(storages)) != len(storages):
+        raise SnapshotSkipped("two non-block tensors share a storage")
+
+
+def module_tree(model):
+    return [[name, type_name(module), bool(module.training)] for name, module in model.named_modules()]
+
+
+def loader_dtype(model, name, default_dtype):
+    """The dtype FastVideo's loader gives a loaded tensor (fsdp_load.load_model_from_full_model_state_dict: the
+    model's _get_parameter_dtype(name, default_dtype) when it has one; maybe_load_fsdp_model passes its
+    default_dtype as that function's param_dtype)."""
+    selector = getattr(model, "_get_parameter_dtype", None)
+    return selector(name, default_dtype) if callable(selector) else default_dtype
+
+
+def apply_loader_dtypes(model, default_dtype):
+    """Give the meta-built model the dtypes FastVideo's loader leaves: the constructor makes every parameter in the
+    default dtype (H3: BF16), the loader then assigns each checkpoint tensor cast to loader_dtype (H3 keeps proj_in,
+    audio_proj_in, time_embedder, proj_out and audio_proj_out in FP32: _keep_in_fp32_modules). Parameters and
+    persistent buffers (the state_dict entries the loader assigns); non-persistent buffers keep the constructor's
+    dtype, as materialize_non_persistent_buffers does. Returns the names changed."""
+    import torch
+    persistent = set(model.state_dict(keep_vars=True))
+    changed = []
+    for kind, getter in (("param", model.named_parameters), ("buffer", model.named_buffers)):
+        for name, t in list(getter()):
+            if t is None or (kind == "buffer" and name not in persistent):
+                continue
+            want = loader_dtype(model, name, default_dtype)
+            if t.dtype == want:
+                continue
+            owner, leaf = _owner(model, name)
+            empty = torch.empty(t.shape, dtype=want, device="meta")
+            if kind == "param":
+                owner._parameters[leaf] = torch.nn.Parameter(empty, requires_grad=False)
+            else:
+                owner._buffers[leaf] = empty
+            changed.append(name)
+    # TransformerLoader's check right after the load (component_loader: first parameter vs the selected dtype)
+    first_name, first = next(model.named_parameters())
+    if first.dtype != loader_dtype(model, first_name, default_dtype):
+        raise SnapshotMismatch("the rebuilt model fails FastVideo's loader dtype check")
+    return changed
+
+
+# --------------------------------------------------------------------------- the worker's controller
+
+class Controller:
+    """A Stage1 worker's snapshot: restore at the transformer load, save after a normal build. One per worker.
+
+    restore() runs inside FastVideo's loader (offload.install_stage1_loader); the LoRA bypass keeps FastVideo's
+    LoRA transform from wrapping a restored model; adopt() and save() run in stage1.quantize_after_merge.
+    """
+
+    def __init__(self, state, task, pipe, root, *, verify=True, keep=2):
+        self.state, self.task, self.pipe, self.root = state, task, pipe, Path(root)
+        self.verify, self.keep = verify, keep
+        self.record = state["stage1_snapshot"] = {"status": "ENABLED", "root": str(self.root)}
+        self.attempted = False
+        self.save_allowed = True
+        self.rejections = 0           # of earlier snapshots of this identity (rejected.json), carried into the next
+        self.model = self.index = self.pinned_blocks = self.lookup_record = None
+        self.identity = self.dir = self.load_started = None
+
+    # ---- restore
+    def restore(self, original_load, args, kwargs):
+        """offload's loader hook: the finished model from a matching snapshot, or None to build it."""
+        if self.attempted or args:
+            return None
+        self.attempted = True
+        model_cls = kwargs.get("model_cls")
+        if getattr(model_cls, "__name__", "") != "MiniMaxH3Transformer3DModel":
+            self.save_allowed = False
+            self.record.update(status="DISABLED", reason=f"not the H3 transformer: {model_cls}")
+            return None
+        self.load_started = time.monotonic()
+        try:
+            self.identity = worker_identity(self.task, kwargs, self.pipe)
+        except Exception as error:
+            self.save_allowed = False
+            self.record.update(status="DISABLED", reason=f"identity: {type(error).__name__}: {error}")
+            return None
+        self.dir = self.root / snapshot_name(self.identity)
+        self.record.update(dir=str(self.dir), identity_sha256=identity_sha256(self.identity))
+        if not (self.dir / INDEX_FILE).exists():
+            self.rejections = rejection_count(self.dir)
+            if self.rejections >= MAX_REJECTIONS:
+                self.save_allowed = False
+                self.record.update(status="BUILD_NO_SAVE", rejections=self.rejections,
+                                   reason=f"snapshots of this identity were rejected {self.rejections} times "
+                                          f"({self.dir / REJECTED_FILE}); remove that folder to try again")
+                print(f"[lf-studio] Stage1 snapshot: {self.record['reason']}; building without saving",
+                      flush=True)
+                return None
+            self.record["status"] = "BUILD_AND_SAVE"
+            print(f"[lf-studio] Stage1 snapshot: none for this model yet; building it and saving to {self.dir}",
+                  flush=True)
+            return None
+        index = None
+        try:
+            index = read_index(self.dir, self.identity)
+            try:
+                os.utime(self.dir / INDEX_FILE)          # most recently used, before the read (prune keeps it)
+            except FileNotFoundError as error:
+                raise SnapshotCorrupt(f"{self.dir}: removed while it was opened") from error
+            model = self._restore(index, kwargs)
+        except Exception as error:
+            # A corrupt snapshot is replaced after the build. A snapshot that does not fit the rebuilt model
+            # (SnapshotMismatch, found before its blocks are read) is retired, so the next worker builds and saves
+            # one that fits (at most MAX_REJECTIONS times per identity); this worker does not save. Any other
+            # failure (memory, I/O) keeps it and saves nothing.
+            self.save_allowed = isinstance(error, SnapshotCorrupt)
+            self.record.update(status="RESTORE_FAILED", error=f"{type(error).__name__}: {error}",
+                               replaced_after_build=self.save_allowed)
+            print(f"[lf-studio] Stage1 snapshot {self.dir} not restored ({type(error).__name__}: {error}); "
+                  "building from the checkpoint", flush=True)
+            traceback.print_exc()
+            self.model = self.pinned_blocks = self.lookup_record = None
+            if isinstance(error, SnapshotMismatch):
+                self.index = index
+                self.reject(error)
+                self.record.update(status="RESTORE_FAILED", rejected=True)
+            self.index = None
+            return None
+        return model
+
+    def _restore(self, index, kwargs):
+        import torch
+        from torch.distributed.fsdp import MixedPrecisionPolicy
+        from fastvideo.layers.quantization.fp8_config import convert_model_to_fp8
+        from fastvideo.models.loader import fsdp_load
+        from fastvideo.utils import set_mixed_precision_policy
+        from . import lookup
+        started = time.monotonic()
+        structure = index["structure"]
+        # FastVideo's maybe_load_fsdp_model up to its weight load: the same policy, dtype and meta construction.
+        param_dtype, reduce_dtype = kwargs["param_dtype"], kwargs["reduce_dtype"]
+        output_dtype = kwargs.get("output_dtype")
+        policy = MixedPrecisionPolicy(param_dtype, reduce_dtype, output_dtype, cast_forward_inputs=False)
+        set_mixed_precision_policy(param_dtype=param_dtype, reduce_dtype=reduce_dtype, output_dtype=output_dtype,
+                                   mp_policy=policy)
+        with fsdp_load.set_default_dtype(kwargs["default_dtype"]), torch.device("meta"):
+            model = kwargs["model_cls"](**kwargs["init_params"])
+        # ... and the dtypes its weight load assigns (FP32 projections of H3)
+        apply_loader_dtypes(model, kwargs["default_dtype"])
+        # The final structure, by the functions the normal build uses (stage1.quantize_after_merge): the lookup
+        # modules, then FastVideo's FP8 tagging and conversion (meta tensors here, real ones there).
+        specs = {}
+        for number, info in enumerate(index["blocks"]):
+            for item in info["layout"]:
+                specs[f"{BLOCKS}.{number}.{item['name']}"] = (tuple(item["shape"]), getattr(torch, item["dtype"]))
+        for item in index["non_block"]["layout"]:
+            specs[item["name"]] = (tuple(item["shape"]), getattr(torch, item["dtype"]))
+        record = json.loads(json.dumps(structure["fixed_lookup"]))
+        lookup.rebuild_exact_lookup(model, record, specs, torch.device("meta"))
+        tagged = lookup.tag_fp8_linears(model)
+        if tagged != structure["fp8_linear_names"]:
+            raise SnapshotMismatch("FP8 linears differ from the snapshot")
+        convert_model_to_fp8(model)
+        validate_layout(model, index)          # before any byte is allocated or read
+        built_s = time.monotonic() - started
+        register = cuda_host_register(torch) if torch.cuda.is_available() else None
+        with torch.no_grad():
+            pinned, stats = restore_tensors(model, self.dir, index, register=register, verify=self.verify)
+        # The rest of the loader: requires_grad off (kept per tensor in the layout), the name mapping it records.
+        model.reverse_param_names_mapping = decode_mapping(structure["reverse_param_names_mapping"])
+        self.model, self.index, self.pinned_blocks, self.lookup_record = model, index, pinned, record
+        self.record.update(status="RESTORING", meta_build_s=round(built_s, 3),
+                           restore_s=round(time.monotonic() - self.load_started, 3), **stats)
+        print(f"[lf-studio] Stage1 snapshot restored from {self.dir} in {self.record['restore_s']:.1f} s "
+              f"({stats['read_bytes'] / 2**30:.1f} GiB)", flush=True)
+        return model
+
+    def restored(self, model):
+        return self.model is not None and model is self.model
+
+    def reject(self, error):
+        """The snapshot does not fit (SnapshotMismatch at the restore, or a snapshot check after it): retire it
+        (index.json becomes rejected.json with a rejection count), so the next worker builds from the checkpoint and
+        saves a new one in its place, until MAX_REJECTIONS for this identity."""
+        count = None
+        if self.dir is not None:
+            try:
+                index = self.index if self.index is not None else json.loads((self.dir / INDEX_FILE).read_text())
+                count = int(index.get("rejections", 0)) + 1
+                rejected = {**index, "rejections": count, "rejected": f"{type(error).__name__}: {error}",
+                            "rejected_at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
+                tmp = self.dir / f".{REJECTED_FILE}.tmp-{os.getpid()}"
+                tmp.write_text(json.dumps(rejected, indent=1, default=str))
+                os.replace(tmp, self.dir / REJECTED_FILE)
+                # only the small rejected.json stays (the marker the rejection count lives in); the ~31 GB of data
+                # is of no use any more (a restored model already holds its copy in memory)
+                for name in (INDEX_FILE, BLOCKS_FILE, NON_BLOCK_FILE):
+                    (self.dir / name).unlink(missing_ok=True)
+            except (OSError, ValueError):
+                try:
+                    os.replace(self.dir / INDEX_FILE, self.dir / REJECTED_FILE)
+                except OSError:
+                    pass
+        self.record.update(status="REJECTED", error=f"{type(error).__name__}: {error}", rejections=count)
+        print(f"[lf-studio] Stage1 snapshot {self.dir} rejected ({type(error).__name__}: {error}); "
+              "the next session builds from the checkpoint", flush=True)
+
+    def failed(self, model, error):
+        """A step after the restore failed on ``model``: retire the snapshot only when the snapshot is the cause
+        (a SnapshotError: adopt, the restored FP8 checks, the pinned buffers). Anything else (out of memory, the
+        VSA or compile environment checks, an interrupt) leaves a good snapshot in place."""
+        if model is None or not self.restored(model):
+            return
+        if isinstance(error, SnapshotError):
+            self.reject(error)
+        else:
+            self.record.update(failed_after_restore=f"{type(error).__name__}: {error}", kept=True)
+
+    def guard_loader(self, lazy):
+        """FastVideo's loader around a restored model (its dtype check, eval, the offload Manager): a failure there
+        retires the snapshot only when it is a SnapshotError (Controller.failed); wraps the lazy loader."""
+        loader = object.__getattribute__(lazy, "_lazy_loader")
+
+        def guarded():
+            try:
+                return loader()
+            except BaseException as error:
+                self.failed(self.model, error)
+                raise
+        object.__setattr__(lazy, "_lazy_loader", guarded)
+
+    def install_lora_bypass(self, pipe):
+        """FastVideo's LoRA transform runs on every load; a restored model already carries the merged result.
+        For it, skip the layer conversion and record the adapter as the constructor merge leaves it."""
+        convert, apply = pipe._convert_one_transformer, pipe._apply_constructor_adapter
+
+        def convert_one(transformer_name, module):
+            if self.restored(module):
+                # the conversion's own bookkeeping: the excluded-layer list it caches (no layers are wrapped)
+                exclude = getattr(pipe, "_exclude_lora_layers_for", None)
+                if exclude is not None:
+                    exclude(transformer_name, module)
+                return None
+            return convert(transformer_name, module)
+
+        def constructor_adapter(*, mapping_transformer=None):
+            if mapping_transformer is not None and self.restored(mapping_transformer):
+                # set_lora_adapter's bookkeeping for the constructor adapter; its tensors are cleared after the
+                # merge in the normal build too (quantize_after_merge)
+                pipe.cur_adapter_name, pipe.cur_adapter_path = pipe.lora_nickname, pipe.lora_path
+                pipe.cur_adapter_strength = pipe.lora_strength
+                pipe.lora_adapter_paths[pipe.lora_nickname] = pipe.lora_path
+                return None
+            return apply(mapping_transformer=mapping_transformer)
+        pipe._convert_one_transformer, pipe._apply_constructor_adapter = convert_one, constructor_adapter
+
+    def adopt(self, model):
+        """Check a restored model after FastVideo's loader (module tree, tensors in place) and give its modules
+        the training flags of the build. Returns the construction record of the build. SnapshotMismatch when it
+        does not fit (Controller.failed then retires the snapshot)."""
+        if not self.restored(model):
+            raise SnapshotMismatch("not the restored model")
+        saved = self.index["structure"]["modules"]
+        modules = list(model.named_modules())
+        if [[name, type_name(module)] for name, module in modules] != [[name, kind] for name, kind, _ in saved]:
+            raise SnapshotMismatch("the restored module tree differs from the build")
+        for (_, module), (_, _, training) in zip(modules, saved):
+            module.training = training
+        for block, pinned in zip(getattr(model, BLOCKS), self.pinned_blocks):
+            check_carved(block, pinned)
+        construction = self.index["construction"]
+        self.record.update(status="RESTORED", saved=self.index["created"],
+                           construction={key: value for key, value in construction.items()
+                                         if key not in ("fp8_linear_names", "fixed_lookup")})
+        return construction
+
+    # ---- save
+    def save(self, model, manager):
+        """After a normal build: write the snapshot (never raises; the outcome is in the worker state)."""
+        if not self.save_allowed or self.dir is None or manager is None:
+            return
+        started = time.monotonic()
+        try:
+            if any(state.pinned is None for state in manager.states):
+                raise SnapshotSkipped("the blocks are not pinned (SOL_H3_STAGE1_PIN=0)")
+            check_saveable(model)
+            pipe = self.pipe
+            structure = {"modules": module_tree(model), "fp8_linear_names": list(self.state["fp8_linear_names"]),
+                         "fp8_granularity": "tensor",
+                         "fixed_lookup": json.loads(json.dumps(self.state["fixed_lookup"])),
+                         "reverse_param_names_mapping": encode_mapping(
+                             getattr(model, "reverse_param_names_mapping", None)),
+                         "lora": {"nickname": pipe.lora_nickname, "path": pipe.lora_path,
+                                  "strength": pipe.lora_strength, "cur_adapter_name": pipe.cur_adapter_name,
+                                  "cur_adapter_path": pipe.cur_adapter_path,
+                                  "cur_adapter_strength": pipe.cur_adapter_strength}}
+            construction = json.loads(json.dumps({key: self.state[key] for key in CONSTRUCTION_FIELDS},
+                                                 default=str))
+            construction["construction_s"] = round(started - self.load_started, 3) if self.load_started else None
+            index = write_snapshot(self.root, self.dir.name, identity=self.identity,
+                                   blocks=[state.pinned for state in manager.states],
+                                   non_block=non_block_items(model), structure=structure,
+                                   construction=construction, keep=self.keep, rejections=self.rejections)
+            nbytes = index["blocks_nbytes"] + index["non_block"]["file_nbytes"]
+            self.record.update(status="SAVED", save_s=round(time.monotonic() - started, 3), bytes=nbytes,
+                               construction_s=construction["construction_s"], pruned=index["pruned"])
+            print(f"[lf-studio] Stage1 snapshot saved to {self.dir} ({nbytes / 2**30:.1f} GiB in "
+                  f"{self.record['save_s']:.1f} s)", flush=True)
+        except SnapshotSkipped as error:
+            self.record.update(status="SKIPPED", reason=str(error))
+            print(f"[lf-studio] Stage1 snapshot not saved: {error}", flush=True)
+        except Exception as error:
+            self.record.update(status="SAVE_FAILED", error=f"{type(error).__name__}: {error}")
+            print(f"[lf-studio] Stage1 snapshot not saved ({type(error).__name__}: {error})", flush=True)
+            traceback.print_exc()
+        finally:
+            # the copies made for writing stay reserved in PyTorch's cache otherwise; a Ref2VA first clip ran out of
+            # GPU memory by about that much right after a save
+            import torch
+            if torch.cuda.is_available():
+                torch.cuda.empty_cache()
+
+
+def rejection_count(directory):
+    """How often snapshots in ``directory`` were rejected (its rejected.json; 0 without one)."""
+    try:
+        return int(json.loads((Path(directory) / REJECTED_FILE).read_text()).get("rejections", 1))
+    except FileNotFoundError:
+        return 0
+    except (OSError, ValueError, TypeError, AttributeError):
+        return 1
+
+
+def controller(state, task, pipe):
+    """The worker's Controller, or None when SOL_H3_STAGE1_SNAPSHOTS turns snapshots off (state records which)."""
+    from ..config import stage1_snapshots_dir
+    root = stage1_snapshots_dir()
+    if not root:
+        state["stage1_snapshot"] = {"status": "OFF"}
+        return None
+    if os.environ.get("SOL_H3_STAGE1_PIN", "1") == "0":
+        state["stage1_snapshot"] = {"status": "OFF", "reason": "SOL_H3_STAGE1_PIN=0"}
+        return None
+    raw = os.environ.get("SOL_H3_STAGE1_SNAPSHOTS_KEEP", "").strip() or "2"
+    if not raw.isdigit() or int(raw) < 1:
+        raise ValueError(f"SOL_H3_STAGE1_SNAPSHOTS_KEEP must be a whole number of at least 1, not {raw!r}")
+    keep = int(raw)
+    verify = os.environ.get("SOL_H3_STAGE1_SNAPSHOT_VERIFY", "1") != "0"
+    return Controller(state, task, pipe, root, verify=verify, keep=keep)
+
+
+# --------------------------------------------------------------------------- verification (tests/check_stage1_snapshot_gpu.py)
+
+def tensor_record(torch, t, base=None):
+    """dtype, shape, stride, device, pinned-ness, flags and the SHA-256 of a tensor's addressed bytes."""
+    nbytes = span_elements(t) * t.element_size()
+    raw = torch.empty(0, dtype=torch.uint8, device=t.device)
+    if nbytes:
+        raw.set_(t.untyped_storage(), t.storage_offset() * t.element_size(), (nbytes,), (1,))
