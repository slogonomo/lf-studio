+        reshaping = threading.Thread(target=run, args=("reshape", lambda: pipeline.reshape(seconds=15)))
+        reshaping.start()
+        self.assertTrue(closing_qwen.wait(5))
+        closing = threading.Thread(target=run, args=("close", pipeline.close))
+        closing.start()
+        for _ in range(500):
