+"""lf-studio: CPU tests of the fused LTX block file reader (runtime/stage2_ops/ltx_blocks.py).
+
+Part of lf-studio (Apache-2.0); not part of the upstream Sol-H3-RTX5090 package.
+"""
+import hashlib
+import os
+import json
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+
+import torch
+
+PACKAGE = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(PACKAGE))
+
+
+def _stub_ltx_core():
+    """ltx_core lives in the Stage2 environment; the source only needs alloc_buffer from it."""
+    if "ltx_core.block_streaming.utils" in sys.modules:
+        return
+    utils = types.ModuleType("ltx_core.block_streaming.utils")
+    utils.alloc_buffer = lambda nbytes, device, pin_memory: torch.empty(nbytes, dtype=torch.uint8)
+    for name in ("ltx_core", "ltx_core.block_streaming"):
+        sys.modules.setdefault(name, types.ModuleType(name))
+    sys.modules["ltx_core.block_streaming.utils"] = utils
+
+
+_stub_ltx_core()
+from runtime.stage2_ops import ltx_blocks  # noqa: E402
+
+
+def write_block_file(directory, sizes, seed=0):
+    generator = torch.Generator().manual_seed(seed)
+    blocks, images, offset = [], [], 0
+    with open(Path(directory) / "blocks.bin", "wb") as out:
+        for nbytes in sizes:
+            image = torch.zeros(ltx_blocks._ceil(nbytes), dtype=torch.uint8)
+            image[:nbytes] = torch.randint(0, 256, (nbytes,), dtype=torch.uint8, generator=generator)
+            data = image.numpy().tobytes()
+            out.write(data)
+            blocks.append({"offset": offset, "nbytes": nbytes, "file_nbytes": len(data),
+                           "sha256": hashlib.sha256(data[:nbytes]).hexdigest(),
+                           "layout": [["w", [nbytes // 2], "bfloat16"]]})
+            images.append(data[:nbytes])
+            offset += len(data)
+    index = {"format": ltx_blocks.FORMAT, "identity": {"test": True}, "blocks_prefix": "transformer_blocks",
+             "blocks_attr": "transformer_blocks", "num_blocks": len(sizes), "blocks": blocks}
+    (Path(directory) / "index.json").write_text(json.dumps(index))
+    return index, images
+
+
+class HybridSourceTests(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.sizes = [10000, 6000, 12288, 8190, 4096, 9000, 7002]
+        self.index, self.images = write_block_file(self.dir.name, self.sizes)
+
+    def run_passes(self, source, passes=3):
+        for _ in range(passes):
+            for idx in range(len(self.sizes)):
+                buf = source.get(idx)
+                self.assertEqual(bytes(buf[:self.sizes[idx]].numpy()), self.images[idx], idx)
+                self.assertEqual(source.block_layout(idx)["w"], (torch.Size([self.sizes[idx] // 2]), torch.bfloat16))
+                source.release(idx, None)
+
+    def test_every_block_comes_back_byte_exact_over_several_updates(self):
+        for resident in ([], [0, 1, 2], list(range(len(self.sizes)))):
+            for depth in (1, 2, 3, 5):
+                with self.subTest(resident=resident, depth=depth):
+                    source = ltx_blocks.HybridWeightSource(torch, self.dir.name, self.index, resident,
+                                                           depth=depth, verify=True)
+                    self.run_passes(source)
+                    streamed = len(self.sizes) - len(resident)
+                    self.assertEqual(source.stats["resident_blocks"], len(resident))
+                    self.assertEqual(source.stats["streamed_blocks"], streamed)
+                    # Each streamed block is read once per update, plus at most the read-ahead past the end.
+                    self.assertGreaterEqual(source.stats["streamed_reads"], 3 * streamed)
+                    self.assertLessEqual(source.stats["streamed_reads"], 3 * streamed + source.depth)
+                    source.cleanup()
+
+    def test_slots_are_reused_only_after_their_event(self):
+        events = []
+
+        class Event:
+            def __init__(self):
+                self.waited = False
+
+            def synchronize(self):
+                self.waited = True
+
+        source = ltx_blocks.HybridWeightSource(torch, self.dir.name, self.index, [0], depth=2)
+        for _ in range(2):
+            for idx in range(len(self.sizes)):
+                source.get(idx)
+                event = Event()
+                events.append((idx, event))
+                source.release(idx, event)
+        streamed_events = [e for idx, e in events if idx != 0]
+        # Every streamed slot was recycled at least once, and each recycle waited on the event first.
+        self.assertTrue(any(e.waited for e in streamed_events))
+        self.assertFalse(any(e.waited for idx, e in events if idx == 0))
+        source.cleanup()
+
+    def test_a_changed_block_is_refused(self):
+        path = Path(self.dir.name) / "blocks.bin"
+        data = bytearray(path.read_bytes())
+        data[self.index["blocks"][4]["offset"] + 10] ^= 0xFF
+        path.write_bytes(bytes(data))
+        source = ltx_blocks.HybridWeightSource(torch, self.dir.name, self.index, [0, 1], depth=2, verify=True)
+        with self.assertRaisesRegex(RuntimeError, "block 4 does not match"):
+            for idx in range(len(self.sizes)):
+                source.get(idx)
+                source.release(idx, None)
+        source.cleanup()
+
+    def test_index_identity_and_format_are_checked(self):
+        self.assertEqual(ltx_blocks.load_index(self.dir.name, {"test": True})["num_blocks"], len(self.sizes))
+        with self.assertRaisesRegex(RuntimeError, "built from other inputs"):
+            ltx_blocks.load_index(self.dir.name, {"test": False})
+        index = json.loads((Path(self.dir.name) / "index.json").read_text())
+        index["format"] = "other"
+        (Path(self.dir.name) / "index.json").write_text(json.dumps(index))
+        with self.assertRaisesRegex(RuntimeError, "not a"):
+            ltx_blocks.load_index(self.dir.name)
+
+
+
+
+class BudgetAndDefaultsTests(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.index, _ = write_block_file(self.dir.name, [8192, 8192, 8192, 8192])
+
+    def test_a_number_pins_that_many_first_blocks(self):
+        self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "2")), [0, 1])
+        self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "0")), [])
+        self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "99")), [0, 1, 2, 3])
+
+    def test_auto_pins_what_fits_after_the_reserve(self):
+        from unittest import mock
+        gib = 1 << 30
+        slots = 4 * 8192                    # read-ahead depth 3 + 1, each the largest block
+        with mock.patch.object(ltx_blocks, "available_bytes", return_value=gib + slots + 2 * 8192 + 100):
+            self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "auto", reserve_gib=1, depth=3)), [0, 1])
+        with mock.patch.object(ltx_blocks, "available_bytes", return_value=gib + 2 * 8192 + 100):
+            self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "auto", reserve_gib=1, depth=3)), [])
+        with mock.patch.object(ltx_blocks, "available_bytes", return_value=gib // 2):
+            self.assertEqual(list(ltx_blocks.resident_blocks(self.index, "auto", reserve_gib=1)), [])
+
+    def test_available_bytes_is_positive_and_at_most_memavailable(self):
+        from unittest import mock
+        fake = "MemTotal: 64000000 kB\nMemAvailable: 1048576 kB\n"
+        with mock.patch("builtins.open", mock.mock_open(read_data=fake)):
+            self.assertLessEqual(ltx_blocks.available_bytes(), 1 << 30)    # never more than MemAvailable
+        self.assertGreaterEqual(ltx_blocks.available_bytes(), 0)
+
+    def test_setting_defaults_follow_the_runtime_root(self):
+        from unittest import mock
+        from runtime import config
+        with mock.patch.dict("os.environ", {"SOL_H3_SPARK_RUNTIME_ROOT": "/r"}, clear=False):
+            for key in ("SOL_H3_FILEBACKED_DIR", "SOL_H3_LTX_BLOCKS"):
+                os.environ.pop(key, None)
+            self.assertEqual(config.stage1_scratch_dir(), "/r/scratch")
+            self.assertEqual(config.ltx_blocks_dir(), "/r/derived/ltx-fused-blocks")
+            os.environ["SOL_H3_FILEBACKED_DIR"] = "0"
+            os.environ["SOL_H3_LTX_BLOCKS"] = "off"
+            self.assertEqual(config.stage1_scratch_dir(), "")
+            self.assertEqual(config.ltx_blocks_dir(), "")
+            os.environ["SOL_H3_LTX_BLOCKS"] = "/elsewhere"
+            self.assertEqual(config.ltx_blocks_dir(), "/elsewhere")
+
+
+class StoreTests(unittest.TestCase):
+    """ensure(): one folder per identity, built under a lock into a temporary folder and renamed into place."""
+
+    def setUp(self):
+        from unittest import mock
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.root = Path(self.dir.name)
+        self.builds = []
+
+        def fake_build(prepared, output_dir, *, identity, torch, exist_ok=False):
+            self.builds.append(Path(output_dir))
+            write_block_file(output_dir, [4096, 8192])
+            index = json.loads((Path(output_dir) / "index.json").read_text())
+            index["identity"] = identity
+            (Path(output_dir) / "index.json").write_text(json.dumps(index))
+            return index
+        patcher = mock.patch.object(ltx_blocks, "build", fake_build)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_builds_once_then_reuses(self):
+        first, built = ltx_blocks.ensure(None, self.root, {"a": 1}, torch=torch, log=lambda *_: None)
+        again, built_again = ltx_blocks.ensure(None, self.root, {"a": 1}, torch=torch, log=lambda *_: None)
+        self.assertTrue(built)
+        self.assertFalse(built_again)
+        self.assertEqual(first, again)
+        self.assertEqual(len(self.builds), 1)
+        self.assertTrue(self.builds[0].name.startswith(".tmp-"))           # built aside, then renamed
+        self.assertFalse(any(p.name.startswith(".tmp-") for p in self.root.iterdir()))
+
+    def test_other_inputs_get_their_own_folder_and_old_ones_are_pruned(self):
+        folders = [ltx_blocks.ensure(None, self.root, {"a": i}, torch=torch, log=lambda *_: None)[0] for i in range(4)]
+        self.assertEqual(len(set(folders)), 4)
+        kept = sorted(p for p in self.root.iterdir() if p.is_dir())
+        self.assertEqual(len(kept), ltx_blocks.KEEP)
+        self.assertIn(folders[-1], kept)
+
+    def test_an_interrupted_build_is_cleaned_up_and_redone(self):
+        key = ltx_blocks._identity_key({"a": 1})
+        stale = self.root / f".tmp-{key}-999999999"           # no such process
+        stale.mkdir()
+        (stale / "blocks.bin").write_bytes(b"partial")
+        half = self.root / key                                 # a folder without index.json
+        half.mkdir()
+        (half / "blocks.bin").write_bytes(b"partial")
+        target, built = ltx_blocks.ensure(None, self.root, {"a": 1}, torch=torch, log=lambda *_: None)
+        self.assertTrue(built)
+        self.assertFalse(stale.exists())
+        self.assertTrue((target / "index.json").exists())
+
+    def test_the_flat_layout_of_earlier_versions_is_removed_after_a_build(self):
+        write_block_file(self.root, [4096])
+        ltx_blocks.ensure(None, self.root, {"a": 1}, torch=torch, log=lambda *_: None)
+        self.assertFalse((self.root / "blocks.bin").exists())
+        self.assertFalse((self.root / "index.json").exists())
+
+    def test_a_folder_with_foreign_files_is_left_alone(self):
+        odd = self.root / "mine"
+        odd.mkdir()
+        (odd / "notes.txt").write_text("keep")
+        ltx_blocks._remove_known(odd)
+        self.assertTrue((odd / "notes.txt").exists())
+
+    def test_bad_settings_name_themselves(self):
+        from unittest import mock
+        with mock.patch.dict("os.environ", {"SOL_H3_LTX_READ_AHEAD": "x"}):
+            with self.assertRaisesRegex(RuntimeError, "SOL_H3_LTX_READ_AHEAD"):
+                ltx_blocks.setting_int("SOL_H3_LTX_READ_AHEAD", 3, minimum=1)
+        with mock.patch.dict("os.environ", {"SOL_H3_LTX_READ_AHEAD": "0"}):
+            with self.assertRaisesRegex(RuntimeError, "at least 1"):
+                ltx_blocks.setting_int("SOL_H3_LTX_READ_AHEAD", 3, minimum=1)
+        with self.assertRaisesRegex(RuntimeError, "auto or a whole number"):
+            ltx_blocks.resident_blocks({"num_blocks": 2, "blocks": []}, "lots")
+
+
+if __name__ == "__main__":
+    unittest.main()
