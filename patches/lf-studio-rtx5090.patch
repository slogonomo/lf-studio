+                    closing_qwen.set()
+                    closed.wait(10)
+                super().close()
+        pipeline = Pipeline({}, Path(self.directory.name) / "slow-close", offload_mode="none", worker_factory=SlowClose)
+        self.addCleanup(pipeline.close)
+        self.addCleanup(closed.set)
