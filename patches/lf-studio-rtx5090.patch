+class HybridWeightSource:
+    """LTX ``WeightSource``: blocks in ``resident`` stay pinned in RAM, the others are read ahead from disk.
+
+    ``get(idx)`` returns one contiguous pinned uint8 buffer carved by the block's layout, as LTX's pinned and
+    disk sources do. Streamed blocks go through ``slots`` pinned slots; after a block is handed out, the next
+    ``depth`` streamed blocks (in forward order, wrapping to the next update) are read in the background.
+    """
+
+    def __init__(self, torch, directory, index, resident, *, depth=3, threads=READ_THREADS, verify=False):
+        from ltx_core.block_streaming.utils import alloc_buffer
+        self.torch = torch
