+            root = Path(directory) / "new-root"
+            with patch.object(snapshot, "set_nocow", side_effect=lambda path: seen.append(
+                    (Path(path).name, sorted(p.name for p in Path(path).iterdir()))) or True):
+                index = snapshot.write_snapshot(root, "t2va-0123456789abcdef", identity={"task": "t2va"},
+                                                blocks=pinned, non_block=snapshot.non_block_items(model),
+                                                structure={}, construction={})
+        self.assertEqual(seen, [("new-root", []), (".t2va-0123456789abcdef.tmp-" + str(os.getpid()), [])])
+        self.assertTrue(index["nocow"])
