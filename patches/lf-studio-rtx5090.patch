+# --------------------------------------------------------------------------- a tiny H3 for the lookup and FP8
+
+class Scheduler:
+    def __init__(self, shift, timesteps):
+        self.shift, self.values = shift, timesteps
+
+    def set_timesteps(self, steps, device="cpu"):
+        self.timesteps = torch.tensor(self.values)
+
+
+class Pipe:
+    def __init__(self):
+        self.modules = {"scheduler": Scheduler(12.0, VIDEO), "audio_scheduler": Scheduler(3.0, AUDIO)}
+        self.lora_nickname, self.lora_path, self.lora_strength = "default", "/loras/vsa.safetensors", 1.0
+        self.cur_adapter_name, self.cur_adapter_path, self.cur_adapter_strength = "", "", 1.0
+        self.lora_adapter_paths, self.lora_layers, self.lora_adapters = {}, {}, {}
+
+    def _convert_one_transformer(self, name, module):
+        raise AssertionError("a restored model must not be converted to LoRA layers")
+
+    def _apply_constructor_adapter(self, *, mapping_transformer=None):
+        raise AssertionError("a restored model must not load its LoRA")
+
+
+def h3_classes():
+    from fastvideo.layers.linear import ReplicatedLinear
+
+    def linear(i, o, bias=False, dtype=None):
+        return ReplicatedLinear(i, o, bias=bias, params_dtype=dtype, quant_config=None, prefix="")
+
+    class Modulation(torch.nn.Module):
+        def __init__(self, out):
+            super().__init__()
+            self.linear = linear(T, out, bias=True)
+            self.apply_silu = True
+
+    class Attention(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.to_q, self.to_k, self.to_v, self.to_out = (linear(H, H) for _ in range(4))
+            self.norm_q = torch.nn.RMSNorm(H)
+
+    class FeedForward(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.fc_in, self.fc_out = linear(H, 2 * H), linear(2 * H, H)
+
+    class Block(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.adaln_proj = Modulation(3 * H)
+            self.attn, self.ff = Attention(), FeedForward()
+
+    class TimeProj(torch.nn.Module):
+        def forward(self, t):
+            return torch.stack([t / 1000 * (k + 1) for k in range(F_DIM)], dim=-1).sin()
+
+    class TimeEmbedder(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.fc_in = linear(F_DIM, T, bias=True)
+
+        def forward(self, x):
+            return self.fc_in(x)[0]
+
+    class TextBlock(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.attn, self.ff = Attention(), FeedForward()
+
+    class MiniMaxH3Transformer3DModel(torch.nn.Module):      # the name the Controller expects
+        # H3's dtype rule: the constructor makes every linear in the default dtype (params_dtype=None), FastVideo's
+        # loader then assigns these modules' tensors in FP32 (_get_parameter_dtype)
+        _keep_in_fp32_modules = frozenset({"proj_in", "time_embedder"})
+
+        def __init__(self, config=None, hf_config=None):
+            super().__init__()
+            self.adaln_basis = None
+            self.proj_in = linear(4, H, bias=True)
+            self.time_proj, self.time_embedder = TimeProj(), TimeEmbedder()
+            self.token_refiner = torch.nn.Module()
+            self.token_refiner.refiner_blocks = torch.nn.ModuleList([TextBlock() for _ in range(2)])
+            self.transformer_blocks = torch.nn.ModuleList([Block() for _ in range(50)])
+            self.norm_out = Modulation(2 * H)
+            self.register_buffer("inv_freq", torch.arange(4, dtype=torch.float32), persistent=False)
+
+        def _get_parameter_dtype(self, name, default_dtype):
+            return torch.float32 if name.split(".", 1)[0] in self._keep_in_fp32_modules else default_dtype
+
+    return MiniMaxH3Transformer3DModel
+
+
+def build_like_the_loader(model_cls, init=None):
+    """Construct under BF16 default dtype, then fresh Parameters without attributes (load_state_dict(assign=True))
+    in the loader's dtype (the model's _get_parameter_dtype) and requires_grad off, as FastVideo's loader leaves
+    them; eval() as TransformerLoader does."""
+    from fastvideo.models.loader.fsdp_load import set_default_dtype
+    with set_default_dtype(torch.bfloat16):
+        model = model_cls(**init) if init is not None else model_cls(None, {"layers": 50})
+    generator = torch.Generator().manual_seed(3)
+    for name, param in list(model.named_parameters()):
+        owner, leaf = snapshot._owner(model, name)
+        owner._parameters[leaf] = torch.nn.Parameter(
+            (torch.randn(param.shape, generator=generator) * 0.1).to(snapshot.loader_dtype(model, name,
+                                                                                            torch.bfloat16)),
+            requires_grad=False)
+    model.eval()
+    return model
+
+
+def normal_build(model_cls, task="t2va", init=None):
+    """The steps of stage1.quantize_after_merge on CPU: lookup, FP8 tagging and conversion, pinning."""
+    from fastvideo.layers.quantization.fp8_config import convert_model_to_fp8
+    model = build_like_the_loader(model_cls, init)
+    state = {"fp8_route": "native_FastVideo_tensorwise_W8A8_after_original_BF16_LoRA_merge"}
+    pipe = Pipe()
+    state["fixed_lookup"] = lookup.install_exact_t2va_lookup(model, pipe, task=task)
+    tagged = lookup.tag_fp8_linears(model)
+    with torch.no_grad():
+        convert_model_to_fp8(model)
+    state.update(merged_lora_layers=7, fp8_linears=len(tagged), fp8_linear_names=tagged,
+                 fp8_weight_bytes=sum(m._fp8_weight.numel() for m in model.modules() if hasattr(m, "_fp8_weight")),
+                 offload={"mode": "cpu", "blocks": 50, "block_loads": 200})
+    model.reverse_param_names_mapping = {"proj_in.weight": ("proj_in.weight", None, None)}
+    pipe.cur_adapter_name, pipe.cur_adapter_path = pipe.lora_nickname, pipe.lora_path
+    pipe.lora_adapter_paths[pipe.lora_nickname] = pipe.lora_path
+    return model, state, pipe, pin_model(model)
+
+
+class LookupStructureTests(unittest.TestCase):
+    """The computed lookup (install_exact_t2va_lookup) and the rebuilt one (rebuild_exact_lookup) are the same
+    structure; with the computed tensors in it, the rebuilt one gives the same outputs."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.model_cls = h3_classes()
+
+    def check(self, task):
+        model = build_like_the_loader(self.model_cls)
+        record = lookup.install_exact_t2va_lookup(model, Pipe(), task=task)
+        self.assertEqual(len(record["verification"]), 51)
+        saved = json.loads(json.dumps(record))
+        twin = build_like_the_loader(self.model_cls)
+        specs = {name: (tuple(t.shape), t.dtype) for name, t in model.named_buffers()}
+        bound = lookup.rebuild_exact_lookup(twin, saved, specs, torch.device("meta"))
+        self.assertIs(twin.time_proj.record, bound)
