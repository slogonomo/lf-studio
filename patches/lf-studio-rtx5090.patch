+def vsa_record(shape):
+    """The official_vsa record install_model makes, with the counters of no request yet."""
+    record = {key: 0 for key in vsa.COUNTERS}
+    record.update(active_compression_gates=50, selected_attention_backend="cudnn_bsa",
+                  warmup_reference_from=0, bsa_check_shape=list(shape), bsa_checked_shapes=[],
+                  layer_calls=[0] * 50, step_calls=[0] * 4, observed_metadata={},
+                  warmup_selected_validation={"status": "PENDING", "passed_calls": 0, "max_abs": 0.0,
+                                              "max_relative_l2": 0.0, "per_call": []},
+                  bsa_index_order={"match_triton_order": True, "metadata_reorder_calls": 0},
+                  bandwidth_optimization={"enabled": True, "bshd_selected_calls": 0, "fused_merge_calls": 0,
+                                          "warmup_layout_copies": 0})
+    return record
+
+
+def run_request(record):
+    """The counters one real request adds, with the BSA bookkeeping of counted_sparse (reference_due/passed)."""
+    for _ in range(200):
+        due = vsa.reference_due(record)
+        record["cudnn_bsa_calls"] += 1
+        if due:
+            record["warmup_reference_calls"] += 1
+            record["bandwidth_optimization"]["warmup_layout_copies"] += 4
+            vsa.reference_passed(record)
+    for key in ("vsa_forward_calls", "compression_branch_calls", "block_mask_calls"):
+        record[key] += 200
+    record["dense_text_calls"] += 2
+    record["layer_calls"] = [calls + 4 for calls in record["layer_calls"]]
+    record["step_calls"] = [calls + 50 for calls in record["step_calls"]]
+    record["bsa_index_order"]["metadata_reorder_calls"] += 200
+    for key in ("bshd_selected_calls", "fused_merge_calls"):
+        record["bandwidth_optimization"][key] += 200
+
