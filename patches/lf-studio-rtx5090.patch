+        self.assertIsNone(built.restore(self.loader, (), dict(self.kwargs)))
+        self.assertEqual(state["stage1_snapshot"]["status"], "BUILD_AND_SAVE")
+        manager = type("Manager", (), {"states": [type("S", (), {"pinned": p})() for p in pinned]})()
+        built.save(model, manager)
