+def configure_dynamo(config):
+    """lf-studio: Dynamo settings of the Stage1 worker (torch._dynamo.config).
+
+    Every new prompt length (text tokens) recompiles the fullgraph DiT regions; FastVideo caps recompiles at 16
+    (layers/lora/linear.py), so a long-lived web-UI session died after ~4 distinct prompt lengths ('Dynamo recompile
+    limit exceeded'). Allow many shapes. SOL_H3_DYNAMIC_TEXT_LENGTH (on by default; runtime/config.py) compiles the 50
+    body regions for any length instead (2 graphs per session, none per new length; stage1_ops/regional.py). With
+    SOL_H3_DYNAMIC_TEXT_LENGTH=0, and on the Ref2VA Sol route, each new length still costs ~8-10 s once.
+    Static shapes (runtime/config.py compile_dynamic): what torch.compile(dynamic=False) sets, for every compile in
+    this worker (the 52 regions of each task). A graph compiled after a shape change (prompt length, clip length,
+    orientation) is then static, the graph a fresh worker compiles for that shape, not one with dynamic sizes and
+    possibly other kernels. Dimensions marked dynamic explicitly stay dynamic (Dynamo honours a mark without
+    automatic dynamic shapes): with both settings on, the body regions keep their 2 graphs per session, and the two
+    text-refiner regions compile once per prompt length instead of once more at a session's second length.
+    """
+    config.recompile_limit = max(config.recompile_limit, 1024)
+    config.accumulated_recompile_limit = max(config.accumulated_recompile_limit, 65536)
+    if compile_dynamic() is False:
+        config.automatic_dynamic_shapes = False
+
