+# lf-studio: under CPU offload (the RTX 5090 default) each phase module goes to the GPU only for its call
+class Placed:
+    """A module stub that logs its moves and, when called, where it was."""
+    def __init__(self, name, log, result=None):
+        self.name, self.log, self.result, self.where = name, log, result, "cpu"
+    def to(self, device):
+        self.where = str(device)
+        self.log.append((self.name, "to", self.where))
+        return self
+    def cpu(self):
+        self.where = "cpu"
+        self.log.append((self.name, "cpu"))
+        return self
+    def __call__(self, *args, **kwargs):
+        self.log.append((self.name, "call", self.where))
+        return self.result(*args, **kwargs) if callable(self.result) else self.result
