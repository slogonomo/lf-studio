+def shared_module_globals(source_frames, output_frames):
+    """The shape globals of super_acceleration/stage2/refiner_encoder_ablation_single_gpu.py as its import computes
+    them: its module-level assignments from WIDTH to TARGET_LATENT_SHAPE, run with the frame counts in the env."""
+    tree = ast.parse(SHARED_STAGE2.read_text())
+    names = [getattr(node.targets[0], "id", None) if isinstance(node, ast.Assign) else None for node in tree.body]
+    first, last = names.index("WIDTH"), names.index("TARGET_LATENT_SHAPE")
+    namespace = {"os": SimpleNamespace(environ={"H3_LTX_SOURCE_FRAMES": str(source_frames),
+                                                "H3_LTX_OUTPUT_FRAMES": str(output_frames)})}
+    exec(compile(ast.Module(body=tree.body[first:last + 1], type_ignores=[]), str(SHARED_STAGE2), "exec"), namespace)
+    return {name: namespace[name] for name in models.SHAPE_GLOBALS}
