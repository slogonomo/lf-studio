+class NoCowTests(unittest.TestCase):
+    def test_set_nocow(self):
+        import errno
+        import fcntl
+        with tempfile.TemporaryDirectory() as directory:
+            self.assertIn(snapshot.set_nocow(directory), (True, None))      # tmpfs/ext4: None; btrfs: True
+            calls = []
+
+            def ioctl(fd, request, flags, mutate=True):
+                calls.append((request, flags[0]))
+                if request == snapshot.FS_IOC_GETFLAGS:
+                    flags[0] = 0x10
+                return 0
+            with patch.object(fcntl, "ioctl", ioctl):
+                self.assertTrue(snapshot.set_nocow(directory))
+            self.assertEqual(calls[-1], (snapshot.FS_IOC_SETFLAGS, 0x10 | snapshot.FS_NOCOW_FL))
+
+            def unsupported(*args):
+                raise OSError(errno.ENOTTY, "no flags here")
+            with patch.object(fcntl, "ioctl", unsupported):
+                self.assertIsNone(snapshot.set_nocow(directory))
+
+            def denied(*args):
+                raise OSError(errno.EPERM, "not allowed")
+            with patch.object(fcntl, "ioctl", denied):
+                self.assertFalse(snapshot.set_nocow(directory))
+
+    def test_write_sets_it_on_the_empty_folder_first(self):
