+        self.resident = sorted(set(resident))
+        self.streamed = [i for i in range(self.num_blocks) if i not in set(self.resident)]
+        self.file = DirectFile(Path(directory) / "blocks.bin", threads=threads)
+        self.slot_file_nbytes = max(b["file_nbytes"] for b in index["blocks"])
+        self.stats = {"resident_blocks": len(self.resident), "streamed_blocks": len(self.streamed),
+                      "streamed_reads": 0, "read_bytes": 0, "read_wait_s": 0.0, "resident_bytes": 0}
+        t0 = time.monotonic()
+        self.pinned = {}
+        for idx in self.resident:
+            block = index["blocks"][idx]
+            buf = alloc_buffer(block["file_nbytes"] + ALIGN, torch.device("cpu"), pin_memory=True)
+            buf = buf[(-buf.data_ptr()) % ALIGN:][:block["file_nbytes"]]
+            self.file.read(buf, block["offset"], block["file_nbytes"])
+            if verify:
+                self._check(idx, buf)
+            self.pinned[idx] = buf
+            self.stats["resident_bytes"] += block["file_nbytes"]
+        self.stats["resident_load_s"] = time.monotonic() - t0
+        self.depth = min(depth, len(self.streamed))
+        count = self.depth + 1 if self.streamed else 0
+        raw = alloc_buffer(count * self.slot_file_nbytes + ALIGN, torch.device("cpu"), pin_memory=True) if count else None
+        if raw is not None:
+            raw = raw[(-raw.data_ptr()) % ALIGN:]
+        self.free = [raw[i * self.slot_file_nbytes:(i + 1) * self.slot_file_nbytes] for i in range(count)]
+        self.events = {}
+        self.scheduled = {}       # idx -> (slot, futures)
+        self.in_use = {}          # idx -> slot
+        self.lock = threading.Lock()
+        self.verify = verify
+
+    def _check(self, idx, buf):
+        block = self.index["blocks"][idx]
+        digest = hashlib.sha256(_view(buf, block["nbytes"])).hexdigest()
+        if digest != block["sha256"]:
+            raise RuntimeError(f"LTX fused block {idx} does not match its recorded SHA-256")
+
+    # WeightSource protocol
+    def block_layout(self, idx):
+        return self.layouts[idx]
+
+    @property
+    def slot_nbytes(self):
+        return self.slot_file_nbytes
+
+    def get(self, idx):
+        if idx in self.pinned:
+            self._ahead(idx)
+            return self.pinned[idx]
+        if idx in self.in_use:
+            raise RuntimeError(f"LTX block {idx} is already in flight")
+        entry = self.scheduled.pop(idx, None) or self._schedule(idx)
+        slot, futures = entry
+        t0 = time.monotonic()
+        for future in futures:
+            future.result()
+        self.stats["read_wait_s"] += time.monotonic() - t0
+        if self.verify:
+            self._check(idx, slot)
+        self.in_use[idx] = slot
+        self._ahead(idx)
+        return slot
+
+    def release(self, idx, event):
+        slot = self.in_use.pop(idx, None)
+        if slot is None:
+            return                      # resident block
+        if event is not None:
+            self.events[id(slot)] = event
+        self.free.append(slot)
+
+    def cleanup(self):
+        for slot, futures in self.scheduled.values():
+            for future in futures:
+                future.result()
+        self.scheduled.clear()
+        self.in_use.clear()
+        self.pinned.clear()
+        self.free = []
+        self.file.close()
+
+    # read-ahead
+    def _acquire(self):
+        slot = self.free.pop(0)
+        event = self.events.pop(id(slot), None)
+        if event is not None:
+            event.synchronize()
+        return slot
+
+    def _schedule(self, idx):
+        block = self.index["blocks"][idx]
+        slot = self._acquire()
+        self.stats["streamed_reads"] += 1
+        self.stats["read_bytes"] += block["file_nbytes"]
+        return slot, self.file.read_into(slot, block["offset"], block["file_nbytes"])
+
+    def _ahead(self, idx):
+        if not self.streamed:
+            return
+        n = self.num_blocks
+        wanted = []
+        step = 1
+        while len(wanted) < self.depth and step <= n:
+            j = (idx + step) % n
+            if j not in self.pinned:
+                wanted.append(j)
+            step += 1
+        for j in wanted:
+            if j in self.scheduled or j in self.in_use:
+                continue
+            if not self.free:
+                break
+            self.scheduled[j] = self._schedule(j)
+
