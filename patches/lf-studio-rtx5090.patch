+from runtime.stage1_ops import lookup, snapshot  # noqa: E402
+
+VIDEO, AUDIO = [0.0, 900.0, 600.0, 300.0], [0.0, 800.0, 500.0, 200.0]
+H, T, F_DIM = 8, 6, 4
