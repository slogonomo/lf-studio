+        self.assertTrue(restored.norm_out.linear.training)          # created after eval() in the build, too
+
+        # A changed byte: the restore is refused, the build runs, and its save replaces the snapshot.
+        directory = Path(fresh["stage1_snapshot"]["dir"])
+        with open(directory / snapshot.BLOCKS_FILE, "r+b") as stream:
+            stream.write(b"\x00\x01\x02\x03")
+        third = {key: value for key, value in state.items() if key != "stage1_snapshot"}
+        corrupt = snapshot.Controller(third, "t2va", Pipe(), self.root)
+        with patch("traceback.print_exc"):
+            self.assertIsNone(corrupt.restore(self.loader, (), dict(self.kwargs)))
+        self.assertEqual(third["stage1_snapshot"]["status"], "RESTORE_FAILED")
+        self.assertTrue(third["stage1_snapshot"]["replaced_after_build"])
+        corrupt.save(model, manager)
+        self.assertEqual(third["stage1_snapshot"]["status"], "SAVED")
+        again = snapshot.Controller({}, "t2va", Pipe(), self.root)
+        self.assertIsNotNone(again.restore(self.loader, (), dict(self.kwargs)))
+
+        # A restored model whose loader then fails for another reason keeps its snapshot; a failure the snapshot
+        # causes (SnapshotError) retires it, and the next build replaces it.
+        from fastvideo.pipelines.lazy_module import LazyModule
+
+        def failing_loader(error):
+            def load():
+                raise error
+            return load
+        lazy = LazyModule("transformer", failing_loader(ValueError("loader failed after the restore")))
+        again.guard_loader(lazy)
+        with patch("builtins.print"), self.assertRaises(ValueError):
+            lazy.materialize()
+        self.assertTrue((directory / snapshot.INDEX_FILE).exists())
+        self.assertIn("failed_after_restore", again.record)
+        lazy = LazyModule("transformer", failing_loader(snapshot.SnapshotMismatch("does not fit")))
+        again.guard_loader(lazy)
+        with patch("builtins.print"), self.assertRaises(snapshot.SnapshotMismatch):
+            lazy.materialize()
+        self.assertEqual(again.record["status"], "REJECTED")
+        self.assertEqual(sorted(p.name for p in directory.iterdir()), [snapshot.REJECTED_FILE])   # data removed
+        fourth = {key: value for key, value in state.items() if key != "stage1_snapshot"}
+        rebuild = snapshot.Controller(fourth, "t2va", Pipe(), self.root)
+        self.assertIsNone(rebuild.restore(self.loader, (), dict(self.kwargs)))
+        self.assertEqual(fourth["stage1_snapshot"]["status"], "BUILD_AND_SAVE")
+        rebuild.save(model, manager)
+        self.assertEqual(fourth["stage1_snapshot"]["status"], "SAVED")
+        self.assertEqual(sorted(p.name for p in directory.iterdir()),
+                         sorted([snapshot.BLOCKS_FILE, snapshot.NON_BLOCK_FILE, snapshot.INDEX_FILE]))
+        self.assertEqual(json.loads((directory / snapshot.INDEX_FILE).read_text())["rejections"], 1)
