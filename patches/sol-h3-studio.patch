+"""sol-h3-studio: CPU tests of the derived portrait / clip-length geometry (not part of upstream Sol-H3-Spark)."""
+import unittest
+
+from runtime import geometry
+from runtime.config import load_recipe
+
+
+class GeometryTests(unittest.TestCase):
+    def test_default_is_frozen_landscape(self):
+        shape = geometry.from_recipe(load_recipe(orientation="landscape"))
+        self.assertEqual((shape["draft_height"], shape["draft_width"]), (384, 672))
+        self.assertEqual(shape["h3"], (1, 24, 37, 24, 42))
+        self.assertEqual(shape["h3_upscaled"], (1, 24, 37, 48, 84))
+        self.assertEqual(shape["refiner_input"], (1, 128, 16, 24, 42))
+        self.assertEqual(shape, geometry.from_recipe())
+
+    def test_portrait_is_derived_after_the_hash_check(self):
+        for task in ("t2va", "fl2va", "ref2va"):
+            recipe = load_recipe(task, orientation="portrait")
+            self.assertEqual((recipe["stage1"]["width"], recipe["stage1"]["height"]), (384, 672))
+            self.assertEqual((recipe["output"]["width"], recipe["output"]["height"]), (768, 1344))
+            self.assertEqual(recipe["handoff"]["refiner_input_shape"], [1, 128, 16, 42, 24])
+            if task == "ref2va":
+                self.assertEqual(recipe["stage1"]["reference_image_resize"]["pixel_budget"], 384 * 672)
+            shape = geometry.from_recipe(recipe)
+            self.assertEqual(shape["h3"], (1, 24, 37, 42, 24))
+            self.assertEqual(shape["adapter_output"], (1, 128, 17, 42, 24))
+            self.assertEqual(shape["tiles"]["height"], {"tile_size": 768, "overlap": 64})
+            self.assertEqual(shape["tiles"]["width"], {"tile_size": 448, "overlap": 64})
+        self.assertNotIn("orientation", load_recipe())
+        with self.assertRaises(ValueError):
+            load_recipe(orientation="square")
+
+
+if __name__ == "__main__":
+    unittest.main()
