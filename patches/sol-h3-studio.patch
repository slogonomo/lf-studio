+# sol-h3-studio: Stage-2 audio policy (SOL_H3_STAGE2_AUDIO)
+@dataclass(frozen=True)
+class AudioState:
+    """The fields of ltx_core.types.LatentState that the policy reads or replaces."""
+    latent: object
+    denoise_mask: object
+    clean_latent: object
+    positions: object = "positions"
+    frozen: bool = False
+
+
+class Named:
+    def __init__(self, name):
+        self.name = name
+    def clone(self):
+        return Named(self.name + ".clone")
+
+
+ZEROS = SimpleNamespace(zeros_like=lambda value: Named(f"zeros_like({value.name})"))
+
+
+class Stage2AudioPolicyTests(unittest.TestCase):
+    def refiner(self, mode, calls):
+        class Upstream:
+            def prepare_multimodal_states(self, video_latent, audio_latent, conditionings, seed):
+                calls.append((video_latent, audio_latent, conditionings, seed))
+                return "video_state", AudioState(Named("noised"), Named("ones"), Named("clean")), "generator"
+        session = SimpleNamespace(torch=ZEROS, stage2_audio=mode)
+        cls = stage2._refiner_class(SimpleNamespace(), SimpleNamespace(OfficialCompatRefiner=Upstream), session)
+        return object.__new__(cls)
+
+    def test_frozen_audio_is_the_clean_h3_audio_and_the_video_is_untouched(self):
+        calls = []
+        video, audio, generator = self.refiner("frozen", calls).prepare_multimodal_states("v", "a", ["c"], 7)
+        self.assertEqual(calls, [("v", "a", ["c"], 7)])     # upstream ran once: same random draws, same video noise
+        self.assertEqual((video, generator), ("video_state", "generator"))
+        self.assertTrue(audio.frozen)
+        self.assertEqual(audio.latent.name, "clean.clone")
+        self.assertEqual(audio.denoise_mask.name, "zeros_like(ones)")
+        self.assertEqual((audio.clean_latent.name, audio.positions), ("clean", "positions"))
+
+    def test_joint_is_upstream(self):
+        calls = []
+        video, audio, generator = self.refiner("joint", calls).prepare_multimodal_states("v", "a", [], 7)
+        self.assertEqual(len(calls), 1)
+        self.assertEqual((video, generator, audio.latent.name, audio.frozen), ("video_state", "generator", "noised", False))
+
+    def test_setting(self):
+        with patch.dict(os.environ):
+            os.environ.pop("SOL_H3_STAGE2_AUDIO", None)
+            self.assertEqual(stage2.stage2_audio_mode(), "frozen")
+            for value, mode in (("", "frozen"), (" frozen ", "frozen"), ("joint", "joint"), ("JOINT", "joint")):
+                os.environ["SOL_H3_STAGE2_AUDIO"] = value
+                self.assertEqual(stage2.stage2_audio_mode(), mode)
+            os.environ["SOL_H3_STAGE2_AUDIO"] = "noised"
+            with self.assertRaisesRegex(ValueError, "SOL_H3_STAGE2_AUDIO.*'noised'"):
+                stage2.stage2_audio_mode()
+
+    def test_fails_closed_without_frozen_states(self):
+        @dataclass
+        class OlderState:
+            latent: object
+            denoise_mask: object
+            clean_latent: object
+        with self.assertRaisesRegex(RuntimeError, "SOL_H3_STAGE2_AUDIO=joint"):
+            stage2.frozen_audio_state(OlderState(Named("l"), Named("m"), Named("c")), ZEROS)
+        with self.assertRaisesRegex(RuntimeError, "SOL_H3_STAGE2_AUDIO=joint"):
+            stage2.check_frozen_states(OlderState)          # what Stage 2 checks at start, on the LatentState type
+        stage2.check_frozen_states(AudioState)
+
