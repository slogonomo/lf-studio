+        graphs = []
+        with torch.no_grad():
+            for text, want in zip(lengths, expected):
+                got = run_request(model, text)
+                graphs.append((blocks.graphs, refiners.graphs))
+                self.assertTrue(all(torch.equal(a, b) for a, b in zip(got, want)), f"text length {text}")
+        self.assertEqual(graphs, [(1, 1), (1, 2), (1, 2)])
+
+    def test_wrapper_refuses_other_fastvideo_signatures(self):
+        def block_forward(self, hidden_states, temb, adaln_indices, rotary_emb):
+            return hidden_states
+
+        def attention_forward(self, q, k, v, gate_compress, original_seq_len):
+            return q
+        for cls, forward in ((Block, block_forward), (Attention, attention_forward)):
+            with patch.object(cls, "forward", forward), self.assertRaisesRegex(RuntimeError, "signature"):
+                regional.mark_length_dynamic(torch, Model(), forward_context)
+
+
+if __name__ == "__main__":
+    unittest.main()
