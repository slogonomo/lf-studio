+"""Decode the next frames while the H.264 encoder works: same frames, same order, same encoder settings.
+
+Part of sol-h3-studio (Apache-2.0). Switch: SOL_H3_DECODE_AHEAD (runtime/config.py; "0" = LTX-2's own order).
+
+Stage 2 streams LTX-2's tiled VAE decoder (ConvVideoDecoder.tiled_decode) into LTX-2's encode_video. Two things kept
+the GPU and the CPU encoder from working at the same time:
+
+1. encode_video hands frames to its libx264 thread through a one-slot queue, and the writer feeds it 16-frame
+   views. A decoder chunk is 96-104 frames, so the decoder waited until the encoder had taken all but two views of a
+   chunk before it decoded the next one. encoder_queue() gives that queue room for one decoder chunk of views.
+2. tiled_decode yields temporal chunk k only after it has decoded group k+1, though chunk k's frames are final
+   after group k (group k+1 only adds into the overlap, which chunk k does not include). install_eager_decode()
+   makes LTX-2's own generator yield each chunk before it decodes the next group (see HeadMarker).
+
+The decoder still runs on the calling thread and the current CUDA stream. The colour conversion and the copies to
+the CPU still happen there, and encode_video gets the same frames in the same order with the same libx264 settings
+and thread count. The queue holds converted CPU frames (I420, ~25 MB per view at 1344x768), one decoder chunk.
+No LTX-2 code is copied here; the hooks wrap it and check its source hashes.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import hashlib
+import inspect
+import queue
+import sys
+import threading
+import time
+
+VIEW_FRAMES = 16
+# sha256 of inspect.getsource() of the LTX-2 methods whose behaviour install_eager_decode relies on, at LTX-2 d151147
+# (ltx_core/model/video_vae/conv_video_decoder.py). Another version keeps LTX-2's own order.
+LTX2_SOURCE_SHA256 = {
+    "tiled_decode": "5f07b52e8b2ecf7f408e51ddc28fe96f3cd3dc77a93b44735e3457497c4e8d56",
+    "_accumulate_temporal_group_into_buffer": "25ed27e2d453b078636d69097620d7ba2215b83154fd380ee2a4fdd0689ad86b",
+}
+
+
+def queue_views(tile_frames, view_frames=VIEW_FRAMES):
+    """Room for one decoder chunk: every chunk but the last (which no decode follows) is shorter than a tile."""
+    return max(1, -(-int(tile_frames) // view_frames))
+
+
+class TimedQueue(queue.Queue):
+    """queue.Queue that records how long put() waited for room (the decoder held back by the encoder) and get()
+    waited for an item (the encoder held back by the decoder). One producer and one consumer thread; each touches
+    only its own counters, and they are read after both are done."""
+
+    def __init__(self, maxsize=0):
+        super().__init__(maxsize)
+        self.items = self.max_queued = self.put_wait_ns = self.get_wait_ns = 0
+        self.first_get_ns = self.end_taken_ns = None
+
+    def put(self, item, block=True, timeout=None):
+        started = time.monotonic_ns()
+        super().put(item, block, timeout)
+        self.put_wait_ns += time.monotonic_ns() - started
+        if item is not None:
+            self.items += 1
+        self.max_queued = max(self.max_queued, self.qsize())
+
+    def get(self, block=True, timeout=None):
+        started = time.monotonic_ns()
+        if self.first_get_ns is None:
+            self.first_get_ns = started
+        item = super().get(block, timeout)
+        taken = time.monotonic_ns()
+        self.get_wait_ns += taken - started
+        if item is None:                     # encode_video's end-of-stream marker: every frame has reached libx264
+            self.end_taken_ns = taken
+        return item
+
+    def receipt(self):
+        return {"views_passed": self.items, "max_queued_views": self.max_queued,
+                "decoder_blocked_s": self.put_wait_ns / 1e9, "encoder_waited_s": self.get_wait_ns / 1e9,
+                "encoder_started_monotonic_ns": self.first_get_ns,
+                "frames_to_encoder_monotonic_ns": self.end_taken_ns}
+
+
+_QUEUE_HOOK = threading.Lock()
+
+
+@contextmanager
+def encoder_queue(module, views, receipt):
+    """While active, LTX-2's encode module (ltx_pipelines.utils.media_io.encode) builds the queue to its libx264
+    thread as a TimedQueue with room for `views` views (LTX-2: 1; views=1 keeps that and only measures).
+
+    The module looks up its global Queue when it builds the queue, so only calls inside this block are affected.
+    Nothing is hooked, and the receipt says so, if the module does not use queue.Queue or another call holds the
+    hook. receipt["encoder_queue"] gets the queue's counters.
+    """
+    if (getattr(module, "Queue", None) is not queue.Queue or not hasattr(module, "_encode_chunks_threaded")
+            or not _QUEUE_HOOK.acquire(blocking=False)):
+        receipt["encoder_queue"] = {"hooked": False, "views": 1}
+        yield
+        return
+    created = []
+
+    def make(maxsize=0):
+        maxsize = int(maxsize)
+        made = TimedQueue(max(maxsize, int(views)) if maxsize > 0 else maxsize)
+        created.append(made)
+        return made
+
+    module.Queue = make
+    try:
+        yield
+    finally:
+        module.Queue = queue.Queue
+        _QUEUE_HOOK.release()
+        stats = {"hooked": True, "views": int(views), "queues": len(created)}
+        if len(created) == 1:
+            stats.update(created[0].receipt())
+        receipt["encoder_queue"] = stats
+
+
+# ---- chunks out of the decoder as soon as they are final ------------------------------------------------------------
+class HeadMarker:
+    """A temporal group with nothing to decode, placed between two real groups and spanning their overlap.
+
+    tiled_decode handles it like any group: it adds the marker's (zero) buffer into the previous group's overlap,
+    copies that overlap into the marker, and yields the previous group's head (the frames before the next group
+    starts). Then it decodes the next group and blends the marker, which now holds the previous group's overlap,
+    into it, and yields the marker's empty head (dropped). The next group therefore gets the same sums as when it is
+    blended with the previous group directly, and the previous group's head leaves one group earlier. Adding zeros
+    can only turn -0.0 into +0.0, which decode_video's to_rgb (x + 1) removes.
+    """
+
+    def __init__(self, start, stop):
+        self.out_coords = (slice(None), slice(None), slice(start, stop))
+
+
+def with_head_markers(groups):
+    """LTX-2's temporal groups with a HeadMarker group between each pair of consecutive groups."""
+    marked = []
+    for index, group in enumerate(groups):
+        marked.append(group)
+        if index + 1 < len(groups):
+            start = groups[index + 1][0].out_coords[2].start
+            marked.append([HeadMarker(start, max(start, group[0].out_coords[2].stop))])
+    return marked
+
+
+_GROUP_HOOK = threading.Lock()
+
+
+@contextmanager
+def head_markers(module):
+    """While active, the decoder module's group_tiles_by_temporal_slice adds the HeadMarker groups."""
+    original = getattr(module, "group_tiles_by_temporal_slice", None)
+    if original is None or not _GROUP_HOOK.acquire(blocking=False):
+        yield False
+        return
+    module.group_tiles_by_temporal_slice = lambda tiles: with_head_markers(original(tiles))
+    try:
+        yield True
+    finally:
+        module.group_tiles_by_temporal_slice = original
+        _GROUP_HOOK.release()
+
+
+def source_sha256(function):
+    try:
+        return hashlib.sha256(inspect.getsource(function).encode()).hexdigest()
+    except (OSError, TypeError):
+        return None
+
+
+def install_eager_decode(decoder):
+    """Make this decoder instance's tiled_decode (which decode_video calls) yield each temporal chunk as soon as its
+    frames are final. Returns whether it was installed: only for the LTX-2 version checked by LTX2_SOURCE_SHA256.
+
+    Same tiles, same decoder calls with the same generator in the same order, the same chunks (views of the same
+    buffers, so the same shapes and strides) with the same values; see HeadMarker.
+    """
+    cls = type(decoder)
+    module = sys.modules.get(getattr(getattr(cls, "tiled_decode", None), "__module__", ""))
+    if (any(source_sha256(getattr(cls, name, None)) != digest for name, digest in LTX2_SOURCE_SHA256.items())
+            or getattr(module, "group_tiles_by_temporal_slice", None) is None):
+        return False
+    accumulate, tiled_decode = decoder._accumulate_temporal_group_into_buffer, decoder.tiled_decode
+
+    def accumulate_decoded_groups(group_tiles, buffer, *args, complementary, **kwargs):
+        if isinstance(group_tiles[0], HeadMarker):        # nothing to decode; no weight (as a group without tiles)
+            return None if complementary else buffer.new_zeros(buffer.shape)
+        return accumulate(group_tiles, buffer, *args, complementary=complementary, **kwargs)
+
+    def eager_tiled_decode(*args, **kwargs):
+        chunks = tiled_decode(*args, **kwargs)
+        with head_markers(module):                         # tiled_decode groups its tiles in its first step
+            first = next(chunks, None)
+        if first is None:
+            return
+        if first.shape[2]:
+            yield first
+        for frames in chunks:
+            if frames.shape[2]:                             # a marker's empty head
+                yield frames
+
+    decoder._accumulate_temporal_group_into_buffer = accumulate_decoded_groups
+    decoder.tiled_decode = eager_tiled_decode
+    return True
