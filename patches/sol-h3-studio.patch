@@ -0,0 +1,99 @@
+"""Canvas geometry derived from the recipe. Importing this module loads no GPU framework.
+
+Part of sol-h3-studio (Apache-2.0); not part of the upstream Sol-H3-Spark package.
+
+The frozen record (configs/default.json) describes the landscape 672x384 ->
+1344x768 route. Portrait is an opt-in derived recipe with width/height (and
+the matching latent/tile axes) transposed. Durations other than the frozen 5 s
+(124 -> 121 frames) are derived the same way (draft_frames_for_seconds).
+"""
+
+ORIENTATIONS = ("landscape", "portrait")
+DRAFT_FRAMES, OUTPUT_FRAMES = 124, 121           # frozen 5 s route (default)
+H3_CHANNELS, H3_SPATIAL, H3_LATENT_FRAMES = 24, 16, 37
+LTX_CHANNELS, LTX_SPATIAL, ADAPTER_LATENT_FRAMES, REFINER_LATENT_FRAMES = 128, 32, 17, 16
+AUDIO_SAMPLES = 161333  # 121 frames at 24 fps and 32 kHz
+MAX_REFINER_VIDEO_TOKENS = 65536                  # Stage2 AttentionManager(max_tokens)
+MIN_SECONDS, MAX_SECONDS = 3.0, 15.0
+
+
+# sol-h3-studio duration extension ---------------------------------------------------------
+def draft_frames_for_seconds(seconds):
+    """H3 frame count for a duration: 24 fps snapped UP to H3's 17k+5 grid (the ComfyUI template rule)."""
+    seconds = float(seconds)
+    if not MIN_SECONDS <= seconds <= MAX_SECONDS + 0.2:
+        raise ValueError(f"duration must be between {MIN_SECONDS:g} and {MAX_SECONDS:g} seconds")
+    n = max(5, round(seconds * 24))
+    return n + (5 - n % 17) % 17
+
+
+def output_frames_for(draft_frames):
+    """LTX output: the largest 8m+1 frame count not exceeding the draft (124 -> 121, 243 -> 241)."""
+    return ((int(draft_frames) - 1) // 8) * 8 + 1
+
+
+def frame_geometry(draft_frames):
+    """Temporal shapes for one draft length, using the adapter's own alignment rules."""
+    n = int(draft_frames)
+    if n < 5 or (n - 5) % 17:
+        raise ValueError("H3 draft frames must be on the 17k+5 grid (73, 90, ..., 124, ..., 362)")
+    clip, comp, drop = 17, 4, 3                       # h3_ltx_adapter/constants.py
+    h3_latent = ((n + clip - 1) // clip) * ((clip + comp - 1) // comp) - drop
+    padded = ((n - 1 + 7) // 8) * 8 + 1
+    out = output_frames_for(n)
+    refiner = (out - 1) // 8 + 1
+    return {"draft_frames": n, "output_frames": out, "h3_latent_frames": h3_latent,
+            "adapter_latent_frames": (padded - 1) // 8 + 1, "refiner_latent_frames": refiner,
+            "audio_samples": int(out / 24 * 32000)}
+
+
+def orient_recipe(recipe, orientation="landscape"):
+    """Return the recipe for one orientation; call only after the frozen hash check."""
+    if orientation not in ORIENTATIONS:
+        raise ValueError(f"orientation must be one of {ORIENTATIONS}")
+    if orientation == "landscape":
+        return recipe
+    for section in ("stage1", "output"):
+        values = recipe[section]
+        values["width"], values["height"] = values["height"], values["width"]
+    shape = recipe["handoff"]["refiner_input_shape"]
+    shape[3], shape[4] = shape[4], shape[3]
+    tiles = recipe["stage2"]["tiles"]
+    tiles["height"], tiles["width"] = tiles["width"], tiles["height"]
+    tiles["height_overlap"], tiles["width_overlap"] = tiles["width_overlap"], tiles["height_overlap"]
+    recipe["orientation"] = orientation
+    return recipe
+
+
+def from_recipe(config=None):
+    """Derived shapes for every stage; a partial/absent config means the frozen landscape route."""
+    config = config or {}
+    stage1 = config.get("stage1", {})
+    output = config.get("output", {})
+    draft_h, draft_w = int(stage1.get("height", 384)), int(stage1.get("width", 672))
+    out_h, out_w = int(output.get("height", 768)), int(output.get("width", 1344))
