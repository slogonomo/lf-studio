+"""CPU checks for decoding ahead of the H.264 encoder (runtime/stage2_ops/decode_ahead.py).
+
+Part of sol-h3-studio (Apache-2.0). No GPU, no weights. The decoder and the encoder here are stand-ins written for
+these tests: a generator of small tensors, a module with encode_video's producer/consumer shape (a one-slot Queue to
+an encoder thread), and a tiled decoder with the yield and blend rule of LTX-2's ConvVideoDecoder.tiled_decode.
+
+With SOL_H3_TEST_LTX_ROOT=<an LTX-2 checkout> and the Stage-2 Python, RealLTXTests also run LTX-2's own tiled
+decoder and its encode_video (PyAV, libx264) on the CPU.
+"""
+from __future__ import annotations
+
+from contextlib import nullcontext
+import hashlib
+import os
+from pathlib import Path
+import queue
+import sys
+import tempfile
+import threading
+import types
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from runtime import config
+from runtime import stage2
+from runtime.stage2_ops import decode_ahead as ahead
+from runtime.stage2_ops.writer_chunking import tracked_writer_chunks
+
+FRAME = (2, 2, 3)          # tiny frames; the writer checks only shape and dtype
+CHUNKS = (96, 104, 41)     # the decoder chunks of a 10 s clip
+
+
+# ---- writer and encoder queue ---------------------------------------------------------------------------------------
+def frames_tensor(count, start=0):
+    values = torch.arange(start, start + count, dtype=torch.float32).reshape(count, 1, 1, 1)
+    return (values / 1000).expand(count, *FRAME).to(torch.bfloat16).contiguous()
+
+
+def decoder(sizes=CHUNKS, *, log=None, fail_at=None):
+    """Chunks of frames whose values number them; log(("ask", k)) before chunk k is made."""
+    start = 0
+    for index, size in enumerate(sizes):
+        if log is not None:
+            log(("ask", index))
+        if index == fail_at:
+            raise RuntimeError(f"decoder failed at chunk {index}")
+        yield frames_tensor(size, start)
+        start += size
+
+
+STAND_IN_ENCODE = '''
+import threading
+from queue import Queue
+
+
+def _encode_chunks_threaded(items, encode_frame, flush):
+    pending = Queue(maxsize=1)
+    failures = []
+
+    def consume():
+        while (item := pending.get()) is not None:
+            if failures:
+                continue                        # keep taking items so the producer is never stuck
+            try:
+                for frame in item:
+                    encode_frame(frame)
+            except Exception as error:
+                failures.append(error)
+        if not failures:
+            try:
+                flush()
+            except Exception as error:
+                failures.append(error)
+
+    worker = threading.Thread(target=consume, name="stand-in-encoder")
+    worker.start()
+    try:
+        for item in items:
+            pending.put(item)
+    finally:
+        pending.put(None)
+        worker.join()
+    if failures:
+        raise failures[0]
+
+
+def encode_video(video, encode_frame, flush=lambda: None, convert=lambda chunk: chunk.clone()):
+    first = next(video, None)
+    if first is None:
+        raise ValueError("video is empty")
+    converted = convert(first)
+
+    def items():
+        yield converted
+        for chunk in video:
+            yield convert(chunk)
+
+    _encode_chunks_threaded(items(), encode_frame, flush)
+'''
+
+
+def encode_module(name="stand_in_encode"):
+    """Stand-in for ltx_pipelines.utils.media_io.encode: the producer converts each view (a copy, as the colour
+    conversion and the copy to the CPU are) and puts it into a one-item Queue, a module global built per call; an
+    encoder thread takes them; the first view is converted before that thread starts."""
+    module = types.ModuleType(name)
+    exec(compile(STAND_IN_ENCODE, name, "exec"), module.__dict__)
+    return module
+
+
+class Recorder:
+    """The encoder: keeps every frame it gets, in order; can wait for a gate first or fail at a frame."""
+
+    def __init__(self, gate=None, fail_at=None):
+        self.frames, self.gate, self.fail_at, self.flushed = [], gate, fail_at, False
+
+    def __call__(self, frame):
+        if self.gate is not None:
+            self.gate.wait(30)
+        if self.fail_at is not None and len(self.frames) == self.fail_at:
+            raise OSError("libx264 failed")
+        self.frames.append(frame.clone())
+
+    def flush(self):
+        self.flushed = True
+
+    def all(self):
+        return torch.stack(self.frames)
+
+
+def writer_receipt():
+    return {"chunk_frames": 16, "source_chunks": 0, "emitted_chunks": 0, "frames": 0, "source_layouts": [],
+            "complete": False}
+
+
+def write(module, views, source, encoder, receipt=None):
+    """What write_full_vae_video does around encode_video: the writer's views, the hook (views None: no hook)."""
+    receipt = writer_receipt() if receipt is None else receipt
+    video = iter(tracked_writer_chunks(source, receipt, expected_dtype=torch.bfloat16, frame_shape=FRAME,
+                                       expected_frames=sum(CHUNKS)))
+    with nullcontext() if views is None else ahead.encoder_queue(module, views, receipt):
+        module.encode_video(video, encoder, encoder.flush)
+    return receipt
+
+
+class EncoderQueueTests(unittest.TestCase):
+    def test_same_frames_in_the_same_order(self):
+        expected = frames_tensor(sum(CHUNKS))
+        for views in (None, 1, 8):
+            module, encoder = encode_module(), Recorder()
+            receipt = write(module, views, decoder(), encoder)
+            self.assertTrue(torch.equal(encoder.all(), expected), views)
+            self.assertTrue(encoder.flushed and receipt["complete"])
+            self.assertEqual((receipt["source_chunks"], receipt["emitted_chunks"], receipt["frames"]), (3, 16, 241))
+            self.assertIsInstance(receipt["decoder_done_monotonic_ns"], int)
+            self.assertIs(module.Queue, queue.Queue)
+            if views is not None:
+                stats = receipt["encoder_queue"]
+                self.assertEqual((stats["hooked"], stats["views"], stats["queues"]), (True, views, 1))
+                self.assertLessEqual(stats["max_queued_views"], views)
+                self.assertGreaterEqual(stats["frames_to_encoder_monotonic_ns"], stats["encoder_started_monotonic_ns"])
+
+    def run_gated(self, views):
+        """The encoder is stuck on its first frame. Returns which later chunks the decoder was asked for meanwhile."""
+        module, gate = encode_module(), threading.Event()
+        asked = {index: threading.Event() for index in range(len(CHUNKS))}
+        encoder, results = Recorder(gate=gate), []
+        writer = threading.Thread(target=lambda: results.append(
+            write(module, views, decoder(log=lambda event: asked[event[1]].set()), encoder)))
+        writer.start()
+        try:
+            seen = {index: asked[index].wait(10 if (index, views) == (1, 8) else 0.5) for index in (1, 2)}
+        finally:
+            gate.set()
+            writer.join(30)
+        self.assertEqual(len(results), 1)
+        self.assertTrue(torch.equal(encoder.all(), frames_tensor(sum(CHUNKS))))
+        return seen
+
+    def test_the_decoder_runs_one_chunk_ahead(self):
+        # room for one decoder chunk: chunk 1 is made while the encoder still has all of chunk 0, but not chunk 2
+        self.assertEqual(self.run_gated(8), {1: True, 2: False})
+
+    def test_upstream_queue_holds_the_decoder_back(self):
+        # one view (LTX-2): no new chunk while the encoder is busy with this one
+        self.assertEqual(self.run_gated(1), {1: False, 2: False})
+
+    def test_a_decoder_error_reaches_the_caller_and_the_hook_is_undone(self):
+        module, encoder, receipt = encode_module(), Recorder(), writer_receipt()
+        with self.assertRaisesRegex(RuntimeError, "decoder failed at chunk 2"):
+            write(module, 8, decoder(fail_at=2), encoder, receipt)
+        self.assertIs(module.Queue, queue.Queue)
+        self.assertFalse(receipt["complete"])
+        self.assertNotIn("decoder_done_monotonic_ns", receipt)
+        self.assertTrue(receipt["encoder_queue"]["hooked"])
+        self.assertTrue(torch.equal(encoder.all(), frames_tensor(200)))     # what came before the error, in order
+        self.assertTrue(write(module, 8, decoder(), Recorder())["encoder_queue"]["hooked"])     # free again
+
+    def test_an_encoder_error_reaches_the_caller(self):
+        module = encode_module()
+        with self.assertRaisesRegex(OSError, "libx264 failed"):
+            write(module, 8, decoder(), Recorder(fail_at=50))
+        self.assertIs(module.Queue, queue.Queue)
+        with self.assertRaisesRegex(RuntimeError, "consumed 0 frames, expected 241"):    # the writer's own check
+            write(module, 8, iter(()), Recorder())
+        self.assertIs(module.Queue, queue.Queue)
+
+    def test_hooked_only_where_it_is_the_same_queue(self):
+        receipt, changed = {}, encode_module()
+        changed.Queue = lambda maxsize=0: queue.LifoQueue(maxsize)          # not queue.Queue: left alone
+        with ahead.encoder_queue(changed, 8, receipt):
+            pass
+        self.assertEqual(receipt["encoder_queue"], {"hooked": False, "views": 1})
+        with ahead.encoder_queue(None, 8, receipt):                         # module not loaded
+            pass
+        self.assertFalse(receipt["encoder_queue"]["hooked"])
+        outer, inner, first, second = {}, {}, encode_module(), encode_module("other")
+        with ahead.encoder_queue(first, 8, outer):
+            with ahead.encoder_queue(second, 8, inner):                     # one hook at a time
+                self.assertIs(second.Queue, queue.Queue)
+            self.assertIsNot(first.Queue, queue.Queue)
+        self.assertIs(first.Queue, queue.Queue)
+        self.assertFalse(inner["encoder_queue"]["hooked"])
+        self.assertEqual((outer["encoder_queue"]["hooked"], outer["encoder_queue"]["queues"]), (True, 0))
+
+    def test_queue_views(self):
+        self.assertEqual([ahead.queue_views(n) for n in (1, 16, 17, 128, 129)], [1, 1, 2, 8, 9])
+        module, made = encode_module(), []
+        with ahead.encoder_queue(module, 8, {}):
+            made += [module.Queue(maxsize=1), module.Queue(maxsize=12), module.Queue()]
+        self.assertEqual([q.maxsize for q in made], [8, 12, 0])
+
+    def test_setting(self):
+        with patch.dict(os.environ):
+            os.environ.pop("SOL_H3_DECODE_AHEAD", None)
+            self.assertTrue(config.decode_ahead_enabled())
+            for value, enabled in (("1", True), ("", True), (" 0 ", False), ("0", False)):
+                os.environ["SOL_H3_DECODE_AHEAD"] = value
+                self.assertEqual(config.decode_ahead_enabled(), enabled, value)
+
+
+# ---- chunks out of the decoder as soon as they are final ------------------------------------------------------------
+def group_tiles_by_temporal_slice(tiles):
+    """Consecutive tiles with the same temporal output slice form a group (what LTX-2's function returns)."""
+    groups = []
+    for tile in tiles:
+        if groups and groups[-1][0].out_coords[2] == tile.out_coords[2]:
+            groups[-1].append(tile)
+        else:
+            groups.append([tile])
+    return groups
+
+
+GROUPING = group_tiles_by_temporal_slice
+
+
+class StandInDecoder:
+    """Written for these tests. Like LTX-2's ConvVideoDecoder.tiled_decode: each temporal group is decoded into its
+    own buffer; the overlap with the previous buffer is summed and copied into this buffer's start; then the
+    previous buffer's frames before this group's start are yielded; the last buffer is yielded whole. Without
+    complementary masks, buffers carry weights that the yielded frames are divided by. "Decoding" draws from the
+    generator, so the values show the decode order."""
+
+    def __init__(self, groups, complementary, log):
+        self.groups, self.complementary, self.log = groups, complementary, log
+
+    def _prepare_tiles(self, latent, tiling_config=None):
+        tiles, width = [], latent.shape[4]
+        for index, (start, stop) in enumerate(self.groups):
+            for side in (slice(0, width // 2 + 1), slice(width // 2 - 1, width)):      # two overlapping tiles
+                tiles.append(SimpleNamespace(group=index, side=side, out_coords=(slice(None), slice(None),
+                                                                                 slice(start, stop))))
+        return tiles
+
+    def _accumulate_temporal_group_into_buffer(self, group_tiles, buffer, latent, timestep, generator, *,
+                                               complementary):
+        self.log(("decode", group_tiles[0].group))
+        weights = None if complementary else torch.zeros_like(buffer)
+        for tile in group_tiles:
+            region = (slice(None), slice(None), slice(None), slice(None), tile.side)
+            ramp = torch.linspace(0.2, 1.0, buffer[region].shape[-1])
+            buffer[region] += (torch.randn(buffer[region].shape, generator=generator) * ramp).to(buffer.dtype)
+            if weights is not None:
+                weights[region] += ramp.to(weights.dtype)
+        return weights
+
+    def tiled_decode(self, latent, tiling_config=None, timestep=None, generator=None):
+        tiles = self._prepare_tiles(latent, tiling_config)
+        complementary = self.complementary
+        previous = None
+        for group in group_tiles_by_temporal_slice(tiles):           # this module's global, as in LTX-2's module
+            span = group[0].out_coords[2]
+            buffer = torch.zeros(1, 3, span.stop - span.start, latent.shape[3], latent.shape[4], dtype=latent.dtype)
+            weights = self._accumulate_temporal_group_into_buffer(
+                group_tiles=group, buffer=buffer, latent=latent, timestep=timestep, generator=generator,
+                complementary=complementary)
+            if previous is not None:
+                last, last_weights, last_span = previous
+                shared, offset = last_span.stop - span.start, span.start - last_span.start
+                if shared > 0:
+                    last[:, :, offset:] += buffer[:, :, :shared]
+                    buffer[:, :, :shared] = last[:, :, offset:]
+                    if not complementary:
+                        last_weights[:, :, offset:] += weights[:, :, :shared]
+                        weights[:, :, :shared] = last_weights[:, :, offset:]
+                yield last[:, :, :offset] if complementary else (last / last_weights.clamp(min=1e-8))[:, :, :offset]
+            previous = buffer, weights, span
+        if previous is not None:
+            last, last_weights, _ = previous
+            yield last if complementary else last / last_weights.clamp(min=1e-8)
+
+
+GROUPS = {"5 s": [(0, 121)],
+          "10 s": [(0, 121), (96, 225), (200, 241)],
+          "15 s": [(0, 121), (96, 225), (200, 329), (304, 361)],
+          "no overlap": [(0, 121), (121, 241)]}
+STAND_IN_SHA256 = {name: ahead.source_sha256(getattr(StandInDecoder, name)) for name in ahead.LTX2_SOURCE_SHA256}
+
+
+def decode_video(model, latent, generator):
+    """decode_video's tiled branch: to_rgb works in place on each yielded chunk."""
+    for frames in model.tiled_decode(latent, None, generator=generator):
+        yield frames[0].permute(1, 2, 3, 0).add_(1.0).mul_(0.5).clamp_(0.0, 1.0)
+
+
+def run_decoder(groups, complementary, eager):
+    log = []
