+
+    def test_prepare_tiles_follows_fastvideo_tile_bookkeeping(self):
+        holder = Holder()
+        first, second = request_geometry(100), request_geometry(110)       # same tile count, other geometry
+        hidden = torch.zeros(1, 100 + AUDIO + VIDEO, HIDDEN)
+        buffer = regional.prepare_tiles(torch, metadata(100, 0, first, holder), hidden, HEADS, HEAD_DIM)
+        self.assertEqual(tuple(buffer.shape), (4, first[0].numel() * 64, HEADS, HEAD_DIM))
+        self.assertTrue(bool((buffer == 0).all()))
+        self.assertIs(holder.untile_geometry, first[1])
+        buffer.fill_(1)
+        self.assertIs(regional.prepare_tiles(torch, metadata(100, 1, first, holder), hidden, HEADS, HEAD_DIM), buffer)
+        self.assertTrue(bool((buffer == 1).all()))                          # same geometry: reused as it is
+        hidden = torch.zeros(1, 110 + AUDIO + VIDEO, HIDDEN)
+        self.assertIs(regional.prepare_tiles(torch, metadata(110, 0, second, holder), hidden, HEADS, HEAD_DIM), buffer)
+        self.assertTrue(bool((buffer == 0).all()))                          # other geometry: cleared once
+        third = request_geometry(200)                                       # more tiles: a new zero buffer
+        hidden = torch.zeros(1, 200 + AUDIO + VIDEO, HIDDEN)
+        self.assertIsNot(regional.prepare_tiles(torch, metadata(200, 0, third, holder), hidden, HEADS, HEAD_DIM),
+                         buffer)
+        with self.assertRaisesRegex(ValueError, "built for sequence length"):
+            regional.prepare_tiles(torch, metadata(201, 0, third, holder), hidden, HEADS, HEAD_DIM)
+
+    def install_today(self, model, namespace, calls):
+        """The body attention as regional.install() wires it with the setting off (ints passed to the op)."""
+        original = sparse_attention(calls)
+
+        @torch.library.custom_op(f"{namespace}::body", mutates_args=(), device_types="cpu")
+        def body_op(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, gate: torch.Tensor,
+                    variable_sizes: torch.Tensor, layer: torch.Tensor,
+                    prefix_tiles: int, video_tiles: int, step: int) -> torch.Tensor:
+            md = SimpleNamespace(variable_block_sizes=variable_sizes, num_prefix_tiles=prefix_tiles,
+                                 num_video_tiles=video_tiles, current_timestep=step)
+            return original(q, k, v, gate, md).contiguous()
+
+        @body_op.register_fake
+        def body_fake(q, k, v, gate, variable_sizes, layer, prefix_tiles, video_tiles, step):
+            return torch.empty_like(q)
+
+        def body_forward(self, query, key, value, gate, md):
+            return body_op(query, key, value, gate, md.variable_block_sizes, self._sol_h3_cpu_layer,
+                           md.num_prefix_tiles, md.num_video_tiles, md.current_timestep)
+
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = MethodType(body_forward, impl)
+
+    def install_any_length(self, model, namespace, calls):
+        receipt = {"body_runtime_calls": 0}
+        originals = [sparse_attention(calls)] * len(model.transformer_blocks)
+        preprocess, forward = regional.length_free_body(torch, originals, receipt, forward_context,
+                                                        namespace=namespace, device_types="cpu")
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = MethodType(forward, impl)
+            impl.preprocess_qkv = MethodType(preprocess, impl)
+        return receipt
+
+    def reference(self, lengths):
+        """Eager, uncompiled: FastVideo's tile() inside the attention and the original forward called directly."""
+        model, calls = Model(), []
+        original = sparse_attention(calls)
+        for block in model.transformer_blocks:
+            impl = block.attn.distributed_attention.impl
+            impl.forward = lambda q, k, v, gate, md: original(q, k, v, gate, md)
+        with torch.no_grad():
+            return [run_request(model, text) for text in lengths], calls
+
+    def test_today_recompiles_for_each_length_and_step(self):
+        limit = patch.object(torch._dynamo.config, "recompile_limit", 64)   # raised in the worker too (stage1.py)
+        limit.start()
+        self.addCleanup(limit.stop)
+        model, blocks, refiners, calls = Model(), GraphCounter(), GraphCounter(), []
+        self.install_today(model, "sol_h3_test_regional_today", calls)
+        compile_regions(model, blocks, refiners)
+        graphs = []
+        with torch.no_grad():
+            for text in (100, 110, 120):
+                run_request(model, text)
+                graphs.append((blocks.graphs, refiners.graphs))
+        # Block: a graph per denoise step (step ints) and one for the request's first call (empty tile-buffer holder),
+        # again for every new length (total_seq_length). Refiner: automatic dynamic shapes from the 2nd length on.
+        self.assertEqual(graphs, [(5, 1), (10, 2), (15, 2)])
+
+    def test_any_length_compiles_once_and_matches_eager(self):
+        lengths = (100, 110, 128, 129, 150, 300)          # same and different tile counts, a full last text tile
+        expected, expected_calls = self.reference(lengths)
+        model, blocks, refiners, calls = Model(), GraphCounter(), GraphCounter(), []
+        receipt = self.install_any_length(model, "sol_h3_test_regional_any", calls)
+        compile_regions(model, blocks, refiners)
+        self.assertEqual(regional.mark_length_dynamic(torch, model, forward_context)["body_regions"], 2)
+        graphs = []
+        with torch.no_grad():
+            for text, want in zip(lengths, expected):
+                got = run_request(model, text)
+                graphs.append((blocks.graphs, refiners.graphs))
+                for a, b in zip(got, want):
+                    self.assertTrue(torch.equal(a, b), f"text length {text}: output differs from eager")
+        # One block graph for every length and step; the refiner, left as it is, recompiles once (2nd length).
+        self.assertEqual(graphs, [(1, 1)] + [(1, 2)] * (len(lengths) - 1))
+        self.assertEqual(calls, expected_calls)            # steps and tile counts read when the op runs
+        self.assertEqual(receipt["body_runtime_calls"], len(lengths) * 4 * 2)
+
+    def test_dense_route_compiles_once(self):
+        """Ref2VA (install_dense): no VSA metadata, only the packed-row dims and the attention's length int."""
+        lengths = (100, 129, 300)
+        reference = Model(dense=True)
+        with torch.no_grad():
+            expected = [run_request(reference, text) for text in lengths]
+        model, blocks, refiners = Model(dense=True), GraphCounter(), GraphCounter()
+        compile_regions(model, blocks, refiners)
