+def _install_autotune_cache_fix(debug=False):
+    """sol-h3-studio: honour Inductor's saved coordinate-descent results for kernels loaded from the FX graph cache.
+
+    A statically launchable CachingAutotuner is pickled into the FX cache; for some kernels its compile_results
+    were already pruned to one config, and CachingAutotuner.recheck_autotune_cache (torch 2.13) re-hashes *that*
+    list, which never equals the configs_hash the result was saved under (the original candidate list). Every new
+    process therefore re-ran coordinate-descent tuning for the same 11 Stage2 kernels (~3-4 s) and re-saved the
+    same .best_config. After an upstream miss, read the entry with the kernel's own AutotuneCache (same key =
+    kernel source hash + torch version, same configs_hash that save() used), then do what upstream does on a hit.
+    """
+    from torch._inductor.runtime import triton_heuristics as th
+    original = th.CachingAutotuner.recheck_autotune_cache
+    if getattr(original, "_spark_fix", False):
+        return
+
+    def recheck(self_, reload_kernel_from_src):
+        original(self_, reload_kernel_from_src)
+        info = getattr(self_, "autotune_cache_info", None) or {}
+        cache = getattr(getattr(self_, "save_cache_hook", None), "__self__", None)
+        if info.get("autotune_cache_state") != "miss" or cache is None or not hasattr(cache, "read_best"):
+            return
+        best = cache.read_best(self_.inductor_meta, [r.config for r in self_.compile_results])
+        if best is None or not getattr(best, "found_by_coordesc", False):
+            return
+        wanted = th.triton_config_to_hashable(best)
+        match = next((r for r in self_.compile_results if th.triton_config_to_hashable(r.config) == wanted), None)
+        if match is not None:
+            match.config.found_by_coordesc = True
+            self_.compile_results = [match]
+        else:
+            if self_.fn.fn is None:
+                self_.fn = reload_kernel_from_src().fn
+            self_.compile_results = [self_._precompile_config(best)]
+        info["autotune_cache_state"] = "hit (spark fallback)"
+        if debug:
+            print(f"[sol-h3-studio] fallback hit {Path(self_.filename).name[:14]} -> {wanted}", flush=True)
+
+    recheck._spark_fix = True
+    th.CachingAutotuner.recheck_autotune_cache = recheck
