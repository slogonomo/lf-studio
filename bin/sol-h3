#!/usr/bin/env python3
"""sol-h3: the client's name up to 0.4, kept until 0.6. It runs bin/lf-cli next to it with the same arguments, in this
process (an MCP host registered with `sol-h3 mcp` keeps working). Nothing goes to stdout, where MCP speaks."""
import os
import sys

NEW = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lf-cli")
if not os.path.isfile(NEW):      # a lone copy of this file (the old download URL)
    sys.exit("sol-h3: renamed to lf-cli, which is not next to this file. Get it: curl -fsSLo lf-cli "
             "https://raw.githubusercontent.com/slogonomo/lf-studio/main/bin/lf-cli (docs/API.md)")
print('sol-h3: renamed to bin/lf-cli; the old name works until 0.6 (docs/INSTALL.md, "From 0.4 to 0.5")',
      file=sys.stderr, flush=True)
os.execv(sys.executable, [sys.executable, NEW] + sys.argv[1:])
