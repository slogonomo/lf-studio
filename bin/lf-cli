OUT = {"type": "string", "description": "An existing directory, or a file name ending in .mp4, for the MP4 (default "
                                        "LFSTUDIO_OUT_DIR); an existing file is never replaced. A relative path starts "
                                        "from this server's working directory, not LFSTUDIO_OUT_DIR"}
POSTER = {"type": "boolean", "default": True, "description": "Include a poster frame image (also saved as .jpg)"}
WAIT_S = {"type": "number", "minimum": 0,
          "description": "Seconds to wait for the clip (default from LFSTUDIO_MCP_WAIT_S); 0 returns the id at once"}
TOOLS = [
    {"name": "generate", "title": "Make a clip",
     "description": (
         "Queue a clip on the LF Studio and wait up to wait_s seconds for it; when done, the MP4 is saved locally. "
         "Tasks: t2va (text only), fl2va (first_frame and/or last_frame image), ref2va (references: up to 9 images, 3 "
         "videos of 2-15 s, 3 audio files, 12 in total, at least one image or video). The task is inferred from the "
         "files when omitted. Files are paths on this machine (best absolute: a relative one starts from this server's "
         "working directory) or http(s) URLs; the type comes from the extension "
         "(.png .jpg .jpeg .webp / .mp4 .mov .m4v .webm .mkv / .wav .mp3 .flac .m4a .ogg). Keyframes should have the "
         "clip's shape (1344x768 or 768x1344): one of another shape is stretched or cropped to fit; without "
         "orientation, the first keyframe's shape picks it. Write the prompt in H3's format (prompt_guide). "
         "References are numbered in the order given per kind: <Picture N>, <Video N>, <Audio N>; a reference video "
         "with sound also takes an <Audio N> just before its own <Video N>. The result's labels list shows the "
         "numbering used. An identical call to this server within 30 minutes returns the earlier clip instead of "
         "making a new one: change the seed (or pass again: true) for another take. After a restart of the server (a "
         "new session), status lists the newest clips. Cancelling this call never removes a clip that was already "
         "submitted."),
     "inputSchema": {"type": "object", "required": ["prompt"], "additionalProperties": False, "properties": {
         "prompt": {"type": "string", "description": (
             "H3 structured prompt. t2va/fl2va: integrated_multimodal_description, overall_soundscape, "
