META_CAPS = "io.modelcontextprotocol/clientCapabilities"
META_SERVER = "io.modelcontextprotocol/serverInfo"
LINKS_FROM = "2025-06-18"   # the first protocol version with resource_link content; older SDK clients reject it
SERVER_INFO = {"name": "lf-studio", "title": "LF Studio", "version": VERSION}
PROGRESS_S = 10          # a notifications/progress this often while a call with a progressToken runs
REPEAT_S = 1800          # an identical generate this soon returns the earlier clip
