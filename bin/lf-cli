             "<d>[English] Exact words, first letter capitalised</d>. See prompt_guide.")},
         "task": {"type": "string", "enum": list(TASKS)},
         "orientation": {"type": "string", "enum": list(ORIENTATIONS),
                         "description": "Default: from the first keyframe's shape, else landscape"},
         "seconds": {"type": "integer", "enum": list(DURATIONS), "default": 5},
         "seed": {"type": "integer", "minimum": 0, "description": "Omit for a random seed"},
         "first_frame": {"type": "string", "description": "Image path or http(s) URL (fl2va)"},
         "last_frame": {"type": "string", "description": "Image path or http(s) URL (fl2va)"},
         "references": {"type": "array", "items": STR, "maxItems": 12,
                        "description": "ref2va: image, video and audio paths or http(s) URLs"},
         "wait_s": WAIT_S, "out": OUT, "poster": POSTER,
         "again": {"type": "boolean", "default": False,
                   "description": "Make a new clip even if an identical call made one in the last 30 minutes"}}}},
    {"name": "wait", "title": "Wait for a clip",
     "description": ("Wait up to wait_s seconds (default LFSTUDIO_MCP_WAIT_S) for a clip. When it is done, save the "
                     "MP4 (to out, or LFSTUDIO_OUT_DIR) and return its path, URL and poster. Cancelling this call does "
                     "not cancel the clip."),
     "inputSchema": {"type": "object", "required": ["id"], "additionalProperties": False, "properties": {
         "id": STR, "wait_s": WAIT_S, "out": OUT, "poster": POSTER}}},
    {"name": "status", "title": "Clip status",
     "description": ("A clip's record (state, phase, queue position, error), or with no id the clips submitted from "
                     "this session, the queue and the newest clips. Never waits, never downloads, never starts a "
                     "stopped studio."),
     "inputSchema": {"type": "object", "additionalProperties": False, "properties": {"id": STR}},
     "annotations": {"readOnlyHint": True}},
    {"name": "cancel", "title": "Cancel a clip",
     "description": ("Cancel a queued or running clip. A running clip stops after the pipeline closes (about 40 s); "
                     "the next clip then loads the models again."),
     "inputSchema": {"type": "object", "required": ["id"], "additionalProperties": False, "properties": {"id": STR}},
     "annotations": {"destructiveHint": True}},
    {"name": "fetch", "title": "Save a clip",
     "description": ("Save an existing clip's MP4 (any clip, also ones made in the web page). If the studio is "
                     "stopped, this refuses unless wake is true, because waking it takes most of the "
                     "machine's memory from other apps."),
     "inputSchema": {"type": "object", "required": ["id"], "additionalProperties": False, "properties": {
         "id": STR, "out": OUT, "poster": POSTER,
         "wake": {"type": "boolean", "default": False, "description": "Start the studio if it is stopped"}}}},
    {"name": "upscale", "title": "Upscale a clip (experimental)",
     "description": (
         "Experimental, on a studio with the Upscale on (LFSTUDIO_UPSCALE=1): upscale a finished clip to 1080p, 2K "
         "(2560x1440, the default) or 4K with NVIDIA's Open-H3-Regenerate-2K, as a new job with an id of its own. For "
         "now only 5 s text clips (t2va), 16:9 or 9:16 (a 9:16 clip comes out upright: 2K is 1440x2560; NVIDIA "
         "trained its refiner on 16:9). It runs after the clips queued, closes the studio's models while it "
         "runs (the next clip, or the studio's warm-up, loads them again) and takes long: on a DGX Spark about 10 min "
         "at 1080p, 19 min at 2K and 1.1 h at 4K with 2 steps (4K has run once, with a 16:9 clip; not yet with a "
         "9:16 one), reading the clip (~2 min) and the load (~22 s; ~7.5 min on a studio with "
         "LFSTUDIO_UPSCALE_LOAD=standard) included. "
         "strength: faithful (start noise 0.5, 2 steps) redraws the least, balanced (0.7, 2 steps) more, full "
         "(NVIDIA's setting, 3 steps) is the sharpest but redraws faces into a different-looking person; the default "
         "is the studio's. audio: what the picture is refined against, the clip's own (clip) or silence; the result "
         "keeps the clip's sound either way. Waits up to wait_s and saves the MP4 when it is done; else call wait with "
         "the id it returns. Each call queues another upscale; cancel stops one."),
     "inputSchema": {"type": "object", "required": ["id"], "additionalProperties": False, "properties": {
         "id": {"type": "string", "description": "The finished clip's id"},
         "resolution": {"type": "string", "enum": list(UPSCALE_RESOLUTIONS), "default": "2k"},
         "strength": {"type": "string", "enum": list(UPSCALE_STRENGTHS), "description": "Default: the studio's"},
         "audio": {"type": "string", "enum": list(UPSCALE_AUDIO), "description": "Default: the studio's"},
         "seed": {"type": "integer", "minimum": 0, "description": "The refine's seed; default the clip's"},
         "wait_s": WAIT_S, "out": OUT, "poster": POSTER}}},
    {"name": "prompt_guide", "title": "H3 prompt guide",
     "description": ("The H3 prompt guide: formats per task, dialogue tags, keyframe lines, reference labels, "
                     "examples. Read it before writing a prompt."),
     "inputSchema": {"type": "object", "additionalProperties": False, "properties": {}},
     "annotations": {"readOnlyHint": True}},
]
TYPE_WORDS = {"string": "a string", "integer": "an integer", "number": "a number", "boolean": "true or false",
              "array": "a list of strings"}


def check_arguments(tool, args):
    """The arguments of a tools/call against the tool's (flat) inputSchema. null counts as left out."""
    if not isinstance(args, dict):
        raise Fail("arguments must be an object")
    props = tool["inputSchema"]["properties"]
    for key in args:
        if key not in props:
            raise Fail(f'unknown argument "{key}" (known: {", ".join(props) or "none"})')
    out = {}
    for key, value in args.items():
        if value is None:
            continue
        spec, kind = props[key], props[key]["type"]
        if kind == "integer" and isinstance(value, float) and value.is_integer():
            value = int(value)
        ok = {"string": isinstance(value, str),
              "integer": isinstance(value, int) and not isinstance(value, bool),
              "number": isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value),
              "boolean": isinstance(value, bool),
              "array": isinstance(value, list) and all(isinstance(v, str) for v in value)}[kind]
        if not ok:
            raise Fail(f"{key} must be {TYPE_WORDS[kind]}")
        if "enum" in spec and value not in spec["enum"]:
            raise Fail(f"{key} must be one of {', '.join(map(str, spec['enum']))}")
        if "minimum" in spec and value < spec["minimum"]:
            raise Fail(f"{key} must be {spec['minimum']} or more")
        if "maxItems" in spec and len(value) > spec["maxItems"]:
            raise Fail(f"{key} takes at most {spec['maxItems']} entries")
        out[key] = value
    for key in tool["inputSchema"].get("required", []):
        if key not in out:
            raise Fail(f"{key} is required")
    return out


def env_seconds(name, default):
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        value = float(raw)
        if not (math.isfinite(value) and value >= 0):
            raise ValueError
        return value
    except ValueError:
        print(f"lf-cli mcp: {name}={raw!r} is not a number of seconds; using {default}", file=sys.stderr, flush=True)
        return default


class CallCancelled(Exception):
    """notifications/cancelled arrived for this call: it sends no response."""


class Call:
    """One tools/call in progress: its cancellation, and progress notifications every PROGRESS_S seconds when the
    request asked for them (progressToken), with what it is doing as the message."""

    def __init__(self, server, mid):
        self.server, self.mid, self.token = server, mid, None
        self.cancelled, self.stopped = threading.Event(), threading.Event()
        self.lock = threading.Lock()
        self.phase, self.t0, self.sent = "starting", time.time(), 0.0

    def start(self, token):
        self.token = token
        if token is not None:
            threading.Thread(target=self._tick, daemon=True).start()

    def _tick(self):
        while not self.stopped.wait(PROGRESS_S):
            with self.lock:
                if self.stopped.is_set() or self.cancelled.is_set():
                    return
                self.sent = max(round(time.time() - self.t0, 1), self.sent + 0.1)
                self.server.send({"jsonrpc": "2.0", "method": "notifications/progress", "params": {
                    "progressToken": self.token, "progress": self.sent, "message": self.phase}})

    def finish(self):
        with self.lock:                     # no progress notification after this (the response follows)
            self.stopped.set()

    def set_phase(self, text):
        self.phase = text

    def check(self):
        if self.cancelled.is_set():
            raise CallCancelled()

    def pause(self, seconds):
        if self.cancelled.wait(seconds):
            raise CallCancelled()


class Submission:
    """A generate of this session: its POST runs in its own thread, which outlives a cancelled or timed-out call."""

    def __init__(self, key, req, out):
        self.key, self.out, self.time = key, out, time.time()
        self.fields = {k: v for k, v in req["fields"].items() if k != "prompt"}
        self.total, self.sent = req["bytes"], 0
        self.id, self.record, self.error, self.path = None, None, None, None
        self.done = threading.Event()


def text_result(text, data=None, error=False):
    if data is not None:
        text += "\n\n" + json.dumps(data, ensure_ascii=False)
    result = {"content": [{"type": "text", "text": text}], "isError": error}
    if data is not None:
        result["structuredContent"] = data
    return result


class McpServer:
    """lf-cli mcp: an MCP server on stdio (newline-delimited JSON-RPC 2.0) in both protocol eras: the legacy
    initialize handshake (2025-11-25 and older) and the stateless 2026-07-28 revision (server/discover, per-request
    _meta). stdin is read on the main thread, each request runs on its own thread, stdout carries protocol messages
    only (logs go to stderr), and the process exits when stdin closes."""

    def __init__(self, url):
        self.studio = Studio(studio_url(url), AGENT + " (mcp)")
        self.wait_s = env_seconds("LFSTUDIO_MCP_WAIT_S", 50.0)
        self.max_wait_s = env_seconds("LFSTUDIO_MCP_MAX_WAIT_S", 1800.0)
        explicit = os.environ.get("LFSTUDIO_OUT_DIR")
        out = explicit or "lf-clips"
        # until 0.6: 0.4's default while it exists and the new one is missing or empty (a setting always wins)
        if not explicit and os.path.isdir("sol-h3-clips") and not (os.path.isdir(out) and os.listdir(out)):
            out = "sol-h3-clips"
            self.log(f"using {os.path.abspath(out)}: {os.path.abspath('lf-clips')} is missing or empty (the old "
                     "default works until 0.6; LFSTUDIO_OUT_DIR sets another)")
        self.out_dir = Path(os.path.abspath(Path(out).expanduser()))
        self.anywhere = os.environ.get("LFSTUDIO_MCP_OUT_ANYWHERE", "") == "1"
        self.stdout = sys.stdout.buffer
        sys.stdout = sys.stderr                       # nothing else may write to the protocol stream
        self.write_lock, self.calls_lock, self.clips_lock = threading.Lock(), threading.Lock(), threading.Lock()
        self.calls = {}                               # request id -> Call
        self.version = None                           # the protocol version agreed at initialize (legacy era)
        self.clips = []                               # Submission, oldest first
        self.handlers = {"generate": self.t_generate, "wait": self.t_wait, "status": self.t_status,
                         "cancel": self.t_cancel, "fetch": self.t_fetch, "upscale": self.t_upscale,
                         "prompt_guide": self.t_guide}

    # -- transport
    def log(self, text):
        print(f"lf-cli mcp: {text}", file=sys.stderr, flush=True)

    def send(self, msg):
        line = json.dumps(msg, separators=(",", ":")).encode() + b"\n"
        with self.write_lock:
            try:
                self.stdout.write(line)
                self.stdout.flush()
            except (OSError, ValueError):             # the client has gone
                self.exit()

    def exit(self):
        for part in list(PARTS):
            try:
                part.unlink()
            except OSError:
                pass
        os._exit(0)

    def run(self):
        signal.signal(signal.SIGTERM, lambda *_: self.exit())
        self.log(f"serving the studio at {self.studio.url}")
        stdin = sys.stdin.buffer
        while True:
            raw = stdin.readline()
            if not raw:
                break
            if not raw.strip():
                continue
            try:
                msg = json.loads(raw.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                self.send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
                continue
            if not isinstance(msg, dict):
                self.send({"jsonrpc": "2.0", "id": None,
                           "error": {"code": -32600, "message": "Invalid request: send one JSON-RPC object per line"}})
                continue
            method = msg.get("method")
            if "id" not in msg:                       # a notification: initialized, cancelled, ...
                if method == "notifications/cancelled":
                    params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
                    with self.calls_lock:
                        call = self.calls.get(_key(params.get("requestId")))
                    if call:
                        call.cancelled.set()
                continue
            if not isinstance(method, str):           # a response to a request of ours (we send none)
                continue
            call = Call(self, msg["id"])
            with self.calls_lock:
                self.calls[_key(msg["id"])] = call
            threading.Thread(target=self.handle, args=(msg, call), daemon=True).start()
        self.exit()

    def error(self, mid, code, message, data=None):
        err = {"code": code, "message": message}
        if data is not None:
            err["data"] = data
        self.send({"jsonrpc": "2.0", "id": mid, "error": err})

    def handle(self, msg, call):
        mid, method = msg["id"], msg["method"]
        try:
            params = msg.get("params")
            params = {} if params is None else params
            if not isinstance(params, dict):
                return self.error(mid, -32602, "params must be an object")
            meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
            version = meta.get(META_VERSION)
            modern = version is not None and method != "initialize"
            if modern and version not in MODERN:
                return self.error(mid, -32022, "Unsupported protocol version",
                                  {"supported": list(MODERN + LEGACY), "requested": version})
            if modern and not isinstance(meta.get(META_CAPS), dict):
                return self.error(mid, -32602, f"_meta needs {META_CAPS} (an object) with {META_VERSION}")
            if method == "initialize":
                asked = params.get("protocolVersion")
                result = {"protocolVersion": asked if asked in LEGACY else LEGACY[0],
                          "capabilities": {"tools": {"listChanged": False}}, "serverInfo": SERVER_INFO,
                          "instructions": INSTRUCTIONS}
                self.version = result["protocolVersion"]
            elif method == "server/discover":
                modern = True
                result = {"supportedVersions": list(MODERN + LEGACY), "capabilities": {"tools": {"listChanged": False}},
                          "instructions": INSTRUCTIONS, "ttlMs": 3600000, "cacheScope": "public"}
            elif method == "ping":
                result = {}
            elif method == "tools/list":
                result = {"tools": TOOLS, "ttlMs": 3600000, "cacheScope": "public"}
            elif method == "tools/call":
                name = params.get("name")
                tool = next((t for t in TOOLS if t["name"] == name), None)
                if tool is None:
                    return self.error(mid, -32602, f"Unknown tool: {name}")
                call.start(meta.get("progressToken"))
                try:
                    result = self.handlers[name](check_arguments(tool, params.get("arguments") or {}), call)
                except CallCancelled:
                    return
                except Fail as error:
                    result = text_result(error.mcp or error.message, error=True)
                except Exception as error:            # a bug: the agent sees it, the server keeps serving
                    traceback.print_exc()
                    result = text_result(f"{type(error).__name__}: {error}", error=True)
                finally:
                    call.finish()
                if call.cancelled.is_set():           # a cancelled request gets no response
                    return
                if not modern and (self.version or LEGACY[0]) < LINKS_FROM:   # the studio URL stays in the JSON
                    result["content"] = [c for c in result["content"] if c["type"] != "resource_link"]
            else:
                return self.error(mid, -32601, f"Method not found: {method}")
            result = dict(result, resultType="complete")
            if modern:
                result["_meta"] = {META_SERVER: SERVER_INFO}
            self.send({"jsonrpc": "2.0", "id": mid, "result": result})
        except Exception as error:                    # noqa: BLE001  (never leave a request unanswered)
            traceback.print_exc()
            self.error(mid, -32603, f"Internal error: {type(error).__name__}: {error}")
        finally:
            with self.calls_lock:
                self.calls.pop(_key(mid), None)

    # -- helpers for the tools
    def budget(self, wait_s):
        return max(0.0, min(self.wait_s if wait_s is None else float(wait_s), self.max_wait_s))

    def saver(self, out, poster):
        """Where an MP4 goes: never replaces a file, stays inside LFSTUDIO_OUT_DIR or the working directory unless
        LFSTUDIO_MCP_OUT_ANYWHERE=1, and must be writable. A relative out starts from the working directory. Checked
        before anything is submitted or downloaded."""
        if not out:
            saver = Saver(directory=self.out_dir, keep=True, poster=poster)
            why = saver.unwritable()
            if why:
                where = ("LFSTUDIO_OUT_DIR" if os.environ.get("LFSTUDIO_OUT_DIR")
                         else "the default; LFSTUDIO_OUT_DIR is unset")
                raise Fail(f"can't save clips in {self.out_dir} ({where}): {why}. Nothing was submitted or "
                           "downloaded. Set LFSTUDIO_OUT_DIR in this server's settings to a directory it can write to, "
                           f"or pass out with a writable directory inside its working directory ({Path.cwd()}).")
            return saver
        p = Path(out).expanduser()
        p = Path(os.path.abspath(p if p.is_absolute() else Path.cwd() / p))
        if p.is_dir():
            saver = Saver(directory=p, keep=True, poster=poster)
        elif p.suffix.lower() == ".mp4":                     # if it exists: saved as <stem>-1.mp4 instead
            saver = Saver(file=p, keep=True, poster=poster)
        else:
            raise Fail(f"out must be an existing directory or a file name ending in .mp4, not {out}")
        if not self.anywhere:
            real, roots = p.resolve(), [self.out_dir.resolve(), Path.cwd().resolve()]
            if not any(real == root or root in real.parents for root in roots):
                raise Fail(f"out must be inside LFSTUDIO_OUT_DIR ({roots[0]}) or the working directory ({roots[1]}); "
                           "the MCP server's settings can allow other places (LFSTUDIO_MCP_OUT_ANYWHERE=1)")
        why = saver.unwritable()
        if why:
            raise Fail(f"can't save the clip at {p}: {why}. Nothing was submitted or downloaded.")
        return saver

    def done_result(self, jid, saved, saver, prefix=""):
        path, n, last = saved
        rec = clip_record(self.studio, jid, last)
        data = dict(rec, path=str(path), url=f"{self.studio.url}/video/{jid}",
                    poster_url=f"{self.studio.url}/poster/{jid}", bytes=n)
        poster = poster_bytes(self.studio, jid) if saver.poster else None
        if poster:
            saved_poster = saver.save_poster(path, poster)
            if saved_poster:
                data["poster_path"] = str(saved_poster)
        if is_upscale(rec):
            text = (f"{prefix}Upscale {jid} is done: saved {path} ({megabytes(n)}, {rec.get('resolution')} of clip "
                    f"{rec.get('parent')}, {rec.get('strength')}).")
        else:
            text = (f"{prefix}Clip {jid} is done: saved {path} ({megabytes(n)}, {rec.get('seconds')} s "
                    f"{rec.get('task')} {rec.get('orientation')}, seed {rec.get('seed')}).")
        if rec.get("labels"):
            text += f" Labels: {labels_text(rec)}."
        result = text_result(text, data)
        result["content"].append({"type": "resource_link", "uri": data["url"], "name": path.name,
                                  "mimeType": "video/mp4", "description": "The clip on the studio"})
        if poster:
            result["content"].append({"type": "image", "data": base64.b64encode(poster).decode(),
                                      "mimeType": "image/jpeg"})
        return result

    def outcome(self, jid, state, info, saver, prefix=""):
        if state == "done":
            return self.done_result(jid, info, saver, prefix)
        if state == "failed":
            return text_result(f"{prefix}{noun(info)} {jid} failed: {info.get('error') or 'no reason given'}", info,
                               error=True)
        if state == "cancelled":
            return text_result(f"{prefix}{noun(info)} {jid} was cancelled.", info)
        what = phase_text(info)
        if state == "running" and info.get("elapsed_s") is not None:
            what += f", {mmss(info['elapsed_s'])} since it started"
        return text_result(f'{prefix}{noun(info)} {jid} is {what}. Call wait with id "{jid}" to keep waiting.', info)

    def wait_outcome(self, jid, deadline, saver, call, prefix=""):
        try:
            state, info = wait_for_clip(self.studio, jid, deadline, saver,
                                        lambda rec: call.set_phase(phase_text(rec)), call.pause, PROGRESS_S)
        except Stopped as error:
            if error.by_switchboard:
                return text_result(f'{prefix}spark-switchboard stopped the studio while waiting for clip {jid}; the '
                                   f'clip most likely finished first. Call fetch with id "{jid}" and wake: true to '
                                   "get it (that starts the studio, which takes most of the machine's memory from "
                                   "other apps).", error=True)
            return text_result(prefix + error.message[0].upper() + error.message[1:] + ".", error.job, error=True)
        except Fail as error:
            if not prefix:
                raise
            return text_result(prefix + (error.mcp or error.message), error=True)   # keeps "Already submitted as"
        return self.outcome(jid, state, info, saver, prefix)

    def earlier_record(self, jid):
        """The record of the clip an identical generate made, read to decide whether to make it again: None only when
        the studio answers that it has no such clip (deleted). A studio that is starting, stopped, unreachable or in
        trouble keeps the earlier clip: {"state": "unknown"} (the wait that follows explains). X-Switchboard-Wait: 0
        makes switchboard answer at once instead of holding the read while the studio starts."""
        try:
            status, headers, raw = self.studio.call("GET", f"/api/jobs/{jid}", None, {"X-Switchboard-Wait": "0"},
                                                    SIDE_S)
        except Unreachable:
            return {"state": "unknown"}
        obj = parse_json(raw)
        if status == 200 and isinstance(obj, dict):
            return obj
        if status == 404 and not isinstance(refusal(status, headers, raw), Busy):
            return None
        return {"state": "unknown"}

    def recent(self, key):
        with self.clips_lock:
            for sub in reversed(self.clips):
                if sub.key == key and time.time() - sub.time < REPEAT_S:
                    return sub
        return None

    def post(self, sub, req, hold):
        """The submit, in its own thread: it finishes even if the call that started it was cancelled or ran out."""
        def sent(n):
            sub.sent = n
        try:
            answer = submit(self.studio, req, hold, sent)
            sub.id, sub.record = answer["id"], answer.get("job")
            self.log(f"submitted clip {sub.id}")
        except Fail as error:
            error.message = error.message.replace("try again in about", "call generate again in about").replace(
                "check with: lf-cli status", "call status without an id to see it")
            sub.error = error
        except Exception as error:                    # noqa: BLE001
            traceback.print_exc()
            sub.error = Fail(f"{type(error).__name__}: {error}", 3)
        finally:
            if sub.error is not None:
                with self.clips_lock:                 # a refused or failed submit isn't "already submitted"
                    if sub in self.clips:
                        self.clips.remove(sub)
                self.log(f"submit failed: {sub.error.message}")
            sub.done.set()

    # -- the tools
    def t_generate(self, args, call):
        t0 = time.time()
        budget = self.budget(args.get("wait_s"))
        saver = self.saver(args.get("out"), args.get("poster", True))
        call.set_phase("reading the input files")
        req = build_request(args["prompt"], args.get("task"), args.get("orientation"), args.get("seconds"),
                            args.get("seed"), args.get("first_frame"), args.get("last_frame"),
                            args.get("references") or [], check=call.check)
        call.check()
        prefix = "".join(f"Note: {w} " for w in req["warnings"])
        if req["notes"]:
            prefix += f"Orientation: {req['notes'][0]}. "
        what = {k: args.get(k) for k in ("prompt", "task", "orientation", "seconds", "seed", "first_frame",
                                          "last_frame", "references")}
        key = hashlib.sha256(json.dumps([what, req["hashes"]], sort_keys=True).encode()).hexdigest()
        earlier = None if args.get("again") else self.recent(key)
        if earlier is not None and not earlier.done.is_set():
            return text_result(f"{prefix}An identical generate call is still submitting its clip (started "
                               f"{mmss(time.time() - earlier.time)} ago). Call status without an id in a minute to see "
                               "its id, or pass again: true to make another clip.", {"state": "submitting"})
        if earlier is not None and earlier.id:
            rec = self.earlier_record(earlier.id)
            if rec is not None and rec.get("state") not in ("failed", "cancelled"):
                prefix += (f"Already submitted as {earlier.id} by an identical call {mmss(time.time() - earlier.time)} "
                           "ago (change the seed, or pass again: true, for another take). ")
                if earlier.path and args.get("out") == earlier.out and Path(earlier.path).is_file() \
                        and rec.get("state") == "done":
                    path = Path(earlier.path)
                    return self.done_result(earlier.id, (path, path.stat().st_size, rec),
                                            Saver(directory=path.parent, keep=True, poster=args.get("poster", True)),
                                            prefix)
                return self.wait_outcome(earlier.id, t0 + budget, saver, call, prefix)
        margin = 15 + req["bytes"] / 2e6 + 15 * req["videos"]   # the upload, and the studio normalizing ref videos
        sub = Submission(key, req, args.get("out"))
        with self.clips_lock:
            self.clips.append(sub)
        threading.Thread(target=self.post, args=(sub, req, max(0.0, budget - margin)), daemon=True).start()
        give_up = t0 + max(budget, margin)
        while not sub.done.wait(0.5):
            call.check()
            if sub.total and sub.sent < sub.total:
                call.set_phase(f"uploading, {megabytes(sub.sent)} of {megabytes(sub.total)}")
            else:
                call.set_phase("submitting (held while the studio starts)")
            if time.time() >= give_up:
                return text_result(f"{prefix}The clip is still being submitted after {mmss(time.time() - t0)} "
                                   "(uploading, or held while the studio starts). It will be queued unless the studio "
                                   "refuses it: call status without an id in a minute to see its id. Don't call "
                                   "generate again for the same clip.", {"state": "submitting"})
        call.check()
        if sub.error is not None:
            return text_result(prefix + sub.error.message, error=True)
        call.set_phase(phase_text(sub.record or {"state": "queued"}))
        if args.get("wait_s") == 0 or time.time() >= t0 + budget:
            return self.outcome(sub.id, (sub.record or {}).get("state", "queued"), sub.record or {"id": sub.id},
                                saver, prefix)
        result = self.wait_outcome(sub.id, t0 + budget, saver, call, prefix)
        path = (result.get("structuredContent") or {}).get("path")
        if path and not result["isError"]:
            sub.path = path
        return result

    def t_wait(self, args, call):
        jid, t0 = check_id(args["id"]), time.time()
        saver = self.saver(args.get("out"), args.get("poster", True))
        call.set_phase("waiting")
        sb = self.studio.switchboard()
        if asleep(sb):
            return text_result(f'{asleep_text(sb)[0].upper()}{asleep_text(sb)[1:]}, so clip {jid} is not running any '
                               f'more: it most likely finished before. Call fetch with id "{jid}" and wake: true to '
                               "get it (that starts the studio, which takes most of the machine's memory from "
                               "other apps).", error=True)
        return self.wait_outcome(jid, t0 + self.budget(args.get("wait_s")), saver, call)

    def t_fetch(self, args, call):
        jid = check_id(args["id"])
        saver = self.saver(args.get("out"), args.get("poster", True))
        call.set_phase("downloading")
        try:
            state, info = fetch_clip(self.studio, jid, saver, args.get("wake", False), max(30.0, self.wait_s - 10))
        except Fail as error:
            if "Add --wake" in error.message:
                return text_result(error.message.replace("Add --wake.", "Call fetch again with wake: true if that is "
                                                                        "fine."), error=True)
            raise
        if state in ("queued", "running"):
            return text_result(f'Clip {jid} is still {phase_text(info)}: call wait with id "{jid}" for it.', info)
        return self.outcome(jid, state, info, saver)

    def t_status(self, args, call):
        sb = self.studio.switchboard()
        if args.get("id"):
            jid = check_id(args["id"])
            if asleep(sb):
                return text_result(f"{asleep_text(sb)}; its clips can be read once it runs again (fetch with wake: "
                                   "true starts it).", {"switchboard": sb})
            try:
                rec = self.studio.json("GET", f"/api/jobs/{jid}", timeout=SIDE_S)
            except Fail as error:
                if error.http_status == 404:
                    raise Fail(f"No clip with id {jid} on the studio (it may have been deleted).") from None
                raise
            text = status_line(rec)
            if rec.get("labels"):
                text += f"\nLabels: {labels_text(rec)}"
            return text_result(text, rec)
        with self.clips_lock:
            mine = list(self.clips)[-20:]
        jobs = None if asleep(sb) else overview(self.studio)
        known = {j["id"]: j for j in jobs or []}
        lines, session = [], []
        for sub in mine:
            entry = dict(sub.fields, id=sub.id, submitted=round(sub.time, 1))
            if sub.id is None:
                entry["state"] = "submitting"
                lines.append(f"(being submitted, {mmss(time.time() - sub.time)})  {sub.fields.get('task')}")
            else:
                rec = known.get(sub.id)
                if rec is None and jobs is not None:
                    try:
                        rec = self.studio.json("GET", f"/api/jobs/{sub.id}", timeout=SIDE_S)
                    except Fail:
                        rec = None
                if rec is not None:
                    entry.update(state=rec.get("state"), phase=rec.get("phase"))
                if sub.path:
                    entry["path"] = sub.path
                lines.append((status_line(rec) if rec else sub.id) + (f"  saved {sub.path}" if sub.path else ""))
            session.append(entry)
        text = ("Submitted from this session (oldest first):\n" + "\n".join(lines) + "\n\n") if lines else ""
        if jobs is None:
            return text_result(f"{text}{asleep_text(sb)[0].upper()}{asleep_text(sb)[1:]}: the queue can be read once "
                               "it runs again.", {"session": session, "switchboard": sb})
        text += "The queue and the newest clips:\n" + ("\n".join(status_line(j) for j in jobs) or "no clips yet")
        return text_result(text, {"session": session, "jobs": jobs})

    def t_cancel(self, args, call):
        jid = check_id(args["id"])
        sb = self.studio.switchboard()
        if asleep(sb):
            raise Fail(f"{asleep_text(sb)}, so no clip is queued or running there.")
        try:
            answer = self.studio.json("POST", "/api/cancel", {"id": jid}, timeout=SIDE_S)
        except Fail as error:
            if error.http_status == 404:
                raise Fail(f"No clip with id {jid} on the studio.") from None
            raise
        job = answer.get("job") or {}
        if job.get("status") == "cancelled":
            return text_result(f"{noun(job)} {jid} was cancelled (it had not started).", job)
        if is_upscale(job):
            return text_result(f"Upscale {jid} is being cancelled: its job stops within about 20 s.", job)
        return text_result(f"Clip {jid} is being cancelled: it stops once the pipeline has closed (about 40 s); the "
                           "next clip then loads the models again.", job)

    def t_upscale(self, args, call):
        jid, t0 = check_id(args["id"]), time.time()
        budget = self.budget(args.get("wait_s"))
        saver = self.saver(args.get("out"), args.get("poster", True))
        call.set_phase("queueing the upscale (held while the studio starts)")
        body = upscale_body(jid, args.get("resolution"), args.get("strength"), args.get("audio"), args.get("seed"))
        try:
            answer = submit_upscale(self.studio, body, max(0.0, budget - 15))
        except Fail as error:
            error.message = error.message.replace("try again in about", "call upscale again in about").replace(
                "check with: lf-cli status", "call status without an id to see it")
            raise
        uid, rec = answer["id"], answer.get("job") or {"id": answer["id"], "kind": "upscale", "state": "queued"}
        self.log(f"queued upscale {uid} of clip {jid}")
        call.check()
        prefix = f"Queued upscale {uid} of clip {jid} ({rec.get('resolution')}, {rec.get('strength')}). "
        if args.get("wait_s") == 0 or time.time() >= t0 + budget:
            return self.outcome(uid, rec.get("state", "queued"), rec, saver, prefix)
        return self.wait_outcome(uid, t0 + budget, saver, call, prefix)

    def t_guide(self, args, call):
        return {"content": [{"type": "text", "text": GUIDE}], "isError": False}


def _key(mid):
    """A request id as a dict key (ids are strings or numbers)."""
    return json.dumps(mid)


# ---- main --------------------------------------------------------------------------------------------------------
def parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--url", default=argparse.SUPPRESS,
                        help="the studio, e.g. http://<spark-host>:8190 (default: $LFSTUDIO_URL, else "
                             "$LFSTUDIO_HOST and $LFSTUDIO_PORT, else http://127.0.0.1:8190)")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="stdout: one JSON object (the clip's record, with path when saved; or the error)")
    common.add_argument("--quiet", "-q", action="store_true", default=argparse.SUPPRESS,
                        help="no progress lines on stderr")
    ap = argparse.ArgumentParser(prog="lf-cli", parents=[common],
                                 description="Make clips on an LF Studio: a CLI, and an MCP server (lf-cli mcp).",
                                 epilog="exit codes: 0 ok; 1 the clip failed or was cancelled; 2 usage, a file check "
                                        "or a refusal by the studio; 3 the studio is unreachable, unavailable or "
                                        "stopped; 4 --timeout ran out (the clip still runs); 130 interrupted")
    ap.add_argument("--version", action="version", version=f"lf-cli {VERSION}")
    sub = ap.add_subparsers(dest="command", metavar="command")
    sub.required = True
    g = sub.add_parser("generate", parents=[common], help="queue a clip (with --wait or --out: and save it)")
    prompt = g.add_mutually_exclusive_group(required=True)
    prompt.add_argument("--prompt", help="the prompt (H3's format: lf-cli guide)")
    prompt.add_argument("--prompt-file", metavar="FILE", help="read the prompt from FILE (- = stdin)")
    g.add_argument("--task", choices=TASKS, help="default: fl2va with frames, ref2va with --ref, else t2va")
    g.add_argument("--orientation", choices=ORIENTATIONS,
                   help="default: from the first keyframe's shape, else landscape")
    g.add_argument("--seconds", type=int, choices=DURATIONS, metavar="S", help="5, 6, 7, 8, 10, 12 or 15 "
                                                                              "(default 5)")
    g.add_argument("--seed", type=int, metavar="N", help="default: random")
    g.add_argument("--first-frame", metavar="FILE|URL", help="fl2va: the first frame (an image)")
    g.add_argument("--last-frame", metavar="FILE|URL", help="fl2va: the last frame (an image)")
    g.add_argument("--ref", action="append", metavar="FILE|URL",
                   help="ref2va: a reference image, video or audio file (repeat; numbered in order per kind)")
    g.add_argument("--wait", action="store_true", help="wait for the clip and save the MP4 (into the current "
                                                       "directory unless --out)")
    g.add_argument("--out", metavar="PATH", help="the MP4 file, or a directory for it (implies --wait)")
    g.add_argument("--poster", action="store_true", help="also save the poster frame as <out stem>.jpg")
    g.add_argument("--timeout", type=float, default=0, metavar="S", help="give up waiting after S seconds (exit 4; "
                                                                         "the clip keeps running); 0 = no limit")
    g.add_argument("--hold", type=float, default=HOLD_S, metavar="S",
                   help=f"how long spark-switchboard may hold the upload while it starts the studio (default "
                        f"{HOLD_S})")
    w = sub.add_parser("wait", parents=[common], help="wait for a clip and save its MP4")
    w.add_argument("id")
    w.add_argument("--out", metavar="PATH", help="the MP4 file, or a directory for it (default: here)")
    w.add_argument("--poster", action="store_true", help="also save the poster frame as <out stem>.jpg")
    w.add_argument("--timeout", type=float, default=0, metavar="S", help="give up after S seconds (exit 4)")
    s = sub.add_parser("status", parents=[common], help="a clip's state, or the queue and the newest clips")
    s.add_argument("id", nargs="?")
    c = sub.add_parser("cancel", parents=[common], help="cancel a queued or running clip")
    c.add_argument("id")
    f = sub.add_parser("fetch", parents=[common], help="save an existing clip's MP4")
    f.add_argument("id")
    f.add_argument("--out", metavar="PATH", help="the MP4 file, or a directory for it (default: here)")
    f.add_argument("--poster", action="store_true", help="also save the poster frame as <out stem>.jpg")
    f.add_argument("--wake", action="store_true",
                   help="start the studio if spark-switchboard has stopped it (it needs most of the machine's memory)")
    u = sub.add_parser("upscale", parents=[common],
                       help="experimental: upscale a finished 5 s text clip, 16:9 or 9:16, to 1080p, 2K or 4K (with "
                            "--wait or --out: and save it)")
    u.add_argument("id", help="the finished clip")
    u.add_argument("--resolution", choices=UPSCALE_RESOLUTIONS, help="default 2k (2560x1440, or 1440x2560 for 9:16)")
    u.add_argument("--strength", choices=UPSCALE_STRENGTHS,
                   help="how much it may redraw (default: the studio's); full redraws faces into another person")
    u.add_argument("--audio", choices=UPSCALE_AUDIO,
                   help="what the picture is refined against (default: the studio's); the result has the clip's "
                        "sound either way")
    u.add_argument("--seed", type=int, metavar="N", help="the refine's seed (default: the clip's)")
    u.add_argument("--wait", action="store_true", help="wait for the upscale and save the MP4 (into the current "
                                                       "directory unless --out)")
    u.add_argument("--out", metavar="PATH", help="the MP4 file, or a directory for it (implies --wait)")
    u.add_argument("--poster", action="store_true", help="also save the poster frame as <out stem>.jpg")
    u.add_argument("--timeout", type=float, default=0, metavar="S", help="give up waiting after S seconds (exit 4; "
                                                                         "the upscale keeps running); 0 = no limit")
    u.add_argument("--hold", type=float, default=HOLD_S, metavar="S",
                   help=f"how long spark-switchboard may hold the request while it starts the studio (default "
                        f"{HOLD_S})")
    sub.add_parser("guide", parents=[common], help="print the prompt guide for H3")
    sub.add_parser("mcp", parents=[common], help="run the MCP server on stdin/stdout")
    return ap


COMMANDS = {"generate": cmd_generate, "wait": cmd_wait, "status": cmd_status, "cancel": cmd_cancel,
            "fetch": cmd_fetch, "upscale": cmd_upscale, "guide": cmd_guide}


# Until 0.6 the settings may have their names up to 0.4, SOLH3_X for LFSTUDIO_X.
OLD_SETTINGS = ("URL", "HOST", "PORT", "OUT_DIR", "MCP_WAIT_S", "MCP_MAX_WAIT_S", "MCP_OUT_ANYWHERE")


def old_settings():
    """Until 0.6: an old name counts where its new name is not set (the new one wins), with one warning on stderr
    that lists the old names used."""
    used = []
    for name in OLD_SETTINGS:
        old, new = "SOLH3_" + name, "LFSTUDIO_" + name
        if old not in os.environ:
            continue
        value = os.environ.pop(old)
        if new in os.environ:
            used.append(f"{old} ({new} wins)")
        else:
            os.environ[new] = value
            used.append(old)
    if used:
        print(f"lf-cli: settings under their 0.4 names, which work until 0.6: {', '.join(used)}. Rename them "
              "LFSTUDIO_*", file=sys.stderr, flush=True)


def main(argv=None):
    args = parser().parse_args(argv)
    old_settings()
    output = Output(args)
    if args.command == "mcp":
        try:
            server = McpServer(getattr(args, "url", None))
        except Fail as error:
            print(f"lf-cli mcp: {error.message}", file=sys.stderr)
            return 2
        server.run()
        return 0
    try:
        studio = None if args.command == "guide" else Studio(studio_url(getattr(args, "url", None)))
        return COMMANDS[args.command](studio, args, output)
    except Fail as error:
        output.failure(error)
        return error.code
    except KeyboardInterrupt:
        print("lf-cli: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
