#!/usr/bin/env python3
"""lf-cli: make clips on an LF Studio from scripts and agents: a command line, and an MCP server for agent hosts.

One file, standard library only, Python 3.9 or later: copy it to any machine that can reach the studio.

  lf-cli generate (--prompt TEXT | --prompt-file FILE|-) [--task t2va|fl2va|ref2va]
         [--orientation landscape|portrait] [--seconds 5|6|7|8|10|12|15] [--seed N]
         [--first-frame FILE|URL] [--last-frame FILE|URL] [--ref FILE|URL]...
         [--wait] [--out PATH] [--poster] [--timeout S] [--hold S]
  lf-cli wait ID [--out PATH] [--poster] [--timeout S]
  lf-cli status [ID]
  lf-cli cancel ID
  lf-cli fetch ID [--out PATH] [--poster] [--wake]
  lf-cli upscale ID [--resolution 1080p|2k|4k] [--strength faithful|balanced|full]
         [--audio clip|silence] [--seed N] [--wait] [--out PATH] [--poster] [--timeout S] [--hold S]
                                experimental: a finished 5 s text clip, 16:9 or 9:16, to 1080p, 2K or 4K, on a
                                studio with LFSTUDIO_UPSCALE=1 (about 10 min to 1.6 h in all, 4K over an hour, with
                                a ~22 s load; ~8 min more with LFSTUDIO_UPSCALE_LOAD=standard)
  lf-cli guide                  the prompt guide for H3
  lf-cli mcp                    an MCP server on stdin/stdout (Claude Code, Hermes, Codex, ...)
  common options, before or after the command: --url URL  --json  --quiet

The studio: --url, else $LFSTUDIO_URL, else http://$LFSTUDIO_HOST:$LFSTUDIO_PORT (0.0.0.0 counts as 127.0.0.1), else
http://127.0.0.1:8190. Behind spark-switchboard, use its public port (8190).

stdout carries the result and nothing else: the saved MP4's absolute path, the id (generate without waiting), or the
status; --json makes it one JSON object. Progress goes to stderr (--quiet turns it off).
Exit codes: 0 done (and saved), queued, or ok; 1 the clip failed or was cancelled; 2 a usage error, a local file
check, or the studio refused the request (also a studio with its API for programs off, LFSTUDIO_API=0); 3 the studio
can't be reached or isn't available, or it is stopped (fetch without --wake); 4 --timeout ran out (the clip still runs;
its id is on stdout); 130 interrupted (the clip still runs).

MCP settings (the MCP process's environment): LFSTUDIO_URL; LFSTUDIO_OUT_DIR, where MP4s go (default ./lf-clips);
LFSTUDIO_MCP_WAIT_S, how long generate and wait wait by default (50); LFSTUDIO_MCP_MAX_WAIT_S, the cap on any wait_s
(1800); LFSTUDIO_MCP_OUT_ANYWHERE=1 lets "out" point outside LFSTUDIO_OUT_DIR and the working directory.
Until 0.6 the settings may also have their names up to 0.4 (SOLH3_URL for LFSTUDIO_URL, and so on), and this file
its name up to 0.4, sol-h3 (bin/sol-h3 runs it).
Docs: docs/API.md in https://github.com/slogonomo/lf-studio
"""
import argparse
import base64
import hashlib
import http.client
import json
import math
import os
import re
import signal
import socket
import ssl
import struct
import sys
import threading
import time
import traceback
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

VERSION = "0.5.0"
AGENT = f"lf-cli/{VERSION}"
TASKS = ("t2va", "fl2va", "ref2va")
ORIENTATIONS = ("landscape", "portrait")
DURATIONS = (5, 6, 7, 8, 10, 12, 15)    # 3 and 4 s went after 0.5.0
SIZES = {"landscape": (1344, 768), "portrait": (768, 1344)}
FINISHED = ("done", "failed", "cancelled")
# the experimental Upscale (POST /api/upscale, docs/API.md): what a request may ask for; the studio's defaults are
# 2k, its LFSTUDIO_UPSCALE_STRENGTH and LFSTUDIO_UPSCALE_AUDIO, and the clip's seed
UPSCALE_RESOLUTIONS = ("1080p", "2k", "4k")
UPSCALE_STRENGTHS = ("faithful", "balanced", "full")
UPSCALE_AUDIO = ("clip", "silence")
FRAMES = ("first_frame", "last_frame")
IMG = (".png", ".jpg", ".jpeg", ".webp")
VID = (".mp4", ".mov", ".m4v", ".webm", ".mkv")
AUD = (".wav", ".mp3", ".flac", ".m4a", ".ogg")
REF_ZONE = dict([(e, "ref_images") for e in IMG] + [(e, "ref_videos") for e in VID] + [(e, "ref_audio") for e in AUD])
REF_MAX = {"ref_images": 9, "ref_videos": 3, "ref_audio": 3}       # H3's limits for ref2va
REF_TOTAL = 12
# a downloaded file's Content-Type -> its extension, when the URL's path has no known one (the studio's table)
MIME_EXT = {"image/png": ".png", "image/jpeg": ".jpg", "image/jpg": ".jpg", "image/webp": ".webp",
            "video/mp4": ".mp4", "video/quicktime": ".mov", "video/webm": ".webm", "video/x-matroska": ".mkv",
            "video/x-m4v": ".m4v", "audio/wav": ".wav", "audio/x-wav": ".wav", "audio/wave": ".wav",
            "audio/vnd.wave": ".wav", "audio/mpeg": ".mp3", "audio/mp3": ".mp3", "audio/flac": ".flac",
            "audio/x-flac": ".flac", "audio/mp4": ".m4a", "audio/x-m4a": ".m4a", "audio/ogg": ".ogg"}
CTYPE = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp",
         ".mp4": "video/mp4", ".mov": "video/quicktime", ".m4v": "video/x-m4v", ".webm": "video/webm",
         ".mkv": "video/x-matroska", ".wav": "audio/wav", ".mp3": "audio/mpeg", ".flac": "audio/flac",
         ".m4a": "audio/mp4", ".ogg": "audio/ogg"}
MAX_FILES = 199 * 1024 * 1024    # the studio takes 200 MB per request (more breaks the upload); 1 MB is for the form
DOWNLOAD_S = 120                 # per input file given as a URL
HOLD_S = 900                     # X-Switchboard-Wait of a CLI submit: switchboard holds it while it starts the studio
POLL_S = 15                      # one GET /api/jobs/<id>/video?wait=
RETRY_S = 120                    # while waiting: how long connection trouble and switchboard 503s are retried
SIDE_S = 10                      # the poster and other small reads after a download
ID = re.compile(r"[0-9a-f]{32}")
# A studio with its API for programs off (LFSTUDIO_API=0) answers 403 with a message naming the setting to the submits,
# waits, reads and downloads of this client: its form submit carries API_CLIENT, so it is refused before anything is
# queued. The page's endpoints (status without an id, cancel) still work.
API_CLIENT = "X-LFStudio-Client"
API_OFF = ("the studio's API for programs is off (LFSTUDIO_API=0 in the studio's settings): it takes no clips, waits, "
           "clip status reads or downloads from lf-cli and agents. To turn it on, set LFSTUDIO_API=1 there and restart "
           "the studio; its web page works either way.")

GUIDE = """\
LF Studio gives your prompt to MiniMax-H3 unchanged; nothing rewrites it. H3 was trained on a structured
format, and MiniMax calls that format critical to the quality of the result, so write it yourself as below.
Plain prose is accepted. The prompt drives the draft picture and **all of the sound**. The refiner that makes the
final 1344x768 video uses a fixed prompt of its own.

**1. Task, length, format**

- `t2va`: text only. `fl2va`: a first frame, a last frame, or both (images).
  - A keyframe should have the clip's shape (1344x768 or 768x1344, or the same aspect ratio): one of another
    shape is stretched or cropped to fit. Without an orientation, `lf-cli` takes it from the first keyframe's
    shape.
- `ref2va`:
  - up to 9 images, 3 videos (2-15 s each) and 3 audio files, 12 files in total;
  - at least one image or video.
- `seconds`: 5, 6, 7, 8, 10, 12 or 15.
  - H3 was trained on 4-15 s; NVIDIA validated 5 s.
  - Every time in the prompt must fall inside the clip.
- `orientation`: landscape (1344x768) or portrait (768x1344; portrait is not quality-validated).

**2. t2va and fl2va: three fields**

Write these three fields in this order, each as `name: text`, with a blank line between them:

- `integrated_multimodal_description:` everything seen and heard, along the timeline.
  - Start with `[Shot 1]`, the style (live-action, cinematic, 2D-animated, 3D CG, claymation, ...) and the
    opening composition. Shot 1 has no timestamp.
  - Each later shot is `[Shot N] At MM:SS.mmm, the camera cuts to ...`, with cut times increasing and inside the
    clip.
  - A moving camera (push in, pan right, truck left, tracking shot, ...) can take an amplitude and a speed in
    plain words when they matter: "the camera pushes in with small amplitude at slow speed". Leave them out for a
    medium amplitude and a normal speed. A static shot takes neither: "the camera holds a static shot as ...".
- `overall_soundscape:` 1-4 sentences of ambience, physical and non-verbal sounds. No dialogue here. `N/A` only
  for total silence.
- `non_diegetic_music:` 1-3 sentences on the score: instruments, tempo, dynamics, no mood words. `N/A` if there is
  none.

**3. Dialogue, voice-over, on-screen text**

- **Speakers:**
  - Give each one a stable ID, `(S1)` or `(S2)`, or `(S1,S2)` when they speak together.
  - Describe the voice (age, timbre, on or off screen) **outside** the tags.
- **Inside `<d>...</d>`** goes only `[Language]` and the exact words, untranslated:
  `the fisherman with a low, gravelly voice (S1) says: <d>[English] The tide is turning.</d>`
- **Capital first letter:** start the words in each `<d>` with a capital letter, because a lowercase line that
  opens the clip can add a stray syllable at 0 s (measured in the A/B of issue #38; see issue #53).
- **Voice-over:** `says in an off-screen voiceover: <d>[English] ...</d> while his lips remain completely closed`.
- **Cuts and the clip's end** (MiniMax's rule; its guides give no example with these tokens, nor say whether they
  go inside `<d>`):
  - A line of dialogue or lyrics that runs across a cut takes `<scenetrans>` at the connecting point in both
    parts, and a sentence saying that the audio continues across the cut: "continues seamlessly across the cut",
    "continues uninterrupted into the next shot", "carries over from the previous shot" or "remains audible across
    the transition". MiniMax's t2va example has such a sentence: `[Shot 2] At 00:05.000, the camera cuts to a
    close-up of steam rising from the sliced bread while the baker's final words carry over from the previous
    shot.`
  - Speech cut off by the end of the clip takes `<cutoff>`.
- **Text visible in the picture** goes in double quotes, verbatim.
- **Language:** write the sections in English. Dialogue and visible text stay in their own language.

**4. fl2va: the keyframe line comes first**

Start with exactly one of these lines, then a blank line, then the three fields.
- `S.SS` is the clip length with two decimals (8 s → `8.00`).
- `N` is the shot the frame belongs to: the last shot, for a last frame.

- First frame only:
  `For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully referenced.`
- First and last frame:
  `How the reference pictures align with the target video — Picture 1 (from Shot 1) aligns with the 0.00-second mark of the target video; Picture 2 (from Shot N) aligns with the S.SS-second mark of the target video.`
- Last frame only (it is `<Picture 1>`):
  `How the reference pictures align with the target video — <Picture 1> (from [Shot N]) aligns with the S.SS-second mark of the target video.`

Describe how the scene gets from one frame to the other. Don't describe the frames themselves again.

**5. ref2va: six sections and labels**

Sections, in this order, each name on its own line with its text below: `subject_definitions`, `summary`,
`retention_analysis`, `detailed_description`, `overall_soundscape`, `non_diegetic_music`.

- **Labels:**
  - `<Picture N>` numbers the images in the order you send them, and `<Video N>` the videos.
  - A reference video **with a sound track also takes an `<Audio N>` number, just before its own `<Video N>`**.
    Audio files are numbered after the videos' sound tracks.
  - Example: image, video with sound, WAV → `<Picture 1>`, `<Audio 1>` (the video's sound), `<Video 1>`,
    `<Audio 2>` (the WAV).
  - The job's `labels` list shows the numbering the studio used.
- **`<Subject N>`** names visible content you define in `subject_definitions` and reuse. A label keeps one meaning
  in every section.
- **`summary`** starts with a task tag, several joined with ` + `: `[reference generation]`, `[keyframe
  completion]`, `[video editing]`, `[video continuation]`, `[audio reuse]`, `[audio reference]`.
- **`retention_analysis`** has one line per label:
  - for pictures and videos: `fully_preserved`, `partially_preserved`, `attribute_transfer` or `weak_reference`;
  - for audio: `fully_copy`, `partially_copy`, `reference` or `weak_reference`.
- **`detailed_description`**:
  - one or two style sentences, then the shots as in section 2;
  - a speaking subject is written `<Subject 1> (S1)`;
  - generation tasks run 350-500 words.

**6. Examples**

t2va, 5 s:

```text
integrated_multimodal_description: [Shot 1] Live-action, cinematic, a medium shot frames an elderly fisherman in a yellow raincoat mending a net on a wooden pier at dawn. The camera pushes in with small amplitude at slow speed as the fisherman with a low, gravelly voice (S1) looks out to sea and says: <d>[English] The tide is turning.</d> Gulls circle above the grey water behind him.

overall_soundscape: Small waves slap against the pier posts and gulls call in the distance. Wet rope creaks as he pulls the net across his knees.

non_diegetic_music: N/A
```

fl2va, first frame only, 5 s:

```text
For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully referenced.

integrated_multimodal_description: [Shot 1] Live-action, cinematic, the scene opens on the kitchen shown in <Picture 1>, keeping the woman's appearance, the red kettle and the morning window light. The camera holds a static shot as she lifts the kettle and pours steaming water into a white mug, then wraps both hands around it while steam drifts across the window.

overall_soundscape: Water pours into the mug with a rising pitch, then the kettle clinks back onto the stove. Quiet room tone and faint birdsong come through the window.

non_diegetic_music: N/A
```

fl2va, first and last frame, 8 s:

```text
How the reference pictures align with the target video — Picture 1 (from Shot 1) aligns with the 0.00-second mark of the target video; Picture 2 (from Shot 1) aligns with the 8.00-second mark of the target video.

integrated_multimodal_description: [Shot 1] Live-action, cinematic, a wide shot begins in the composition of Picture 1, with the small sailboat moored and its sail furled. The camera trucks left with small amplitude at slow speed as the sailor unties the bow line, hoists the sail and pushes off; the boat drifts away from the dock and settles into the position, sail shape and framing of Picture 2 at the end of the shot.

overall_soundscape: Rope runs through a pulley and canvas flaps as the sail fills. Water laps against the hull while a light breeze moves across the harbor.

non_diegetic_music: N/A
```

fl2va, last frame only, 6 s:

```text
How the reference pictures align with the target video — <Picture 1> (from [Shot 1]) aligns with the 6.00-second mark of the target video.

integrated_multimodal_description: [Shot 1] Live-action, cinematic, a close shot begins on an empty ceramic plate on a wooden café table as a hand enters from the left carrying a slice of cake. The camera pushes in with small amplitude at slow speed while the hand sets the slice down, places a fork beside it and withdraws, and the table settles into the exact arrangement, lighting and framing of <Picture 1>.

overall_soundscape: The plate clinks softly on the table and the fork taps the ceramic rim. Low café chatter continues in the background.

non_diegetic_music: A light solo piano at a moderate tempo that fades out at the end.
```

ref2va, one portrait image then one voice recording (WAV), 5 s. The labels are `<Picture 1>` and `<Audio 1>`:

```text
subject_definitions:
<Subject 1> is the woman in <Picture 1>, with short red hair, round glasses and a green wool coat.
<Audio 1> is the voice-timbre reference for <Subject 1> (S1).

summary:
[reference generation + audio reference] <Subject 1> stands on a snowy city street at night and greets the camera in the voice timbre of <Audio 1>.

retention_analysis:
<Subject 1> (appears in [Shot 1]): fully_preserved - her face, short red hair, round glasses and green wool coat are retained.
<Audio 1>: reference - her voice follows the timbre of <Audio 1> without copying the original signal.

detailed_description:
The target video is a live-action, cinematic night scene on a quiet city street in winter, lit by warm streetlights and the cool glow of shop windows, with a shallow depth of field and soft, slightly desaturated colors.
[Shot 1] A static medium shot frames <Subject 1> (S1), the woman with short red hair, round glasses and a green wool coat, standing on a snow-covered sidewalk under a single streetlight, centered in the frame from the waist up. Behind her the street falls out of focus: a row of closed shops with lit windows, parked cars under a thin layer of snow, and the red tail lights of a car passing slowly from left to right. A thin wisp of steam rises from a street grate behind her and drifts across the lit windows. Large snowflakes drift down through the cone of warm light above her, catching the light as they fall, and a few settle on her red hair, on the rims of her glasses and on the shoulders of her coat. The coat is buttoned to the collar, its wool texture visible in the light, and fresh snow lies on the pavement around her boots. She stands still at first, her hands loose at her sides, then lifts her gaze from the ground to the lens, and her face softens into a warm, slightly tired smile. She takes a small breath that clouds in the cold air and says in the clear, warm voice referenced from <Audio 1>, <d>[English] Welcome back. It has been a long winter.</d> Her delivery is calm and close, with the smile audible in it. As she finishes speaking, she tucks her hands into her coat pockets, shifts her weight onto one foot and tilts her head slightly to the side, still looking into the lens. Her breath keeps rising in small white clouds that drift up through the falling snow and fade in the light. The lenses of her glasses catch a brief reflection of the streetlight as she moves her head. The camera stays still; only the snow, her breath and the distant traffic change across the shot, which ends on her steady, smiling gaze with the snow still falling around her.

overall_soundscape:
Soft wind and the hush of falling snow, with distant traffic on wet pavement.

non_diegetic_music:
N/A
```

Add a reference video with sound after the image, and the labels become `<Picture 1>`, `<Audio 1>` (the video's
sound), `<Video 1>` and `<Audio 2>` (the WAV). The prompt must then use those numbers.

**7. More**

- MiniMax's guides: [base modes](https://huggingface.co/MiniMaxAI/MiniMax-H3/blob/main/docs/VIDEO_PROMPT_WRITING_GUIDE_base_en.md)
  and [reference mode](https://huggingface.co/MiniMaxAI/MiniMax-H3/blob/main/docs/VIDEO_PROMPT_WRITING_GUIDE_ref_en.md).
- Their agent skill [`h3-prompt-writing`](https://github.com/MiniMax-AI/MiniMax-H3/tree/main/skills/h3-prompt-writing)
  rewrites free-form ideas into this format.
"""

INSTRUCTIONS = (
    "LF Studio makes short video clips with sound on one DGX Spark or RTX 5090: 5-15 s, 1344x768 (landscape) or "
    "768x1344 (portrait), 24 fps. One clip renders at a time: on a DGX Spark about 1 min for a 5 s clip to 3:15 for a "
    "15 s clip once the models are loaded, plus about 1-2 min when they must load first (a different task than the "
    "last clip; a new format or length of the same task keeps them loaded and adds up to about 30 s the first time), "
    "plus any queue. Call prompt_guide once and write the prompt in H3's structured format: nothing rewrites it. Then "
    "call generate: it uploads your files (paths on this machine or http(s) URLs), waits up to wait_s seconds and, "
    "when the clip is done, saves the MP4 here and returns its absolute path, its studio URL and a poster frame. "
    "If it answers that the clip is still running, call wait with the id. Cancelling a tool call does not cancel the "
    "clip; use cancel for that. A studio with the experimental Upscale on also takes upscale: a finished 5 s text "
    "clip (16:9 or 9:16) to 1080p, 2K or 4K, which takes about 10 min to 1.6 h or more.")


# ---- small things ------------------------------------------------------------------------------------------------
def mmss(seconds):
    """m:ss, rounded to whole seconds first (no "1:60")."""
    s = int(round(max(0.0, float(seconds))))
    return f"{s // 60}:{s % 60:02d}"


def megabytes(n):
    return f"{n / 1e6:.1f} MB"


def parse_json(data):
    try:
        return json.loads(data)
    except (ValueError, TypeError):
        return None


def is_upscale(rec):
    return rec.get("kind") == "upscale"


def clip_desc(rec):
    if is_upscale(rec):
        return (f"{rec.get('resolution')} upscale of {str(rec.get('parent'))[:8]}, {rec.get('strength')}, "
                f"{rec.get('task')}, {rec.get('seconds')} s, seed {rec.get('seed')}")
    return f"{rec.get('task')}, {rec.get('orientation')}, {rec.get('seconds')} s, seed {rec.get('seed')}"


def noun(rec):
    """What a record is, for a sentence: Clip, or Upscale for the experimental Upscale's jobs."""
    return "Upscale" if is_upscale(rec or {}) else "Clip"


PHASE_TEXT = {"starting": "starting", "generating": "generating", "saving": "saving the clip",
              "retrying": "retrying after a worker error", "cancelling": "cancelling", "running": "running",
              "unloading": "closing the studio's models for the upscale"}


def phase_text(rec):
    """What a clip is doing, in a few words (from an API record)."""
    state, phase = rec.get("state"), rec.get("phase")
    if state == "queued":
        n = rec.get("ahead") or 0
        return "queued, next in line" if n == 0 else f"queued, {n} ahead"
    if state == "running":
        if phase == "loading":
            eta = rec.get("load_eta")
            return "loading models, then generating" + (f" (about {mmss(eta)} in all)" if eta else "")
        if phase == "upscaling":
            return "upscaling" + (f": {rec['upscale_phase']}" if rec.get("upscale_phase") else "")
        return PHASE_TEXT.get(phase, phase or "running")
    if state == "done":
        return f"done in {mmss(rec['wall_s'])}" if rec.get("wall_s") is not None else "done"
    if state == "failed":
        return f"failed: {rec.get('error') or 'no reason given'}"
    return state or "unknown"


def labels_text(rec):
    """The prompt labels of an fl2va or ref2va clip's files, as the studio numbered them."""
    out = []
    for item in rec.get("labels") or []:
        if item.get("sound_of"):
            out.append(f"{item.get('label')} = the sound of {item.get('sound_of')}")
        else:
            out.append(f"{item.get('label')} = {item.get('zone')} {item.get('name')}")
    return "; ".join(out)


def clip_name(rec):
    """The name the studio downloads a clip as (when its answer has none); an upscale's is its clip's (the parent's id)
    with the resolution and its own id after it."""
    if is_upscale(rec):
        return (f"lf-studio_{rec.get('task')}_{rec.get('seconds')}s_seed{rec.get('seed')}_"
                f"{str(rec.get('parent'))[:6]}_{rec.get('resolution')}_{rec.get('id', '')[:6]}.mp4")
    return f"lf-studio_{rec.get('task')}_{rec.get('seconds')}s_seed{rec.get('seed')}_{rec.get('id', '')[:6]}.mp4"


def safe_name(name):
    name = re.sub(r"[^A-Za-z0-9._-]", "_", name).lstrip(".")
    return name if name.lower().endswith(".mp4") else (name or "clip") + ".mp4"


def check_id(jid):
    jid = (jid or "").strip().lower()
    if not ID.fullmatch(jid):
        raise Fail(f"not a clip id: {jid!r} (32 hex characters, as generate prints it)", 2)
    return jid


class Fail(Exception):
    """What went wrong, in words for a person or an agent, with the CLI's exit code. `mcp`: the words for an agent
    when they differ (the MCP server's tools in place of CLI commands)."""

    def __init__(self, message, code=2, http_status=None, jid=None, job=None, mcp=None):
        super().__init__(message)
        self.message, self.code, self.http_status, self.jid, self.job = message, code, http_status, jid, job
        self.mcp = mcp


class Unreachable(Fail):
    """No answer from the studio: a connection error or a timeout. `stage`: where it happened (connect, send: during
    the request body, answer: waiting for or reading the answer)."""

    def __init__(self, message, stage="connect"):
        super().__init__(message, 3)
        self.stage = stage


class Busy(Fail):
    """spark-switchboard answered for the studio, which isn't ready: its JSON error ("error" is an object, with a
    code such as loading, waiting, no_memory, stopped, stopping, paused, failed or upstream_down)."""

    def __init__(self, message, sb_code, http_status, retry):
        super().__init__(message, 3, http_status)
        self.sb_code, self.retry = sb_code, retry


class Stopped(Fail):
    """The studio stopped while a clip was being waited for. By switchboard (the clip most likely finished first:
    lf-cli fetch <id> --wake), or by itself while the clip was still running (after a restart it shows as failed)."""

    def __init__(self, jid, by_switchboard, record):
        rec = record or {}
        if by_switchboard:
            message = (f"spark-switchboard stopped the studio while waiting for clip {jid}; the clip most likely "
                       f"finished first. Get it with: lf-cli fetch {jid} --wake")
        else:
            message = (f"the studio stopped while clip {jid} was {rec.get('phase') or rec.get('state') or 'running'}; "
                       "after a restart it shows as failed")
        super().__init__(message, 3, 503, jid, record)
        self.by_switchboard = by_switchboard


# ---- the studio --------------------------------------------------------------------------------------------------
def studio_url(given=None):
    """--url, $LFSTUDIO_URL, $LFSTUDIO_HOST/$LFSTUDIO_PORT (as bin/lf-studio's health check reads them), or the
    default."""
    if given:
        return given
    if os.environ.get("LFSTUDIO_URL"):
        return os.environ["LFSTUDIO_URL"]
    host, port = os.environ.get("LFSTUDIO_HOST", "").strip(), os.environ.get("LFSTUDIO_PORT", "").strip()
    if not (host or port):
        return "http://127.0.0.1:8190"
    if host in ("", "0.0.0.0"):
        host = "127.0.0.1"
    elif host in ("::", "[::]"):
        host = "[::1]"
    elif ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"http://{host}:{port or 8190}"


def reason(error):
    if isinstance(error, ConnectionRefusedError):
        return "connection refused"
    if isinstance(error, socket.gaierror):
        return f"unknown host ({error.strerror or error})"
    return str(error) or type(error).__name__


class Studio:
    """The studio's HTTP API (directly, or through spark-switchboard)."""

    def __init__(self, url, agent=AGENT):
        u = urllib.parse.urlsplit(url.strip())
        try:
            port = u.port
        except ValueError:
            port = -1
        if u.scheme not in ("http", "https") or not u.hostname or port == -1:
            raise Fail(f"the studio URL must look like http://host:port, not {url!r}", 2)
        self.url = url.strip().rstrip("/")
        self.https = u.scheme == "https"
        self.host, self.port = u.hostname, port or (443 if self.https else 80)
        self.prefix = u.path.rstrip("/")
        self.agent = agent

    def open(self, method, path, body=None, headers=None, timeout=30, sent=None):
        """Send one request (body: a list of bytes chunks, sent 1 MiB at a time, `sent(n)` after each). Returns
        (response, connection); the caller reads the response and closes the connection. Raises Unreachable."""
        if self.https:
            conn = http.client.HTTPSConnection(self.host, self.port, timeout=timeout,
                                               context=ssl.create_default_context())
        else:
            conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
        h = {"User-Agent": self.agent, "Accept": "application/json"}
        h.update(headers or {})
        stage = "connect"
        try:
            conn.putrequest(method, self.prefix + path, skip_accept_encoding=True)
            for k, v in h.items():
                conn.putheader(k, v)
            if body is not None:
                conn.putheader("Content-Length", str(sum(len(c) for c in body)))
            conn.endheaders()                 # connects, and sends the request line and headers
            stage, done = "send", 0
            for chunk in body or []:
                view = memoryview(chunk)
                for i in range(0, len(view), 1 << 20):
                    piece = view[i:i + (1 << 20)]
                    conn.send(piece)
                    done += len(piece)
                    if sent:
                        sent(done)
            stage = "answer"
            return conn.getresponse(), conn
        except (socket.timeout, OSError, http.client.HTTPException) as error:
            if stage == "send" and isinstance(error, (BrokenPipeError, ConnectionResetError)):
                try:                          # the studio may have answered early (413, 421) and closed
                    return conn.getresponse(), conn
                except (OSError, http.client.HTTPException):
                    pass
            conn.close()
            if isinstance(error, socket.timeout):
                what = {"connect": f"no connection to the studio at {self.url} within {timeout:g} s",
                        "send": f"the upload to {self.url} stalled (nothing went through for {timeout:g} s)",
                        "answer": f"no answer from the studio at {self.url} within {timeout:g} s"}[stage]
            else:
                what = {"connect": f"can't reach the studio at {self.url}",
                        "send": f"the connection to {self.url} broke during the upload",
                        "answer": f"the studio at {self.url} closed the connection without an answer"}[stage]
                what += f" ({reason(error)})"
            raise Unreachable(what, stage) from None

    def call(self, method, path, body=None, headers=None, timeout=30, sent=None):
        """One request, read whole: (status, headers, bytes). Raises Unreachable."""
        resp, conn = self.open(method, path, body, headers, timeout, sent)
        try:
            return resp.status, resp.headers, resp.read()
        except socket.timeout:
            raise Unreachable(f"the studio at {self.url} stopped answering (no data for {timeout:g} s)",
                              "answer") from None
        except (OSError, http.client.HTTPException) as error:
            raise Unreachable(f"the answer from {self.url} broke off ({reason(error)})", "answer") from None
        finally:
            conn.close()

    def json(self, method, path, body=None, timeout=30):
        """A JSON request (body: a dict) whose answer must be 200 JSON; anything else raises its refusal()."""
        data = None if body is None else [json.dumps(body).encode()]
        headers = {"Content-Type": "application/json"} if body is not None else {}
        status, headers, raw = self.call(method, path, data, headers, timeout)
        obj = parse_json(raw)
        if status != 200 or not isinstance(obj, dict):
            raise refusal(status, headers, raw)
        return obj

    def switchboard(self):
        """spark-switchboard's view of the studio from GET /__switchboard/status, which never starts it: a dict with
        "state" (stopped, starting, ready, stopping, failed), "paused" and "message". None when the studio is not
        behind switchboard (the studio itself answers that path with 404)."""
        status, _, raw = self.call("GET", "/__switchboard/status", timeout=SIDE_S)
        obj = parse_json(raw)
        return obj if status == 200 and isinstance(obj, dict) and "state" in obj else None


def asleep(sb):
    """Whether switchboard has the studio stopped, so that a request for it would start it (most of the machine's
    memory)."""
    if not sb:
        return False
    return sb.get("state") in ("stopped", "stopping", "failed") or bool(sb.get("paused")) and sb.get("state") != "ready"


def asleep_text(sb):
    state = sb.get("state")
    what = {"stopped": "is stopped", "stopping": "is stopping", "failed": "failed to start"}.get(state, f"is {state}")
    if sb.get("paused"):
        what += " (switchboard is paused)"
    message = (sb.get("message") or "").strip()
    return f"the studio {what}" + (f" (spark-switchboard: {message})" if message else "")


def refusal(status, headers, raw):
    """The error in an answer that is not what was asked for: Busy for switchboard's shape, else Fail with the studio's
    message (exit 2 for a refusal, 3 for 429 and 5xx)."""
    obj = parse_json(raw)
    err = obj.get("error") if isinstance(obj, dict) else None
    if isinstance(err, dict):
        sb = obj.get("switchboard") if isinstance(obj.get("switchboard"), dict) else {}
        retry = headers.get("Retry-After") or sb.get("retry_after_s")
        return Busy(str(err.get("message") or f"HTTP {status}"), err.get("code"), status, retry)
    if isinstance(err, str):
        message = err
    else:
        message = raw.decode("utf-8", "replace").strip()[:300] or f"HTTP {status}"
    if status == 403 and isinstance(err, str) and "LFSTUDIO_API=0" in err:
        message = API_OFF
    if status == 429 and headers.get("Retry-After"):
        message += f" (Retry-After: {headers.get('Retry-After')} s)"
    code = 2 if 400 <= status < 500 and status != 429 else 3
    return Fail(message, code, status, job=obj.get("job") if isinstance(obj, dict) else None)


# ---- input files -------------------------------------------------------------------------------------------------
def is_url(ref):
    return bool(re.match(r"(?i)https?://", ref))


def extension(name):
    return os.path.splitext(name)[1].lower()


def read_timeout(resp, seconds):
    """Set the socket timeout for the next reads of a urllib response (its socket is not public; left as it is if
    it can't be reached)."""
    sock = getattr(getattr(getattr(resp, "fp", None), "raw", None), "_sock", None)
    if sock is not None:
        sock.settimeout(max(0.1, seconds))


def download_input(url, label, budget, check=None):
    """An input file given as a URL, downloaded by this process (so tailnet and LAN addresses work): (name, bytes).
    The type comes from the URL path's extension when it is a known one, else from Content-Type. At most DOWNLOAD_S
    seconds, also from a server that trickles: each read is one receive, with the socket timeout cut to the time
    left. check() runs between reads (an MCP call that was cancelled raises there)."""
    deadline = time.time() + DOWNLOAD_S
    too_slow = f"{label}: downloading {url} took longer than {DOWNLOAD_S} s"
    chunks, n = [], 0
    try:
        req = urllib.request.Request(url, headers={"User-Agent": AGENT, "Accept": "*/*"})
        with urllib.request.urlopen(req, timeout=30) as r:
            length = r.headers.get("Content-Length", "")
            if length.isdigit() and int(length) > budget:
                raise Fail(f"{label}: {url} is {megabytes(int(length))}; the files may total 199 MB", 2)
            while True:
                left = deadline - time.time()
                if left <= 0:
                    raise Fail(too_slow, 2)
                if check is not None:
                    check()
                read_timeout(r, min(30.0, left))
                chunk = r.read1(1 << 16)
                if not chunk:
                    break
                n += len(chunk)
                if n > budget:
                    raise Fail(f"{label}: {url} is larger than the 199 MB the files may total", 2)
                chunks.append(chunk)
            final, ctype = r.geturl(), (r.headers.get("Content-Type") or "").split(";")[0].strip().lower()
    except urllib.error.HTTPError as error:
        raise Fail(f"{label}: could not download {url}: HTTP {error.code}", 2) from None
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as error:
        if time.time() >= deadline:                 # the socket timeout cut to the deadline
            raise Fail(too_slow, 2) from None
        why = error.reason if isinstance(error, urllib.error.URLError) else error
        raise Fail(f"{label}: could not download {url} ({why})", 2) from None
    segment = urllib.parse.unquote(urllib.parse.urlsplit(final).path.rsplit("/", 1)[-1])
    if extension(segment) in CTYPE:
        name = segment
    elif ctype in MIME_EXT:
        name = (os.path.splitext(segment)[0] or "download") + MIME_EXT[ctype]
    else:
        raise Fail(f"{label}: can't tell what kind of file {url} is (no known extension in its path, Content-Type "
                   f"{ctype or 'missing'}); download it and give the file instead", 2)
    return name, b"".join(chunks)


def read_input(ref, label, allowed, budget, check=None):
    """One input file: a path on this machine or an http(s) URL. Returns (name, bytes)."""
    if is_url(ref):
        name, data = download_input(ref, label, budget, check)
    else:
        p = Path(ref).expanduser()
        if not p.is_file():
            where = "" if p.is_absolute() else f" (looked for {os.path.abspath(p)})"
            raise Fail(f"{label}: no such file: {ref}{where}", 2)
        if extension(p.name) in allowed and p.stat().st_size > budget:
            raise Fail(f"{label}: {ref} is {megabytes(p.stat().st_size)}; the files may total 199 MB", 2)
        name, data = p.name, (p.read_bytes() if extension(p.name) in allowed else b"")
    if extension(name) not in allowed:
        raise Fail(f"{label}: unsupported file type {extension(name) or '(none)'} in {name} (allowed: "
                   f"{' '.join(allowed)})", 2)
    if not data:
        raise Fail(f"{label}: {ref} is empty", 2)
    return name, data


def exif_orientation(tiff):
    """The Orientation tag (1-8) of an EXIF block (the TIFF data after "Exif\\0\\0"), or None."""
    if tiff[:2] not in (b"II", b"MM") or len(tiff) < 8:
        return None
    e = "<" if tiff[:2] == b"II" else ">"
    offset = struct.unpack(e + "I", tiff[4:8])[0]
    if offset + 2 > len(tiff):
        return None
    for i in range(struct.unpack(e + "H", tiff[offset:offset + 2])[0]):
        entry = tiff[offset + 2 + 12 * i:offset + 14 + 12 * i]
        if len(entry) < 12:
            return None
        if struct.unpack(e + "H", entry[:2])[0] == 0x0112:
            return struct.unpack(e + "H", entry[8:10])[0]
    return None


def png_orientation(data):
    """The EXIF Orientation in a PNG's eXIf chunk (TIFF data), or None."""
    i = 8
    while i + 8 <= len(data):
        length, name = struct.unpack(">I4s", data[i:i + 8])
        if name == b"eXIf":
            return exif_orientation(data[i + 8:i + 8 + length])
        if name == b"IEND":
            return None
        i += 12 + length                                 # length, type, data, CRC
    return None


def webp_orientation(data):
    """The EXIF Orientation in an extended WebP's EXIF chunk (TIFF data, "Exif\\0\\0" before it allowed), or None.
    libwebp reads that chunk only when the VP8X header's EXIF flag is set."""
    if not data[20] & 0x08:
        return None
    i = 12
    while i + 8 <= len(data):
        name, length = struct.unpack("<4sI", data[i:i + 8])
        if name == b"EXIF":
            tiff = data[i + 8:i + 8 + length]
            return exif_orientation(tiff[6:] if tiff[:6] == b"Exif\x00\x00" else tiff)
        i += 8 + length + (length & 1)                   # a chunk is padded to an even size
    return None


def image_size(data):
    """(width, height) of a PNG, JPEG or WebP as it is shown, from its header: with its EXIF rotation applied (JPEG
    APP1, PNG eXIf, WebP EXIF), as the pipeline's loader does. None if it can't be read."""
    try:
        size, rotation = None, None
        if data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR":
            size = struct.unpack(">II", data[16:24])
            rotation = png_orientation(data)
        elif data[:2] == b"\xff\xd8":
            i = 2
            while i + 4 <= len(data) and size is None:
                if data[i] != 0xFF:
                    return None
                marker = data[i + 1]
                if marker == 0xFF:                       # fill byte
                    i += 1
                    continue
                if marker in (0x01, 0xD8) or 0xD0 <= marker <= 0xD7:
                    i += 2
                    continue
                if marker in (0xD9, 0xDA):              # end, or the image data: no frame header before it
                    return None
                length = struct.unpack(">H", data[i + 2:i + 4])[0]
                segment = data[i + 4:i + 2 + length]
                if marker == 0xE1 and segment[:6] == b"Exif\x00\x00":
                    rotation = exif_orientation(segment[6:])
                if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    height, width = struct.unpack(">HH", segment[1:5])
                    size = (width, height)
                i += 2 + length
        elif data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            kind = data[12:16]
            if kind == b"VP8 " and data[23:26] == b"\x9d\x01\x2a":
                size = (struct.unpack("<H", data[26:28])[0] & 0x3FFF, struct.unpack("<H", data[28:30])[0] & 0x3FFF)
            elif kind == b"VP8L" and data[20] == 0x2F:
                bits = struct.unpack("<I", data[21:25])[0]
                size = ((bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1)
            elif kind == b"VP8X":
                size = (int.from_bytes(data[24:27], "little") + 1, int.from_bytes(data[27:30], "little") + 1)
                rotation = webp_orientation(data)
    except (struct.error, IndexError):
        return None
    if size is None:
        return None
    return (size[1], size[0]) if rotation in (5, 6, 7, 8) else tuple(size)


def build_request(prompt, task=None, orientation=None, seconds=None, seed=None, first_frame=None, last_frame=None,
                  references=(), names=None, check=None):
    """A clip request, checked here before anything is uploaded: loads the files (downloading URLs), takes the task
    from the files when it is not given, and checks the task against the files, the types, H3's reference counts and
    the 200 MB the studio takes. Without an orientation, a keyframe's shape picks it. Returns a dict: fields (the
    form's), files [(zone, name, bytes)], notes and warnings (lines for the person or agent), bytes, videos (the
    number of reference videos), hashes (SHA-256 of each file). `names` maps first_frame, last_frame and reference
    to the words the messages use for them (reference: a function of the list index); check() runs during downloads.
    Raises Fail (exit 2)."""
    names = names or {"first_frame": "first_frame", "last_frame": "last_frame", "reference": "references[{}]".format}
    try:
        prompt.encode("utf-8")
    except UnicodeEncodeError as error:         # a lone surrogate: from JSON's "\ud83c", or argv bytes not in UTF-8
        raise Fail(f"the prompt is not valid text at character {error.start + 1} (half of an emoji, or bytes that "
                   "are not UTF-8)", 2) from None
    frames = [(zone, ref) for zone, ref in (("first_frame", first_frame), ("last_frame", last_frame)) if ref]
    references = list(references or [])
    if frames and references:
        raise Fail(f"{names[frames[0][0]]} and references can't go together: fl2va takes frames, ref2va references", 2)
    if task is not None and task not in TASKS:
        raise Fail(f"task must be one of {', '.join(TASKS)}", 2)
    if orientation is not None and orientation not in ORIENTATIONS:
        raise Fail("orientation must be landscape or portrait", 2)
    if seconds is not None and seconds not in DURATIONS:
        raise Fail(f"seconds must be one of {', '.join(map(str, DURATIONS))}", 2)
    task = task or ("fl2va" if frames else "ref2va" if references else "t2va")
    if task == "t2va" and (frames or references):
        raise Fail("t2va takes no files: leave the task out, or use fl2va (frames) or ref2va (references)", 2)
    if task == "fl2va" and references:
        raise Fail("references are used only by ref2va", 2)
    if task == "ref2va" and frames:
        raise Fail(f"{names[frames[0][0]]} is used only by fl2va", 2)
    budget, files = MAX_FILES, []
    for zone, ref in frames:
        name, data = read_input(ref, names[zone], IMG, budget, check)
        budget -= len(data)
        files.append((zone, name, data))
    for i, ref in enumerate(references):
        name, data = read_input(ref, names["reference"](i), IMG + VID + AUD, budget, check)
        budget -= len(data)
        files.append((REF_ZONE[extension(name)], name, data))
    counts = {zone: sum(f[0] == zone for f in files) for zone in REF_MAX}
    if any(counts[z] > REF_MAX[z] for z in REF_MAX) or sum(counts.values()) > REF_TOTAL:
        raise Fail("H3 limits: up to 9 images, 3 videos, 3 audio files, 12 references in total", 2)
    if task == "ref2va" and not (counts["ref_images"] or counts["ref_videos"]):
        raise Fail("ref2va needs at least one reference image or video", 2)
    notes, warnings = [], []
    sizes = [(zone, image_size(data)) for zone, _, data in files if zone in FRAMES]
    known = [(zone, size) for zone, size in sizes if size and size[0] and size[1]]
    if task == "fl2va" and orientation is None and known:
        zone, (w, h) = known[0]
        orientation = "portrait" if h > w else "landscape"
        notes.append(f"{orientation}, from the shape of {names[zone]} ({w}x{h})")
    cw, ch = SIZES[orientation or "landscape"]
    for zone, (w, h) in known:
        if abs((w / h) / (cw / ch) - 1) > 0.05:
            warnings.append(f"{names[zone]} is {w}x{h}, but a {orientation or 'landscape'} clip is {cw}x{ch}: the "
                            f"pipeline stretches or crops it to that shape. Crop it to {cw}x{ch} (or that aspect "
                            "ratio) first for an undistorted clip.")
    fields = {"prompt": prompt, "task": task}
    if orientation:
        fields["orientation"] = orientation
    if seconds is not None:
        fields["seconds"] = str(seconds)
    if seed is not None:
        fields["seed"] = str(seed)
    return {"fields": fields, "files": files, "notes": notes, "warnings": warnings,
            "bytes": sum(len(f[2]) for f in files), "videos": counts["ref_videos"],
            "hashes": [hashlib.sha256(f[2]).hexdigest() for f in files]}


def multipart(fields, files):
    """The page's multipart form, as a list of chunks (the files are not copied)."""
    boundary = "lf-cli-" + uuid.uuid4().hex
    parts = []
    for key, value in fields.items():
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"\r\n\r\n'.encode()
                     + str(value).encode("utf-8") + b"\r\n")
    for zone, name, data in files:
        stem, ext = os.path.splitext(name)
        safe = (re.sub(r"[^A-Za-z0-9._-]", "_", stem)[:60] or "file") + ext.lower()
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{zone}"; filename="{safe}"\r\n'
                     f"Content-Type: {CTYPE.get(ext.lower(), 'application/octet-stream')}\r\n\r\n".encode())
        parts.append(data)
        parts.append(b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    return parts, f"multipart/form-data; boundary={boundary}"


def submit(studio, req, hold, sent=None):
    """POST /api/generate. switchboard holds the request up to `hold` seconds while it starts the studio (a 503 from
    it means the clip was NOT submitted). Returns the studio's answer {"id", "job"}. Raises Fail."""
    parts, ctype = multipart(req["fields"], req["files"])
    headers = {"Content-Type": ctype, "X-Switchboard-Wait": str(int(max(0, min(3600, hold)))),
               API_CLIENT: studio.agent}          # a studio with the API off refuses it (API_OFF)
    timeout = hold + 120 + req["bytes"] / 1e6        # per socket operation; the upload itself may take longer
    try:
        status, rh, raw = studio.call("POST", "/api/generate", parts, headers, timeout, sent)
    except Unreachable as error:
        if error.stage == "send":
            error.message += "; the clip was not submitted"
        elif error.stage == "answer":
            error.message += "; the clip may have been queued all the same (check with: lf-cli status)"
        raise
    obj = parse_json(raw)
    if status == 200 and isinstance(obj, dict) and obj.get("id"):
        return obj
    error = refusal(status, rh, raw)
    if isinstance(error, Busy):
        error.message += f" The clip was NOT submitted; try again in about {error.retry or 60} s."
    raise error


def upscale_body(jid, resolution=None, strength=None, audio=None, seed=None):
    """POST /api/upscale's JSON: the clip and only the choices given (the studio fills in its defaults)."""
    body = {"id": jid}
    for key, value in (("resolution", resolution), ("strength", strength), ("audio", audio), ("seed", seed)):
        if value is not None:
            body[key] = value
    return body


def submit_upscale(studio, body, hold):
    """POST /api/upscale (experimental): queue an upscale of a finished clip as a job of its own. switchboard holds
    the request up to `hold` seconds while it starts the studio, as for generate (a 503 from it means nothing was
    queued). Returns the studio's answer {"id", "job"}. Raises Fail."""
    headers = {"Content-Type": "application/json", "X-Switchboard-Wait": str(int(max(0, min(3600, hold))))}
    try:
        status, rh, raw = studio.call("POST", "/api/upscale", [json.dumps(body).encode()], headers, hold + 60)
    except Unreachable as error:
        if error.stage == "answer":
            error.message += "; the upscale may have been queued all the same (check with: lf-cli status)"
        raise
    obj = parse_json(raw)
    if status == 200 and isinstance(obj, dict) and obj.get("id"):
        return obj
    error = refusal(status, rh, raw)
    if isinstance(error, Busy):
        error.message += f" The upscale was NOT queued; try again in about {error.retry or 60} s."
    raise error


# ---- waiting and saving ------------------------------------------------------------------------------------------
PARTS = set()          # .part files being written (the MCP server removes them if it has to exit)


class Saver:
    """Where a clip's MP4 (and poster) go. The CLI replaces an explicit --out file (a person typed it) and the
    default name in a directory (the same clip). The MCP server (keep=True) never replaces a file: <stem>-1.mp4, ..."""

    def __init__(self, directory=None, file=None, keep=False, poster=False):
        self.directory, self.file, self.keep, self.poster = directory, file, keep, poster

    def target(self, name):
        return self.file if self.file is not None else self.directory / name

    def unwritable(self):
        """Why the MP4 can't be saved where it goes (the directory, or the nearest one above it that exists, to be
        created in, is not writable), or None. Checked before a clip is submitted, so it isn't rendered for
        nothing."""
        d = Path(os.path.abspath(self.file.parent if self.file is not None else self.directory))
        while not d.exists() and d.parent != d:
            d = d.parent
        if not d.is_dir():
            return f"{d} is not a directory"
        if not os.access(d, os.W_OK | os.X_OK):
            return f"no permission to write to {d}"
        return None

    def commit(self, part, final):
        """Move the finished .part into place; returns where it went."""
        if not self.keep:
            os.replace(part, final)
            return final
        for i in range(10000):
            candidate = final if i == 0 else final.with_name(f"{final.stem}-{i}{final.suffix}")
            if self.poster and candidate.with_suffix(".jpg").exists():
                continue
            try:
                os.link(part, candidate)               # fails if the name exists: never replaces a file
            except FileExistsError:
                continue
            except OSError:                            # a file system without hard links
                if candidate.exists():
                    continue
                os.rename(part, candidate)
                return candidate
            os.unlink(part)
            return candidate
        raise Fail(f"no free file name next to {final}", 2)

    def save_poster(self, mp4, data):
        """The poster JPEG next to the MP4 (<stem>.jpg; the MCP server never replaces a file). Returns its path."""
        p = mp4.with_suffix(".jpg")
        try:
            if self.keep:
                with open(p, "xb") as f:
                    f.write(data)
            else:
                p.write_bytes(data)
        except OSError:
            return None
        return p


def save_mp4(resp, conn, saver, jid, rec):
    """Stream a 200 MP4 answer into place: a .part file, its size checked against Content-Length, then committed.
    Returns (path, bytes)."""
    m = re.search(r'filename="([^"]+)"', resp.headers.get("Content-Disposition") or "")
    final = saver.target(safe_name(m.group(1)) if m else clip_name(rec or {"id": jid}))
    part = final.with_name(f".{final.name}.{uuid.uuid4().hex[:8]}.part")
    expected, n = resp.headers.get("Content-Length"), 0
    try:
        final.parent.mkdir(parents=True, exist_ok=True)
        PARTS.add(part)
        with open(part, "wb") as f:
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                n += len(chunk)
        if expected and expected.isdigit() and n != int(expected):
            raise Fail(f"the download of clip {jid} broke off ({n} of {expected} bytes); try again: "
                       f"lf-cli fetch {jid}", 3, jid=jid)
        final = saver.commit(part, final)
    except (socket.timeout, http.client.HTTPException, ConnectionError) as error:
        raise Fail(f"the download of clip {jid} broke off ({reason(error)}); try again: lf-cli fetch {jid}", 3,
                   jid=jid) from None
    except OSError as error:
        what = f"could not save clip {jid} to {final}: {error}. The clip is done on the studio"
        raise Fail(f"{what}: save it with lf-cli fetch {jid} --out <a directory you can write to>", 2, jid=jid,
                   mcp=f'{what}: call fetch with id "{jid}" and an out this server can write to') from None
    finally:
        conn.close()
        PARTS.discard(part)
        try:
            part.unlink()
        except OSError:
            pass
    return Path(os.path.abspath(final)), n


def retry_or_raise(trouble, error, deadline, pause):
    """Connection trouble and switchboard 503s while waiting are retried every 5 s for up to RETRY_S."""
    now = time.time()
    since = trouble[0] if trouble else now
    if now - since >= RETRY_S or (deadline is not None and now + 5 >= deadline):
        raise error
    pause(5)
    return since, error


def wait_for_clip(studio, jid, deadline, saver, report=lambda rec: None, pause=time.sleep, poll_s=POLL_S):
    """Wait for a clip with GET /api/jobs/<id>/video?wait=: once it is done, the studio sends the MP4 on the same
    connection, so a studio stopped right after the clip can't lose the download. Returns ("done", (path, bytes,
    last record)), or (state, record) for failed, cancelled, and queued or running when `deadline` (a time.time(),
    None for no limit) has passed. report(record) gets each record seen (the first at once, then one per poll of up
    to poll_s seconds); pause(s) waits, and may raise to stop (a cancelled MCP call). Raises Fail (Stopped when the
    studio stops meanwhile)."""
    last, trouble = None, None
    while True:
        pause(0)
        left = None if deadline is None else deadline - time.time()
        s = 0.0 if last is None and trouble is None else poll_s       # the first look is at once
        s = s if left is None else max(0.0, min(s, left))
        t = time.time()
        try:
            # passive under switchboard (never starts the studio); a short hold if the studio is starting anyway
            resp, conn = studio.open("GET", f"/api/jobs/{jid}/video?wait={s:.1f}", None,
                                     {"X-Switchboard-Wait": "20"}, timeout=s + 50)
        except Unreachable as error:
            trouble = retry_or_raise(trouble, error, deadline, pause)
            continue
        if resp.status == 200:
            try:
                pause(0)                 # a call cancelled meanwhile saves nothing
            except BaseException:
                conn.close()
                raise
            path, n = save_mp4(resp, conn, saver, jid, last)
            return "done", (path, n, last)
        try:
            status, headers, raw = resp.status, resp.headers, resp.read()
        except (OSError, http.client.HTTPException) as error:
            trouble = retry_or_raise(trouble, Unreachable(f"the answer from {studio.url} broke off ({reason(error)})",
                                                          "answer"), deadline, pause)
            continue
        finally:
            conn.close()
        obj = parse_json(raw)
        obj = obj if isinstance(obj, dict) else {}
        if status == 202 and obj.get("id") == jid:
            trouble, last = None, obj
            report(obj)
            if deadline is not None and time.time() >= deadline:
                return obj.get("state"), obj
            if time.time() - t < s - 1:
                pause(2)                 # back early without the clip settling: a proxy cut the wait short
            continue
        if status == 409 and isinstance(obj.get("job"), dict):
            return obj["job"].get("state"), obj["job"]
        error = refusal(status, headers, raw)
        if isinstance(error, Busy):
            if error.sb_code in ("stopped", "stopping"):
                raise Stopped(jid, True, last)
            if error.sb_code in ("loading", "waiting", "upstream_down") or status == 502:
                trouble = retry_or_raise(trouble, error, deadline, pause)
                continue
            error.jid = jid
            raise error
        if status == 503 and isinstance(obj.get("job"), dict):
            raise Stopped(jid, False, obj["job"])
        if status == 404:
            if obj.get("error") == "no such video":
                raise Fail(f"clip {jid} is done, but its MP4 is no longer on the studio", 2, 404, jid)
            raise Fail(f"no clip with id {jid} on the studio (it may have been deleted)", 2, 404, jid)
        error.jid = jid
        raise error


def clip_record(studio, jid, fallback=None):
    """GET /api/jobs/<id> after a download (best effort: the studio may stop right after a clip)."""
    try:
        status, _, raw = studio.call("GET", f"/api/jobs/{jid}", timeout=SIDE_S)
        obj = parse_json(raw)
        if status == 200 and isinstance(obj, dict):
            return obj
    except Fail:
        pass
    rec = dict(fallback or {"id": jid})
    rec.update(state="done", phase=None)
    rec.pop("ahead", None)
    rec.pop("elapsed_s", None)
    return rec


def poster_bytes(studio, jid):
    """The clip's poster JPEG (/poster/<id>, about 40 KB), or None: it is optional, so any trouble leaves it out."""
    try:
        status, headers, raw = studio.call("GET", f"/poster/{jid}", timeout=SIDE_S)
    except Fail:
        return None
    return raw if status == 200 and raw[:2] == b"\xff\xd8" else None


def fetch_clip(studio, jid, saver, wake, wake_hold):
    """An existing clip's MP4. A studio that switchboard has stopped is started only with `wake` (through /video/<id>,
    held up to wake_hold s); otherwise /api/jobs/<id>/video, which never starts it. Returns what wait_for_clip does
    (deadline: now), or raises Fail (exit 3 for a stopped studio without wake)."""
    sb = studio.switchboard()
    if not asleep(sb):
        return wait_for_clip(studio, jid, time.time(), saver)
    if not wake:
        raise Fail(f"{asleep_text(sb)}; fetching would start it (it needs most of the machine's memory). Add --wake.",
                   3, jid=jid)
    resp, conn = studio.open("GET", f"/video/{jid}", None, {"X-Switchboard-Wait": str(int(wake_hold))},
                             timeout=wake_hold + 60)
    if resp.status == 200:
        path, n = save_mp4(resp, conn, saver, jid, None)
        return "done", (path, n, None)
    try:
        status, headers, raw = resp.status, resp.headers, resp.read()
    finally:
        conn.close()
    if status == 404:                          # the studio runs now: the record says why
        return wait_for_clip(studio, jid, time.time(), saver)
    error = refusal(status, headers, raw)
    error.jid = jid
    raise error


# ---- state of the studio -----------------------------------------------------------------------------------------
STATUS_PHASES = {"starting": "starting", "loading models + generating": "loading", "generating": "generating",
                 "retrying after a worker error": "retrying", "freeing memory": "unloading", "upscaling": "upscaling"}


def overview(studio):
    """The queue and the newest 5 finished clips (GET /api/state), as records with state, phase, ahead, elapsed_s."""
    st = studio.json("GET", "/api/state", timeout=15)
    jobs = [dict(j) for j in st.get("jobs") or [] if isinstance(j, dict)]
    queued = sorted((j for j in jobs if j.get("status") == "queued"),            # clips first, then upscales
                    key=lambda j: (is_upscale(j), j.get("created") or 0))
    for j in jobs:
        status = j.get("status")
        j["phase"] = None
        if status in FINISHED and not j.get("saving"):
            j["state"] = status
        elif status == "queued":
            j["state"], j["ahead"] = "queued", queued.index(j)
        else:
            j["state"] = "running"
            j["phase"] = ("cancelling" if j.get("cancel_requested") else "saving" if j.get("saving")
                          else STATUS_PHASES.get(status, "running"))
            if j.get("started") and st.get("now"):
                j["elapsed_s"] = round(st["now"] - j["started"], 1)
    active = sorted((j for j in jobs if j["state"] in ("queued", "running")), key=lambda j: j.get("created") or 0)
    return active + [j for j in jobs if j["state"] in FINISHED][:5]


def status_line(rec):
    """One clip as a line: id, state, what it is, and what it is doing (or its error)."""
    state, info = rec.get("state"), phase_text(rec)
    if state == "queued":
        info = info.split(", ", 1)[1]
    elif state == "running" and rec.get("elapsed_s") is not None:
        info += f", {mmss(rec['elapsed_s'])} since it started"
    elif state == "failed":
        info = rec.get("error") or "no reason given"
    elif state == "cancelled":
        info = ""
    return f"{rec.get('id')}  {state or '?':<9}  {clip_desc(rec)}  {info}".rstrip()


# ---- the command line --------------------------------------------------------------------------------------------
class Output:
    """stdout: the result only (text, or one JSON object with --json). stderr: progress (not with --quiet),
    warnings and errors."""

    def __init__(self, args):
        self.json, self.quiet = getattr(args, "json", False), getattr(args, "quiet", False)
        self.last = None

    def say(self, text):
        if not self.quiet:
            print(text, file=sys.stderr, flush=True)

    def warn(self, text):
        print(f"lf-cli: warning: {text}", file=sys.stderr, flush=True)

    def track(self, rec):
        """One progress line per change of what the clip is doing."""
        line = (f"queued {rec['id'][:8]} ({clip_desc(rec)}), " + phase_text(rec).split(", ", 1)[1]
                if rec.get("state") == "queued" else phase_text(rec))
        if line != self.last:
            self.say(line)
            self.last = line

    def result(self, text, obj):
        print(json.dumps(obj) if self.json else text, flush=True)

    def failure(self, error):
        print(f"lf-cli: {error.message}", file=sys.stderr, flush=True)
        if self.json:
            obj = {"error": error.message, "http_status": error.http_status, "id": error.jid}
            if error.job:
                obj["job"] = error.job
            print(json.dumps(obj), flush=True)


def cli_saver(out, poster):
    """--out: an existing directory or a path ending in / gets the clip's own name; else it is the file (replaced)."""
    if out is None:
        return Saver(directory=Path.cwd(), poster=poster)
    p = Path(out).expanduser()
    if out.endswith(("/", os.sep)) or p.is_dir():
        return Saver(directory=p, poster=poster)
    return Saver(file=p, poster=poster)


def finish_wait(studio, jid, args, output, saver, deadline):
    """The end of generate --wait, wait and fetch: the outcome as stdout, stderr and the exit code."""
    try:
        if args.command == "fetch":
            state, info = fetch_clip(studio, jid, saver, args.wake, HOLD_S)
        else:
            state, info = wait_for_clip(studio, jid, deadline, saver, output.track)
    except KeyboardInterrupt:
        hint = f"lf-cli wait {jid}" + (f" --out {args.out}" if getattr(args, "out", None) else "")
        print(f"lf-cli: interrupted; the clip keeps running. Get it later with: {hint}", file=sys.stderr, flush=True)
        if output.json:
            print(json.dumps({"error": "interrupted; the clip keeps running", "http_status": None, "id": jid}))
        return 130
    except Fail as error:
        error.jid = error.jid or jid
        raise
    if state == "done":
        path, n, last = info
        rec = clip_record(studio, jid, last)
        output.track(rec)
        result = dict(rec, path=str(path), bytes=n)
        if saver.poster:
            data = poster_bytes(studio, jid)
            poster = saver.save_poster(path, data) if data else None
            if poster:
                result["poster_path"] = str(Path(os.path.abspath(poster)))
            else:
                output.warn(f"no poster for clip {jid} (the studio didn't send one)")
        output.result(str(path), result)
        return 0
    if state in ("queued", "running"):
        if args.command == "fetch":
            hint = f"clip {jid} is still {phase_text(info)}; wait for it with: lf-cli wait {jid}"
        else:
            hint = f"--timeout ran out; clip {jid} is still {phase_text(info)}. Keep waiting with: lf-cli wait {jid}"
        print(f"lf-cli: {hint}", file=sys.stderr, flush=True)
        output.result(jid, {"error": hint, "http_status": None, "id": jid, "job": info})
        return 4
    what = noun(info).lower()
    why = f"{what} {jid} failed: {info.get('error') or 'no reason given'}" if state == "failed" else \
        f"{what} {jid} was cancelled"
    print(f"lf-cli: {why}", file=sys.stderr, flush=True)
    if output.json:
        print(json.dumps({"error": why, "http_status": None, "id": jid, "job": info}), flush=True)
    return 1


def cmd_generate(studio, args, output):
    if args.prompt_file is not None:
        try:
            prompt = sys.stdin.read() if args.prompt_file == "-" else Path(args.prompt_file).expanduser().read_text(
                encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            raise Fail(f"can't read the prompt from {args.prompt_file}: {error}", 2) from None
    else:
        prompt = args.prompt
    if not prompt.strip():
        raise Fail("the prompt is empty", 2)
    if not 0 <= args.hold <= 3600:
        raise Fail("--hold must be 0-3600 seconds", 2)
    req = build_request(prompt, args.task, args.orientation, args.seconds, args.seed, args.first_frame,
                        args.last_frame, args.ref or [],
                        {"first_frame": "--first-frame", "last_frame": "--last-frame",
                         "reference": lambda i: f"--ref #{i + 1}"})
    for note in req["notes"]:
        output.say(f"orientation: {note}")
    for warning in req["warnings"]:
        output.warn(warning)
    wait = args.wait or args.out is not None or args.poster
    saver = cli_saver(args.out, args.poster) if wait else None
    why = saver and saver.unwritable()
    if why:
        raise Fail(f"can't save the clip there: {why}; nothing was submitted (--out picks another place)", 2)
    if req["bytes"] > 10e6:
        output.say(f"uploading {megabytes(req['bytes'])}")
    try:
        answer = submit(studio, req, args.hold)
    except KeyboardInterrupt:
        print("lf-cli: interrupted during the submit; the clip may or may not have been queued (check with: "
              "lf-cli status)", file=sys.stderr, flush=True)
        return 130
    jid, rec = answer["id"], answer.get("job") or {"id": answer["id"]}
    output.track(rec)
    if not wait:
        output.result(jid, rec)
        return 0
    deadline = time.time() + args.timeout if args.timeout > 0 else None
    return finish_wait(studio, jid, args, output, saver, deadline)


def cmd_wait(studio, args, output):
    jid = check_id(args.id)
    sb = studio.switchboard()
    if asleep(sb):
        raise Fail(f"{asleep_text(sb)}, so clip {jid} is not running any more: it most likely finished before. Get "
                   f"it with: lf-cli fetch {jid} --wake", 3, jid=jid)
    deadline = time.time() + args.timeout if args.timeout > 0 else None
    return finish_wait(studio, jid, args, output, cli_saver(args.out, args.poster), deadline)


def cmd_fetch(studio, args, output):
    jid = check_id(args.id)
    return finish_wait(studio, jid, args, output, cli_saver(args.out, args.poster), None)


def cmd_upscale(studio, args, output):
    jid = check_id(args.id)
    if not 0 <= args.hold <= 3600:
        raise Fail("--hold must be 0-3600 seconds", 2)
    if args.seed is not None and not 0 <= args.seed < 2 ** 63:
        raise Fail("--seed must be 0 or more (a 63-bit integer)", 2)
    wait = args.wait or args.out is not None or args.poster
    saver = cli_saver(args.out, args.poster) if wait else None
    why = saver and saver.unwritable()
    if why:
        raise Fail(f"can't save the upscale there: {why}; nothing was queued (--out picks another place)", 2)
    body = upscale_body(jid, args.resolution, args.strength, args.audio, args.seed)
    try:
        answer = submit_upscale(studio, body, args.hold)
    except Fail as error:
        error.jid = error.jid or jid
        raise
    except KeyboardInterrupt:
        print("lf-cli: interrupted during the request; the upscale may or may not have been queued (check with: "
              "lf-cli status)", file=sys.stderr, flush=True)
        return 130
    uid, rec = answer["id"], answer.get("job") or {"id": answer["id"]}
    output.track(rec)
    if not wait:
        output.result(uid, rec)
        return 0
    deadline = time.time() + args.timeout if args.timeout > 0 else None
    return finish_wait(studio, uid, args, output, saver, deadline)


def cmd_status(studio, args, output):
    jid = check_id(args.id) if args.id else None
    sb = studio.switchboard()
    if asleep(sb):
        raise Fail(f"{asleep_text(sb)}; its clips can be read once it runs again", 3, jid=jid)
    if jid:
        try:
            rec = studio.json("GET", f"/api/jobs/{jid}", timeout=SIDE_S)
        except Fail as error:
            if error.http_status == 404:
                raise Fail(f"no clip with id {jid} on the studio (it may have been deleted)", 2, 404, jid) from None
            error.jid = error.jid or jid                     # --json names the clip, as wait and fetch do
            raise
        output.result(status_line(rec), rec)
        return 0
    jobs = overview(studio)
    text = "\n".join(status_line(j) for j in jobs) if jobs else "no clips yet"
    output.result(text, {"jobs": jobs})
    return 0


def cmd_cancel(studio, args, output):
    jid = check_id(args.id)
    sb = studio.switchboard()
    if asleep(sb):
        raise Fail(f"{asleep_text(sb)}, so no clip is queued or running there", 3, jid=jid)
    answer = studio.json("POST", "/api/cancel", {"id": jid}, timeout=SIDE_S)
    job = answer.get("job") or {}
    if job.get("status") == "cancelled":
        text = f"cancelled {jid}"
    elif is_upscale(job):
        text = f"cancelling upscale {jid}: its job stops within about 20 s"
    else:
        text = f"cancelling {jid}: it stops once the pipeline has closed (about 40 s)"
    output.result(text, answer)
    return 0


def cmd_guide(studio, args, output):
    if output.json:
        output.result("", {"guide": GUIDE})
    else:
        sys.stdout.buffer.write(GUIDE.encode("utf-8"))
        sys.stdout.flush()
    return 0


# ---- the MCP server ----------------------------------------------------------------------------------------------
MODERN = ("2026-07-28",)
